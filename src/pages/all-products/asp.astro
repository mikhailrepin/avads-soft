---
import Layout from "@/layouts/Layout.astro";
import MainHero from "@/components/section/MainHero.astro";
import CallToAction from "@/components/section/CallToAction.astro";
import Advantage from "@/components/card/Advantage.astro";
import ButtonGeneric from "@/components/inputs/ButtonGeneric.astro";

/* Images */
import { Image } from "astro:assets";

/* Data */
import prodHard from "@/data/prodHard.json";
import prodSoft from "@/data/prodSoft.json";

/* Variables */
const heroBbackground = "/hero/pic_21.webp";

type Product = {
  id: string;
  device: {
    name: string;
    description: string;
    image: string;
    status: string;
  };
  buttons?: {
    buy?: { label: string; link: string };
    demo?: { label: string; link: string };
    more?: { label: string; link: string };
    price?: { label: string; link: string };
  };
  prices?: any;
  supports?: any;
};

const asp = prodHard.products.find(
  (product) => product.id === "ASP"
) as Product;

if (!asp) throw new Error("Product not found");

const tsdb = prodSoft.products.find((product) => product.id === "tsdb");

if (!tsdb) throw new Error("Product not found");

// Добавляем ссылку на скачивание
const downloadLink = asp.buttons?.buy?.link || "/downloads";
---

<Layout
  pageTitle={asp.device.name}
  downloadLink={downloadLink}
  buttonLabel={asp.buttons?.buy?.label || "Купить"}>
  <!-- Hero Section -->
  <MainHero backgroundUrl={heroBbackground}>
    <div
      class="flex lg:flex-row flex-col justify-between items-center gap-8 mx-auto w-full lg:min-h-[60vh] main-max-width">
      <div class="w-full lg:w-1/2">
        <h1 class="mb-6 hero-title">
          ПАНЕЛИ<br />
          ОПЕРАТОРА<br />
          <span class="text-primary-300">{asp.device.name}</span>
        </h1>
        <p class="mb-8 hero-description">
          Предназначены для визуализации и управления технологическими
          процессами в составе систем автоматизации.
        </p>
        <div class="flex flex-wrap gap-4">
          <ButtonGeneric
            Variant="primary"
            Size="default"
            Style="filled"
            CustomClass="w-fit lg:min-w-[180px]"
            Visible={!!asp.buttons?.buy}
            IconLeft={{
              IconSprite: "cart-fill",
              IconVisible: true,
            }}
            Target="link"
            ButtonLink={asp.buttons?.buy?.link || "#"}
            ButtonLabel={asp.buttons?.buy?.label || "Купить"}
            Blank={true}
          />
          <ButtonGeneric
            Variant="primary"
            Size="default"
            Style="outlined"
            CustomClass="w-fit lg:min-w-[180px]"
            Visible={!!asp.buttons?.price}
            IconLeft={{
              IconSprite: "",
              IconVisible: false,
            }}
            Target="link"
            ButtonLink={asp.buttons?.price?.link || "#"}
            ButtonLabel="Цены"
          />
        </div>
      </div>
      <div class="flex justify-center w-full lg:w-1/2">
        <div class="relative">
          <img
            src={asp.device.image}
            alt={asp.device.name}
            class="w-full max-w-[500px] h-auto object-contain"
          />
        </div>
      </div>
    </div>
  </MainHero>

  <!-- Отличительные особенности -->
  <div class="flex flex-col mx-auto pt-14 pb-16 main-max-width">
    <h2 class="text-3xl">Отличительные особенности</h2>
    <p class="lg:max-w-[60vw] text-zinc-400 text-lg">
      Панели оператора {asp.device.name} для интерактивного отображения
      технологической информации, управления исполнительными устройствами,
      режимами сбора и архивирования технологических параметров.
    </p>
    <!-- Bento grid -->
    <div class="gap-6 grid grid-cols-1 lg:grid-cols-10 pt-10 lg:pt-[80px]">
      <!-- Performance -->
      <div class="lg:col-span-7 bg-zinc-900 bento-card">
        <h3 class="bento-card-header">Высокая производительность</h3>
        <p class="text-zinc-400 bento-card-description">
          6-ядерный процессор, 4ГБ оперативной памяти, 32 ГБ флеш памяти,
          быстрый графический адаптер до 4K@60Hz, сенсорный multi-touch экран,
          обилие интерфейсов, а так же открытость для различного прикладного ПО
          делают АВАДС АСП мощным инструментом для решения широкого класса
          задач.
        </p>
        <div class="flex gap-4 py-3">
          <img
            src="/products/asp/asp-core.png"
            alt="asp-core"
            class="-ml-6 max-w-[50%]"
          />
          <div class="gap-2 grid grid-cols-2 w-full max-w-[50%]">
            <!-- Core -->
            <div
              class="flex flex-col justify-center items-center col-span-2 bg-zinc-800 p-2 rounded-md w-full">
              <span class="font-bold text-primary-300 text-3xl">6 ядер</span>
              <span class="text-zinc-400 text-base">
                2 Cortex A72<br />4 Cortex A53
              </span>
            </div>
            <!-- Ghz A72 -->
            <div
              class="flex flex-col justify-center items-center bg-zinc-800 p-2 rounded-md w-full">
              <span class="font-bold text-primary-300 text-3xl">2 ггц</span>
              <span class="text-zinc-400 text-base">Cortex A72</span>
            </div>
            <!-- Ghz A53 -->
            <div
              class="flex flex-col justify-center items-center bg-zinc-800 p-2 rounded-md w-full">
              <span class="font-bold text-primary-300 text-3xl">1.5 ггц</span>
              <span class="text-zinc-400 text-base">Cortex A53</span>
            </div>
          </div>
        </div>
      </div>
      <!-- Russian development -->
      <div class="items-center lg:col-span-3 bg-zinc-900 bento-card">
        <h3 class="bento-card-header">🇷🇺 Отечественная разработка</h3>
        <p class="text-zinc-400 bento-card-description">
          Разработку вела российская компания, имеющая ИТ-статус. В&nbsp;России
          разработаны и&nbsp;производятся не&nbsp;только сами панели {
            asp.device.name
          }, но&nbsp;также программное обеспечение, которым они комплектуются:
          операционная система Astra Linux*, SCADA-система MasterSCADA 4D, СУБД
          временных рядов (TSDB) <a
            href={tsdb.buttons?.more?.link}
            class="text-primary-300 hover:text-primary-400 underline"
            >АВАДС&nbsp;{tsdb.app.name}</a
          >.
        </p>
        <img
          src="/products/tsdb/tsdb.svg"
          alt="tsdb"
          class="my-4 w-full max-w-[40%] h-auto object-contain"
        />
        <span class="text-zinc-500 text-sm">
          * получен сертификат READY FOR ASTRA, коммерческая версия вышла в июне
          2025
        </span>
      </div>
    </div>
  </div>

  <!-- Полноценная SCADA -->

  <!-- Модификации АСП -->

  <!-- Характеристики -->

  <!-- Свяжитесь с нами -->
  <CallToAction
    AlignItems="left"
    BackgroundImage={"/hero/cta-call-manager.png"}
    Hovered={false}
    Title="Свяжитесь с нами"
    Description="Оставьте заявку на обратную связь, чтобы наши менеджеры проконсультировали вас по любым вопросам касаемо продукции"
    ButtonProps={{
      ButtonLabel: "Оставить заявку",
      ButtonLink: "/contacts",
    }}
    CustomClass="bg-[#101010] rounded-none border-none"
  />
</Layout>

<style>
  .hero-title {
    @apply font-bold text-4xl lg:text-6xl leading-tight;
  }

  .hero-description {
    @apply text-zinc-400 text-lg lg:text-xl leading-relaxed;
  }

  .bento-card {
    @apply flex flex-col gap-4 p-6 border border-zinc-800 rounded-md overflow-hidden transition-all duration-300;

    .bento-card-header {
      @apply font-bold text-2xl;
    }

    .bento-card-description {
      @apply text-base;
    }
  }
</style>
