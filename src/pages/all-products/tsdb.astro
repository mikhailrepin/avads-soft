<script>
  import lottie from "lottie-web";
  import dotsAnimation from "@/assets/media/dots-anim.json";

  document.addEventListener("DOMContentLoaded", () => {
    // Находим все контейнеры для анимации
    const containers = document.querySelectorAll("[id^='dots-animation-']");

    // Создаем анимацию для каждого контейнера
    containers.forEach((container) => {
      lottie.loadAnimation({
        container: container,
        renderer: "svg",
        loop: true,
        autoplay: true,
        animationData: dotsAnimation,
      });
    });
  });
</script>

