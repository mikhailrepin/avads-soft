---
import Layout from "@/layouts/Layout.astro";
import MainHero from "@/components/section/MainHero.astro";
import CallToAction from "@/components/section/CallToAction.astro";
import Platforms from "@/components/section/Platforms.astro";
import Advantage from "@/components/card/Advantage.astro";
import ButtonGeneric from "@/components/inputs/ButtonGeneric.astro";
import PerformanceTSDB from "@/components/section/PerformanceTSDB.astro";

/* Images */
import { Image } from "astro:assets";
import Datatype from "@/assets/products/tsdb/datatype.png";
import BackupRestore from "@/assets/products/tsdb/backup-restore.png";
import Looping from "@/assets/products/tsdb/looping.png";
import MultiCore from "@/assets/products/tsdb/multi-core.png";
import Reserve from "@/assets/products/tsdb/reserve.png";
import Server from "@/assets/products/tsdb/server.png";
import Trend from "@/assets/products/tsdb/trend.png";
import UsersRole from "@/assets/products/tsdb/users-role.png";
import TSDBBox from "@/assets/products/tsdb/install-box.png";

/* Data */
import prodSoft from "@/data/prodSoft.json";
import PlatformsData from "@/assets/products/tsdb/platforms.json";

/* Animations */
//import dotAnim from "@/assets/media/dots-anim.json";

/* Variables */
const heroBbackground = "/hero/pic_20.webp";

const tsdb = prodSoft.products.find((product) => product.id === "tsdb");

if (!tsdb) throw new Error("Product not found");

// Добавляем ссылку на скачивание
const downloadLink = tsdb.buttons?.demo?.link || "/download";

const advantages = [
  {
    title: "Высочайшая производительность",
    description:
      "На&nbsp;обычном компьютере скорость сохранения до&nbsp;2&nbsp;млн. записей в&nbsp;секунду и&nbsp;скорость выборки до&nbsp;3&nbsp;млн. записей в&nbsp;секунду (параллельно с&nbsp;записью).",
    icon: "database-thunderbolt-outline",
  },
  {
    title: "Инновационность",
    description: `${tsdb.app.name} построен на&nbsp;базе уникальной инновационной технологии SSDS и&nbsp;не&nbsp;имеет аналогов по&nbsp;производительности для&nbsp;своих задач.`,
    icon: "rocket-outline",
  },
  {
    title: "Широчайшая кросс-платформенность",
    description:
      "Работает в&nbsp;операционных системах Windows, Linux, Android, IOS, Darwin, Эльбрус, NetBSD, FreeBSD, OpenBSD, Plan9, AIX, Dragonfly, Illumos, Solaris на&nbsp;различных аппаратных платформах.",
    icon: "branch-down-outline",
  },
  {
    title: "Высочайшая надежность",
    description: `${tsdb.app.name} позволяет создавать высоконадежные системы хранения данных благодаря встроенным механизмам резервирования серверов и&nbsp;носителей.`,
    icon: "database-protection-outline",
  },
  {
    title: "Мощная система бэкапов",
    description:
      "Можно сохранить в&nbsp;файл бэкапа историю изменения произвольного набора тегов за&nbsp;заданный интервал времени и&nbsp;восстановить эти&nbsp;данные в&nbsp;любую базу на&nbsp;том&nbsp;же&nbsp;или&nbsp;другом компьютере.",
    icon: "database-backup-outline",
  },
  {
    title: "Автоматическое зацикливание",
    description:
      "База может зацикливаться либо&nbsp;по&nbsp;времени хранения данных, либо&nbsp;по&nbsp;доступному дисковому пространству. При&nbsp;исчерпании свободного места на&nbsp;диске производится автоматическое зацикливание по&nbsp;второму типу. Для&nbsp;каждого тега можно задать индивидуальную глубину хранения.",
    icon: "loop-outline",
  },
];
---

<Layout
  pageTitle={tsdb.app.name}
  downloadLink={downloadLink}>
  <MainHero backgroundUrl={heroBbackground}>
    <div
      class="flex lg:flex-row flex-col justify-between items-center gap-4 mx-auto w-[100%] lg:min-h-[50dvh] main-max-width">
      <div class="w-full min-w-[50%]">
        <h1
          class="hero-title"
          set:html={tsdb.app.name}
        />
        <h3
          class="hero-description"
          set:html={tsdb.app.description}
        />
        <div class="flex gap-3 mt-[32px]">
          <ButtonGeneric
            Variant="primary"
            Size="default"
            Style="filled"
            CustomClass="w-fit lg:min-w-[150px]"
            Visible={true}
            IconLeft={{
              IconSprite: "download-bold",
              IconVisible: false,
            }}
            Target="link"
            ButtonLink={tsdb.buttons?.buy?.link || "#"}
            ButtonLabel="Купить"
            Blank={true}
          />
          <ButtonGeneric
            Variant="primary"
            Size="default"
            Style="outlined"
            CustomClass="w-fit"
            Visible={true}
            IconLeft={{
              IconSprite: "download-bold",
              IconVisible: true,
            }}
            Target="link"
            ButtonLink={tsdb.buttons?.demo?.link || "#"}
            ButtonLabel="Скачать демо"
          />
          <ButtonGeneric
            Variant="primary"
            Size="default"
            Style="outlined"
            CustomClass={`w-fit lg:min-w-[150px] ${!tsdb.prices ? "hidden" : ""}`}
            Visible={true}
            IconLeft={{
              IconSprite: "",
              IconVisible: false,
            }}
            Target="link"
            ButtonLink={tsdb.buttons?.price?.link || "#"}
            ButtonLabel="Цены"
          />
        </div>
      </div>
      <div class="flex justify-center items-center w-[100%] h-[100%]">
        <img
          src={tsdb.app.image}
          alt={tsdb.app.name}
          class="hidden lg:block scale-[7]"
        />
      </div>
    </div>
  </MainHero>

  <!-- Функции -->
  <div class="flex flex-col mx-auto pt-14 pb-16 main-max-width">
    <h2 class="text-3xl">Функция архивирования</h2>
    <p class="lg:max-w-[60vw] text-zinc-400 text-lg">
      Является одной из&nbsp;главных функций в&nbsp;системах управления
      и&nbsp;учёта, к которой предъявляются очень жёсткие требования:
      по&nbsp;надёжности хранения данных, скорости сохранения и&nbsp;доступа
      к&nbsp;данным, глубине хранения данных.
    </p>
    <p class="mt-[16px] lg:max-w-[60vw] text-zinc-400 text-lg">
      {tsdb.app.name} позволяет вести архивы технологических и&nbsp;коммерческих
      показателей в&nbsp;АСУТП, диспетчеризации объектов промышленности и&nbsp;ЖКХ,
      системах коммерческого и&nbsp;технического учёта.
    </p>
    <h2 class="pt-[40px] pb-[24px] text-3xl">Преимущества</h2>

    <div class="gap-[16px] grid grid-cols-1 lg:grid-cols-3">
      {advantages.map((advantage) => <Advantage {...advantage} />)}
    </div>
  </div>

  <!-- Инновационность -->
  <div class="flex flex-col gap-[16px] bg-zinc-900 pt-10 pb-16">
    <h2 class="mx-auto w-full text-3xl main-max-width">Инновационность</h2>
    <div class="gap-6 grid grid-cols-1 lg:grid-cols-2 mx-auto main-max-width">
      <div class="flex flex-col gap-[16px]">
        <p>
          Сервер Архивирования зарегистрирован в реестре российского
          программного обеспечения Минкомсвязи России под номером № 17156 и
          отнесён к классу 02.07 (средства управления базами данных).
        </p>
        <p>
          Разработан на базе инновационной технологии SSDS (Solid Segment Data
          Storage). Эта технология обеспечивает высочайшую скорость записи и
          извлечения данных.
        </p>
        <ul class="text-primary-300 list-disc list-inside">
          <li>оригинальная организация данных</li>
          <li>уникальная и очень компактная система индексации</li>
          <li>мощная система кеширования</li>
        </ul>
      </div>
      <div class="flex flex-col gap-[16px]">
        <p>
          Эти решения позволяют не только получать мгновенный доступ к нужным
          данным, но и быстро восстановить целостность базы при частичном
          повреждении носителя или индекса. Технология SSDS является продуктом
          разработки компании АВАДС СОФТ и полностью принадлежит ей (<span
            class="text-gold">Патент РФ № 2793082</span
          > «Способ хранения и извлечения данных»).
        </p>
      </div>
    </div>
  </div>

  <!-- Платформы -->
  <Platforms
    data={PlatformsData.data}
    appIcon={tsdb.app.image}>
    <div class="flex flex-col gap-[16px]">
      <p>
        {tsdb.app.name} — кроссплатформенный продукт. Его код не содержит решений,
        зависящих от ОС и аппаратной платформы.
      </p>
      <p>
        Работает на большинстве современных платформ и под управлением почти
        всех операционных систем.
      </p>
      <p>
        Для облегчения интеграции с другими программными продуктами имеются
        примеры исходного кода драйверов. Примеры приведены для следующих языков
        программирования: C#, Go, JavaScript, Python. <a
          class="text-primary-300 hover:text-primary-400 underline"
          href={tsdb.buttons?.demo?.link || "#"}
          >Скачать</a
        > примеры исходных текстов драйверов.
      </p>
    </div>
  </Platforms>

  <!-- Архитектура -->
  <div class="w-full overflow-hidden">
    <div
      class="relative flex flex-col mx-auto pt-[52px] pb-[60px] main-max-width">
      <h2 class="mx-auto w-full text-3xl">Архитектура</h2>

      <!-- Блоки -->
      <div
        class="relative gap-[24px] lg:gap-[48px] lg:gap-y-[60px] grid grid-cols-1 lg:grid-cols-2">
        <p>
          {tsdb.app.name} — включает в себя Сервер БД (сервер баз данных) и Клиент
          администрирования.
          <br /><br />
          Не имеет ограничений по числу баз и клиентов кроме лицензионных, а также
          накладываемых возможностями вычислительных средств, на которых он установлен.
        </p>

        <!-- Правый -->
        <div class="left pulsar-card">
          <span class="text-gold title">Сервер БД</span>
          <span class="description">
            Обслуживает запросы клиентов, сохраняет полученные данные и
            предоставляет их по запросу, выполняет бекапирование и
            математическую обработку.
          </span>
          <div class="card-bg"></div>
          <div
            id="dots-animation-1"
            class="right animated-lines">
          </div>
        </div>

        <!-- Левый -->
        <div class="right lg:translate-x-[40%] pulsar-card">
          <span class="text-gold title">Клиент администрирования</span>
          <span class="description">
            Обслуживает запросы клиентов, сохраняет полученные данные и
            предоставляет их по запросу, выполняет бекапирование и
            математическую обработку.
          </span>
          <div class="card-bg"></div>
          <div
            id="dots-animation-2"
            class="left animated-lines">
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Типы хранимых данных -->
  <div class="flex flex-col mx-auto mt-[24px] main-max-width">
    <hr class="separator silver" />

    <!-- Типы хранимых данных -->
    <h2 class="pt-[16px] text-3xl">Типы хранимых данных</h2>

    <!-- Атомарные данные -->
    <div class="gap-[32px] grid grid-cols-1 lg:grid-cols-2 py-8">
      <div class="flex flex-col gap-[16px]">
        <h4 class="font-medium text-primary-300 text-2xl">Атомарные данные</h4>
        <hr class="gold separator" />
        <p class="text-zinc-400">
          Данные любых типов, размер которых не превышает 8 байт. К таким
          относятся, например: bool, int, long, dlong, float, dfloat...
        </p>
        <br />
        <h4 class="font-medium text-primary-300 text-2xl">Данные типа blob</h4>
        <hr class="gold separator" />
        <p class="text-zinc-400">
          Данные произвольного размера. Это могут быть, например, структуры,
          массивы, тексты, изображения и пр. Назначение и структуру записанного
          в blob массива байтов определяет приложение, которое его записывает.
          <br /><br />
          Механизмы хранения и доступа к данным обоих типов одинаковые. Отличие состоит
          в логике их обработки. Такой унифицированный подход позволяет обеспечить
          одинаково высокую скорость сохранения и доступа к данным независимо от
          их типа.
        </p>
      </div>
      <Image
        src={Datatype}
        alt="Типы хранимых данных"
        class="w-[90%] object-cover"
      />
    </div>
  </div>

  <!-- Взаимодействие с внешними приложениями -->
  <div class="flex flex-col mx-auto mt-[24px] main-max-width">
    <hr class="separator silver" />

    <h2 class="pt-[16px] text-3xl">Взаимодействие с внешними приложениями</h2>

    <div class="gap-[32px] grid grid-cols-1 lg:grid-cols-2 py-8">
      <div class="flex flex-col gap-[16px]">
        <h4 class="font-medium text-primary-300 text-2xl">API</h4>
        <hr class="gold separator" />
        <p class="text-zinc-400">
          Обеспечивает высокоскоростные методы передачи и доступа к данным, а
          также методы управления сервером, реализованные в рамках TCP/IP стека.
        </p>
        <br />

        <h4 class="font-medium text-primary-300 text-2xl">OPC UA</h4>
        <hr class="gold separator" />
        <p class="text-zinc-400">
          Для взаимодействия Сервера архивирования с клиентами по протоколу OPC
          UA разработана специальная программа – OPC–DB шлюз. Она
          взаимодействует по протоколу OPC UA с клиентами и транслирует запросы
          этого протокола в протокол AVADS TCP.
        </p>
        <br />

        <h4 class="font-medium text-primary-300 text-2xl">WEB SOCKET</h4>
        <hr class="gold separator" />
        <p class="text-zinc-400">
          Это WEB-API, реализованное через WEB-soсket. Используется для
          взаимодействия сервера с Клиентом администрирования. JSON проще в
          реализации, но медленнее в работе. Поэтому его не следует использовать
          если требуется максимальное быстродействие.
          <br /><br />
          <span class="text-zinc-100"
            >{tsdb.app.name} может взаимодействовать с клиентами как в рамках одного
            компьютера так и по сети используя одновременно оба механизма. Число
            клиентов, которые могут одновременно взаимодействовать с Сервером Архивирования
            ограничивается лицензией.</span
          >
        </p>
      </div>
      <Image
        src={Server}
        alt="Взаимодействие с внешними приложениями"
        class="w-[90%] object-cover"
      />
    </div>
  </div>

  <!-- Зацикливание баз данных -->
  <div class="flex flex-col mx-auto mt-[24px] main-max-width">
    <hr class="separator silver" />

    <h2 class="pt-[16px] text-3xl">Зацикливание</h2>

    <div class="gap-[32px] grid grid-cols-1 lg:grid-cols-2 mt-[-24px] py-8">
      <div class="flex flex-col gap-[16px] text-zinc-400">
        <p>
          Сервер Архивирования обеспечивает непрерывное сохранение данных, даже
          при исчерпании свободного пространства на диске. Это достигается за
          счёт функции зацикливания.
        </p>
        <p>Зацикливание баз данных может выполняться в нескольких режимах:</p>
        <ul class="text-primary-300 list-disc list-inside">
          <li>По заданной глубине хранения данных</li>
          <li>По заданному размеру базы</li>
          <li>По исчерпанию свободного места на диске</li>
        </ul>
        <p>
          Глубина хранения может устанавливаться для базы целиком, для группы
          тегов или индивидуально для каждого тега. Приоритетной будет
          индивидуальная настройка тега.
        </p>
        <p>
          При достижении заданного ограничения все новые записи будут
          записываться поверх самых старых.
        </p>
        <p>
          Зацикливание архива слабо влияет на скорость Сервера архивирования по
          записи и выборке данных.
        </p>
      </div>
      <Image
        src={Looping}
        alt="Зацикливание баз данных"
        class="w-[90%] object-cover"
      />
    </div>
  </div>

  <!-- Создание и восстановление бэкапов -->
  <div class="flex flex-col mx-auto mt-[24px] main-max-width">
    <hr class="separator silver" />

    <h2 class="pt-[16px] text-3xl">Создание и восстановление бэкапов</h2>

    <div class="gap-[32px] grid grid-cols-1 lg:grid-cols-2 mt-[-24px] py-8">
      <div class="flex flex-col gap-[16px] text-zinc-400">
        <p>
          {tsdb.app.name} позволяет сохранять в файл бэкапа значения произвольного
          набора параметров за заданный интервал времени. Затем данные из бэкапа
          можно восстановить в ту же или другую базу данных.
        </p>
        <p>
          Можно, например, все теги сохранять в бэкап раз в заданный период
          времени на сменный носитель. Это обеспечит защиту от потери данных.
        </p>
        <p>
          Возможность сохранить бэкап позволяет вести аналитику на отдельном
          компьютере не нагружая дополнительными запросами сервер,
          обеспечивающий сохранение данных.
        </p>
        <p>
          {tsdb.app.name} может восстанавливать бэкап одновременно с записью новых
          данных в базу. Причем процесс восстановления почти не влияет на производительность
          сервера.
        </p>
      </div>
      <Image
        src={BackupRestore}
        alt="Создание и восстановление бэкапов"
        class="w-[90%] object-cover"
      />
    </div>
  </div>

  <!-- Встроенная математическая обработка и резервирование-->
  <div class="bg-zinc-100 w-full text-zinc-900">
    <div class="flex flex-col mx-auto py-[32px] main-max-width">
      <h2 class="pt-[16px] text-3xl">Встроенная математическая обработка</h2>

      <div class="gap-[32px] grid grid-cols-1 lg:grid-cols-2 mt-[-24px] py-8">
        <div class="flex flex-col gap-[16px] text-zinc-600">
          <p>
            {tsdb.app.name} может выполнять математическую обработку сохраненных
            данных. Для этого в API предусмотрены специальные команды.
          </p>
          <p class="font-semibold">
            Запросы на обработку позволяют выполнять следующие действия:
          </p>
          <h3 class="mt-2 font-semibold text-zinc-900 uppercase">
            Прореживание
          </h3>
          <p>
            Используется, например, для вывода на тренд данных за большой
            интервал времени – точек много больше чем пикселей в рабочем поле
            тренда. Прореживание сокращает объем передаваемых данных и повышает
            скорость отрисовки их на тренде.
          </p>
          <h3 class="mt-2 font-semibold text-zinc-900 uppercase">
            Вычисление за заданный интервал
          </h3>
          <ul class="text-primary-300 list-disc list-inside">
            <li>Минимум / Максимум</li>
            <li>Среднее значение</li>
            <li>Интеграл</li>
            <li>Наработка / простой в часах и процентах</li>
          </ul>
        </div>
        <Image
          src={Trend}
          alt="Встроенная математическая обработка"
          class="w-[90%] object-cover"
        />
      </div>

      <h2 class="pt-[16px] text-3xl">Резервирование</h2>

      <div class="gap-[32px] grid grid-cols-1 lg:grid-cols-2 mt-[-24px] py-8">
        <div class="flex flex-col gap-[16px] text-zinc-600">
          <p>
            {tsdb.app.name} позволяет создавать высоконадежные резервированные системы
            непрерывного хранения данных. Это важно для ответственных систем и коммерческого
            учета.
          </p>
          <p class="font-semibold">
            {tsdb.app.name} реализует горячее резервирование:
          </p>
          <h3 class="mt-2 font-semibold text-zinc-900 uppercase">Серверов</h3>
          <p>
