---
import Layout from "@/layouts/Layout.astro";
import MainHero from "@/components/section/MainHero.astro";
import CallToAction from "@/components/section/CallToAction.astro";
import Advantage from "@/components/card/Advantage.astro";
import ButtonGeneric from "@/components/inputs/ButtonGeneric.astro";
import FAQ from "@/components/section/FAQ.astro";

/* Images */
import { Image } from "astro:assets";
import sarInfrastructure from "@/assets/products/sar-expert/sar-infra.png";
import sarDesktop from "@/assets/products/sar-expert/sar-desktop.png";
import trendAcceleration from "@/assets/products/sar-expert/trend-acceleration-curve.png";
import trendImpulseTask from "@/assets/products/sar-expert/trend-impulse-task.png";
import trendImpulseValve from "@/assets/products/sar-expert/trend-impulse-valve.png";
import trendStepwise from "@/assets/products/sar-expert/trend-stepwise-change.png";
import trendBeforeAfterDesktop from "@/assets/products/sar-expert/trends-before-after-desktop.png";
import trendBeforeAfterMobile from "@/assets/products/sar-expert/trends-before-after-mobile.png";
import trendAfterSarInstall from "@/assets/products/sar-expert/trends-after-sar-install.png";

/* Data */
import prodSoft from "@/data/prodSoft.json";
import faqData from "@/data/faqMain.json";

/* Variables */
const heroBbackground = "/hero/sar-expert.avif";

const sarExpert = prodSoft.products.find(
  (product) => product.id === "sar-expert"
);

if (!sarExpert) throw new Error("Product not found");

// Добавляем ссылку на скачивание
const downloadLink = sarExpert.buttons?.demo?.link || "/download";

const advantages = [
  {
    title: "Повышение стабильности процессов",
    description:
      "Автоматическая настройка ПИД-регуляторов обеспечивает стабильную работу технологических процессов и минимизирует отклонения от заданных параметров.",
    icon: "trend-switch-to-new",
  },
  {
    title: "Улучшение качества продукции",
    description:
      "Точное поддержание технологических параметров позволяет получать продукцию стабильно высокого качества и снижает процент брака.",
    icon: "scales-up-outline",
  },
  {
    title: "Снижение риска нештатных ситуаций",
    description:
      "Своевременная корректировка параметров регулирования предотвращает аварийные ситуации и защищает оборудование от критических режимов работы.",
    icon: "time-activity-outline",
  },
  {
    title: "Увеличение производительности",
    description:
      "Оптимальные настройки регуляторов повышают кпд технологического оборудования.",
    icon: "trend-static",
  },
  {
    title: "Сокращение энергозатрат",
    description:
      "Эффективное управление параметрами снижает затраты энергии на регулирование и уменьшает износ оборудования.",
    icon: "bolt-down-outline",
  },
  {
    title: "Контроль расхода ресурсов",
    description:
      "Оптимизация работы регуляторов помогает экономить сырье и энергоресурсы за счет снижения перерегулирования и колебательности.",
    icon: "charts-square-outline",
  },
];
---

<Layout
  pageTitle={sarExpert.app.name}
  downloadLink={downloadLink}>
  <MainHero backgroundUrl={heroBbackground}>
    <div
      class="flex lg:flex-row flex-col justify-between items-center gap-4 mx-auto w-[100%] lg:min-h-[50dvh] main-max-width">
      <div class="w-full min-w-[50%]">
        <h1 class="hero-title">
          <span class="text-silver">{sarExpert.app.name}</span><br />
        </h1>
        <h3 class="hero-description">
          <span
            set:html={sarExpert.app.description.replace(
              "контроль",
              "контроль<br />"
            )}
          />
        </h3>
        <ButtonGeneric
          Variant="primary"
          Size="default"
          Style="filled"
          CustomClass="mt-[32px] lg:w-fit"
          Visible={true}
          IconLeft={{
            IconSprite: "download-bold",
            IconVisible: true,
          }}
          Target="link"
          ButtonLink={sarExpert.buttons?.demo?.link || "#"}
          ButtonLabel="Скачать демо"
        />
      </div>
      <div class="flex justify-center items-center w-[100%] h-[100%]">
        <img
          src={sarExpert.app.image}
          alt={sarExpert.app.name}
          class="lg:block hidden scale-[7]"
        />
      </div>
    </div>
  </MainHero>
  <h2 class="mx-auto mt-[52px] text-3xl main-max-width">
    Преимущества эффективной работы САР
  </h2>
  <!-- Преимущества -->
  <div
    class="gap-[16px] grid grid-cols-1 lg:grid-cols-3 mx-auto my-[52px] main-max-width">
    {advantages.map((advantage) => <Advantage {...advantage} />)}
  </div>

  <h2 class="mx-auto mt-[80px] mb-[40px] text-3xl main-max-width">
    Технологии {sarExpert.app.name}
  </h2>
  <!-- Инфраструктура -->
  <div class="relative flex flex-col gap-[16px] mx-auto main-max-width">
    <div class="animated-circles">
      <div class="circle">1</div>
      <div class="circle">2</div>
      <div class="circle">3</div>
      <div class="circle">4</div>
      <div class="circle">5</div>
    </div>

    <div class="lg:max-w-[500px] text-card">
      <p class="title">Инфраструктура</p>
      <p class="description">
        Для получения переменных процесса, АВАДС САР-Эксперт подключается к
        действующей<br /> системе управления по OPC (UA)
      </p>
    </div>

    <Image
      src={sarInfrastructure}
      alt="Инфраструктура"
      class="relative z-[2] mx-auto lg:mt-[-160px] lg:mb-[-110px] w-[100%] lg:w-[90%]"
    />

    <div class="lg:max-w-[380px] text-card">
      <p class="description">
        САР-Эксперт устанавливается как на действующей инженерной<br /> станции АСУ
        ТП, так и на специально выделенном ПК
      </p>
    </div>
  </div>

  <div
    class="gap-[16px] grid grid-cols-1 lg:grid-cols-2 mx-auto pb-[24px] main-max-width">
    <div class="text-card">
      <p class="title">Расчёты</p>
      <p class="description">
        Для рассчёта настроек нужен лишь один переходный процесс, являющийся
        реакцией на возмущение (проявляющее отклик системы)
      </p>
    </div>
    <div class="text-card">
      <p class="title">Математический аппарат</p>
      <p class="description">
        Уникальная технология идентификации объекта в замкнутом контуре, в
        основе которой использованы наработки советских и российских учёных
      </p>
    </div>
    <Image
      src={sarDesktop}
      alt="Инфраструктура"
      class="lg:block hidden my-[12px] w-[80%] object-contain"
    />
    <div class="text-card">
      <p class="title">Собственные архивы технологических переменных</p>
      <p class="description">
        Встроенная система архивирования на базе <a
          class="text-primary-300 hover:text-primary-400 underline"
          href={prodSoft.products.find((product) => product.id === "tsdb")
            ?.buttons?.more?.link || "#"}
          >{
            prodSoft.products.find((product) => product.id === "tsdb")?.app
              ?.name
          }</a
        >
      </p>
      <p class="mt-[52px] title">Кроссплатформенное решение</p>
      <p class="description">
        Поддерживается большинством Операционных систем в том числе
        и отечественными
      </p>
    </div>
  </div>

  <div class="bg-gradient-to-b from-zinc-950 to-zinc-900/50 py-[48px] w-full">
    <!-- Сетка с трендами -->
    <div
      class="gap-[32px] grid grid-cols-1 lg:grid-cols-2 mx-auto main-max-width">
      <!-- Кривая разгона -->
      <div class="bordered text-card">
        <Image
          src={trendAcceleration}
          alt="Кривая разгона"
          class="mx-auto w-[70%]"
        />
        <p class="mt-[8px] text-center text-xl">Кривая разгона</p>
      </div>

      <!-- Импульсное изменение задания -->
      <div class="bordered text-card">
        <Image
          src={trendImpulseTask}
          alt="Импульсное изменение задания"
          class="mx-auto w-[70%]"
        />
        <p class="mt-[8px] text-center text-xl">Импульсное изменение задания</p>
      </div>

      <!-- Ступенчатое изменение задания -->
      <div class="bordered text-card">
        <Image
          src={trendStepwise}
          alt="Ступенчатое изменение задания"
          class="mx-auto w-[70%]"
        />
        <p class="mt-[8px] text-center text-xl">
          Ступенчатое изменение задания
        </p>
      </div>

      <!-- Импульсное изменение положения клапана -->
      <div class="bordered text-card">
        <Image
          src={trendImpulseValve}
          alt="Импульсное изменение положения клапана"
          class="mx-auto w-[70%]"
        />
        <p class="mt-[8px] text-center text-xl">
          Импульсное изменение положения клапана
        </p>
      </div>

      <div class="items-center text-card">
        <div class="flex flex-col gap-[8px] lg:pr-[32px]">
          <p class="title">Идентификация объектов регулирования</p>
          <p class="description">
            Идентификация — расчёт параметров модели объекта — производится
            как в разомкнутом, так и в замкнутом контуре. Для этого достаточно
            ступенчатого или импульсного возмущения (специально внесённого
            или естественно, случившегося в ходе эксплуатации)
          </p>
          <p class="mt-[24px] title">Имитационное моделирование</p>
          <p class="description">
            Позволяет оценить поведение контура при различных видах возмущения
            (по нагрузке или заданию), его различной величине, зашумлённости, а
            также ответить на вопрос: «А что, если?..»
          </p>
          <p class="mt-[24px] title">Отчёты</p>
          <p class="description">
            Ослабление или усиление, расчёт фильтра, перерасчёт настроек
            с учётом этого фильтра и другие.
          </p>
        </div>
      </div>

      <div class="items-center text-card">
        <div class="flex flex-col gap-[8px] lg:pl-[32px]">
          <p class="title">Расчёт настроек регуляторов</p>
          <p class="description">
            На основании идентификации по одному или нескольким процессам
          </p>
          <p class="mt-[24px] title">
            Инструменты автоматизированной корректировки настроек
          </p>
          <p class="description">
            Ослабление или усиление, расчёт фильтра, перерасчёт настроек
            с учётом этого фильтра и другие
          </p>
          <p class="mt-[24px] title">Архив результатов расчётов</p>
          <p class="description">
            Позволяет не только вести историю расчётов, но и в любой момент
            вернуться к любому из них, скорректировать исходные условия
            и выполнить новый расчёт. Также подставить результаты предыдущих
            идентификаций в текущий расчёт для оценки работы контура
            при различных режимах эксплуатации
          </p>
        </div>
      </div>
    </div>
  </div>

  <hr class="opacity-20 separator silver" />

  <div class="mx-auto my-[64px] main-max-width">
    <div class="flex flex-col gap-[16px] mx-auto w-[80%]">
      <h2 class="my-0 text-3xl text-primary-300">Статистический анализ</h2>
      <p class="text-lg text-zinc-400">
        Предназначен для оценки качества работы системы автоматического
        регулирования. Сравнительный статистический анализ показывает, каких
        изменений удалось достичь благодаря настройке, сравнить работу контура
        «До» и «После»
      </p>
      <Image
        src={trendBeforeAfterDesktop}
        alt="До и после применения настроек"
        class="lg:block hidden my-8 w-[100%]"
      />
      <Image
        src={trendBeforeAfterMobile}
        alt="До и после применения настроек"
        class="block lg:hidden my-8 w-[100%]"
      />
    </div>
  </div>

  <div class="mx-auto my-[64px] main-max-width">
    <div class="flex flex-col gap-[16px] mx-auto w-[80%]">
      <h2 class="my-0 text-3xl text-primary-300">После внедрения</h2>
      <p class="text-lg text-zinc-400">
        Уменьшение девиации регулируемой переменной позволяет изменить задание
        и вести процесс ближе к границам спецификации — уменьшить так называемый
        запас по качеству. Это обеспечивает снижение затрат и (или) увеличение
        производительности
      </p>
      <Image
        src={trendAfterSarInstall}
        alt="После внедрения"
        class="my-6 w-[100%]"
      />
      <p class="text-lg text-zinc-400">
        За счёт оптимизации работы систем регулирования зачастую удаётся
        получить экономию на энергоресурсах на 0,5–2% или повысить
        производительность на 1–10%. Пример результата оптимизации работы
        САР на Сургутском ЗСК — удалось увеличить выход высоколиквидной фракции
        на 6%. Подробнее в статье <a
          class="text-primary-300 hover:text-primary-400 underline"
          href="https://insat.ru/upload/iblock/1c3/PID-Expert-AA.pdf"
          target="_blank"
          >Control Engineering</a
        >
      </p>
    </div>
  </div>

  <div class="flex flex-col gap-[52px] mx-auto my-[52px] main-max-width">
    <CallToAction
      Title="Свяжитесь с нами"
      Description="Оставьте заявку на обратную связь, чтобы наши менеджеры проконсультировали вас по любым вопросам касаемо продукции"
      ButtonProps={{
        ButtonLabel: "Оставить заявку",
        ButtonLink: "/contacts",
      }}
    />

    <FAQ faqData={faqData} />
  </div>

  <style>
    .text-card {
      @apply relative z-[20] flex flex-col gap-[8px] py-[24px] w-full;
      & .title {
        @apply text-2xl text-primary-300;
      }

      & .description {
        @apply text-lg text-zinc-400;
      }
    }

    .bordered {
      @apply border-zinc-900 lg:border;
    }

    .animated-circles {
      @apply lg:block top-0 left-0 absolute hidden w-[1400px] h-[1400px] pointer-events-none;
      z-index: 0;
      transform: perspective(8000px) rotateX(45deg) translateY(-32rem)
        translateX(-28rem);
    }

    .circle {
      @apply absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full border border-zinc-500 text-zinc-100/0;
      animation: ripple 15s linear infinite;
    }

    .circle:nth-child(2) {
      animation-delay: -3s;
    }

    .circle:nth-child(3) {
      animation-delay: -6s;
    }

    .circle:nth-child(4) {
      animation-delay: -9s;
    }

    .circle:nth-child(5) {
      animation-delay: -12s;
    }

    @keyframes ripple {
      0% {
        width: 1px;
        height: 1px;
        opacity: 1;
      }
      100% {
        width: 100%;
        height: 100%;
        opacity: 0;
      }
    }
  </style>
</Layout>
