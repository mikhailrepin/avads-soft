---
import Layout from "@/layouts/Layout.astro";
import MainHero from "@/components/section/MainHero.astro";
import CallToAction from "@/components/section/CallToAction.astro";
import FAQ from "@/components/section/FAQ.astro";
import ProductGrid from "@/components/section/ProductGrid.astro";
import faqData from "@/data/faqMain.json";

const heroBbackground = "/hero/pic_1.webp";
---

<Layout pageTitle="Все продукты">
  <MainHero backgroundUrl={heroBbackground}>
    <div
      class="flex flex-col justify-center gap-4 mx-auto w-[100%] lg:min-h-[50dvh] main-max-width">
      <h1 class="hero-title">
        <span class="text-silver">Программное обеспечение</span><br />
        <span class="text-gold">АВАДС СОФТ</span><br />
      </h1>
      <h3 class="hero-description">
        Наши продукты составляют надёжную опору <br /> современной автоматизации
      </h3>
    </div>
  </MainHero>

  <div class="flex flex-col gap-[52px] mx-auto my-[52px] main-max-width">
    <ProductGrid Collapsed={false} />

    <CallToAction
      Title="Свяжитесь с нами"
      Description="Оставьте заявку на обратную связь, чтобы наши менеджеры проконсультировали вас по любым вопросам касаемо продукции"
      ButtonProps={{
        ButtonLabel: "Оставить заявку",
        ButtonLink: "/contacts",
      }}
    />

    <FAQ faqData={faqData} />
  </div>
</Layout>
