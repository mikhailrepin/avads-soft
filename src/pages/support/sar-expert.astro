---
import Layout from "@/layouts/Layout.astro";
import FAQ from "@/components/section/FAQ.astro";
import CallToAction from "@/components/section/CallToAction.astro";
import SupportHero from "@/components/section/SupportHero.astro";
/* Data */
import prodSoftData from "@/data/prodSoft.json";
import faqData from "@/data/faqMain.json";

const sarExpert = prodSoftData.products.find(
  (product) => product.id === "sar-expert"
);

if (!sarExpert) throw new Error("Product not found");
---

<Layout pageTitle={sarExpert.app.name}>
  <section class="mb-12 min-h-[50dvh]">
    <SupportHero
      productImage={sarExpert.app.image}
      productName={sarExpert.app.name}
      backgroundImage="/hero/abstract-10.webp"
    />
    <div class="mx-auto py-12 main-max-width">
      <p class="max-w-[700px] text-zinc-300">
        Добро пожаловать в раздел поддержки {sarExpert.app.name}. Здесь вы
        найдете всю необходимую информацию для успешной работы с программой - от
        пошаговых руководств по установке до ответов на часто задаваемые
        вопросы. Выберите интересующий вас раздел ниже:
      </p>
      {
        sarExpert.supports?.windows?.guides && (
          <div class="gap-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 pt-8">
            {Object.entries(sarExpert.supports?.windows?.guides).map(
              ([key, guide]) => (
                <a
                  href={guide.link}
                  class="support-card">
                  <svg
                    class="icon"
                    viewBox="0 0 24 24"
                    style="width: 48px; height: 48px;">
                    <use xlink:href={`/sprites.svg#${guide.icon}`} />
                  </svg>
                  <span class="text-zinc-300">{guide.label}</span>
                </a>
              )
            )}
          </div>
        )
      }
    </div>
    <!-- FAQ -->
    <div class="bg-zinc-950 mx-auto my-[52px] main-max-width">
      <FAQ faqData={faqData} />
    </div>
    <!-- Свяжитесь с нами -->
    <CallToAction
      AlignItems="left"
      BackgroundImage={"/hero/cta-call-manager.png"}
      Hovered={false}
      Title="Свяжитесь с нами"
      Description="Оставьте заявку на обратную связь, чтобы наши менеджеры проконсультировали вас по любым вопросам касаемо продукции"
      ButtonProps={{
        ButtonLabel: "Оставить заявку",
        ButtonLink: "/contacts",
      }}
      CustomClass="bg-[#101010] rounded-none border-none"
    />
  </section>
</Layout>
