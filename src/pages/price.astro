---
/* Price page */

import Layout from "@/layouts/Layout.astro";
import MainHero from "@/components/section/MainHero.astro";
import SoftPriceGrid from "@/components/section/SoftPriceGrid.astro";
import CallToAction from "@/components/section/CallToAction.astro";

/* Images */
const heroBbackground = "/hero/pic_19.webp";
---

<Layout pageTitle="Цены">
  <MainHero backgroundUrl={heroBbackground}>
    <div
      class="flex flex-col justify-center gap-4 mx-auto w-[100%] lg:min-h-[50dvh] main-max-width">
      <h1 class="hero-title">
        <span class="text-silver">Стоимость программного<br />обеспечения</span>
        <span class="text-gold">АВАДС СОФТ</span><br />
      </h1>
      <h3 class="hero-description">
        Мы удерживаем конкурентную стоимость на всю линейку продуктов. <br />
        Комфортно масштабируйтесь без опасения крупных растрат на лишние ресурсы
      </h3>
    </div>
  </MainHero>

  <SoftPriceGrid />

  <div class="flex flex-col gap-[52px] mx-auto mb-14 main-max-width">
    <CallToAction
      Title="Свяжитесь с нами"
      Description="Оставьте заявку на обратную связь, чтобы наши менеджеры проконсультировали вас по любым вопросам касаемо продукции"
      ButtonProps={{
        ButtonLabel: "Оставить заявку",
        ButtonLink: "/contacts",
      }}
    />
  </div>
</Layout>
