---
import Layout from "@/layouts/Layout.astro";
import MainHero from "@/modules/section/MainHero.astro";
import PriceGrid from "@/modules/section/PriceGrid.astro";
const heroBbackground = "/hero/price-page.avif";
---

<Layout pageTitle="Цены">
  <MainHero backgroundUrl={heroBbackground}>
    <div
      class="flex flex-col justify-center gap-4 mx-auto w-[100%] lg:min-h-[50dvh] main-max-width">
      <h1 class="hero-title">
        <span class="text-silver">Стоимость программного<br />обеспечения</span>
        <span class="text-gold">АВАДС СОФТ</span><br />
      </h1>
      <h3 class="hero-description">
        Мы удерживаем конкурентную стоимость на всю линейку продуктов. <br />
        Комфортно масштабируйтесь без опасения крупных растрат на лишние ресурсы
      </h3>
    </div>
  </MainHero>

  <PriceGrid />
</Layout>
