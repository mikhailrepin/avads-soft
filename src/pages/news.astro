---
import Layout from "@/layouts/Layout.astro";
import PostsGrid from "@/modules/section/PostsGrid.astro";

// Получаем номер текущей страницы из URL параметров
const currentPage = Number(Astro.url.searchParams.get("page")) || 1;
const postsPerPage = 6; // Количество постов на странице

// Получаем все посты
const posts = await Astro.glob("./posts/*.md");
const sortedPosts = posts
  .filter((post) => {
    if (!post || !post.frontmatter) return false;
    const date = new Date(post.frontmatter.date);
    return (
      post.frontmatter.title &&
      post.frontmatter.description &&
      post.frontmatter.date &&
      post.frontmatter.image &&
      post.frontmatter.image.startsWith("http") &&
      !isNaN(date.getTime())
    );
  })
  .sort(
    (a, b) =>
      new Date(b.frontmatter.date).getTime() -
      new Date(a.frontmatter.date).getTime()
  );

// Вычисляем общее количество страниц
const totalPages = Math.ceil(sortedPosts.length / postsPerPage);

// Получаем посты для текущей страницы
const pageStart = (currentPage - 1) * postsPerPage;
const pageEnd = pageStart + postsPerPage;
const currentPosts = sortedPosts.slice(pageStart, pageEnd).map((post) => ({
  title: post.frontmatter.title,
  description: post.frontmatter.description,
  date: post.frontmatter.date,
  image: post.frontmatter.image,
  url: `/posts/${post.file.split("/").pop()?.replace(".md", "")}`,
}));
---

<Layout pageTitle="Новости">
  <section class="mx-auto py-8 main-max-width">
    <h1 class="mb-8 font-bold text-4xl">Новости компании</h1>
    <PostsGrid
      posts={currentPosts}
      currentPage={currentPage}
      totalPages={totalPages}
    />
  </section>
</Layout>

