---
import Layout from "@/layouts/Layout.astro";
import PostsGrid from "@/modules/section/PostsGrid.astro";

// Генерируем тестовые посты
function generateTestPosts(count: number) {
  return Array.from({ length: count }, (_, i) => ({
    title: `Тестовый пост ${i + 1}`,
    description: "Это тестовое описание поста для проверки пагинации...",
    date: "01.01.2024",
    image: "https://picsum.photos/800/400",
    url: "#",
  }));
}

// Параметры для тестирования
const totalPosts = 100; // Всего постов
const postsPerPage = 9; // Постов на странице
const currentPage = +(Astro.url.searchParams.get("page") || 1);
const totalPages = Math.ceil(totalPosts / postsPerPage);

// Получаем посты для текущей страницы
const start = (currentPage - 1) * postsPerPage;
const end = start + postsPerPage;
const currentPosts = generateTestPosts(totalPosts).slice(start, end);
---

<Layout pageTitle="Тест пагинации">
  <div class="mx-auto px-4 py-8 container">
    <h1 class="mb-8 font-bold text-3xl">Тест пагинации</h1>

    <PostsGrid
      posts={currentPosts}
      currentPage={currentPage}
      totalPages={totalPages}
      paginationBasePath="/pagination-test"
    />
  </div>
</Layout>
