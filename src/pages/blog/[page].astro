---
import Layout from "@/layouts/Layout.astro";
import BlogContent from "@/components/section/BlogContent.astro";
import { getBlogPosts, getLatestPost } from "@/utils/blog";
import helpers from "@/data/helpers.json";

export async function getStaticPaths() {
  const postsPerPage = 6;
  const latestPost = await getLatestPost();
  const { totalPages, formatPosts } = await getBlogPosts(postsPerPage, latestPost?.url);

  return Array.from({ length: totalPages }, (_, i) => {
    const pageNum = i + 1;
    const pageStart = i * postsPerPage;
    const pageEnd = pageStart + postsPerPage;

    return {
      params: { page: pageNum.toString() },
      props: {
        posts: formatPosts(pageStart, pageEnd),
        currentPage: pageNum,
        totalPages,
        latestPost: pageNum === 1 ? latestPost : null,
      },
    };
  });
}

const { posts, currentPage, totalPages, latestPost } = Astro.props;
---

<Layout pageTitle="Блог">
  <section class="mx-auto py-8 min-h-[100dvh] main-max-width">
    <h2 class="mb-8 text-3xl">
      Все самые актуальные события <span class="text-gold"
        >{helpers.company.name}</span
      >
    </h2>

    <BlogContent
      posts={posts}
      currentPage={currentPage}
      totalPages={totalPages}
      latestPost={latestPost}
      showFeaturedPost={currentPage === 1}
    />
  </section>
</Layout>
