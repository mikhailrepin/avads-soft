---
import Layout from "@/layouts/Layout.astro";
import BlogContent from "@/components/section/BlogContent.astro";
import { getBlogPosts, getLatestPost } from "@/utils/blog";
import helpers from "@/data/helpers.json";

const postsPerPage = 6;

// Получаем свежий пост
const latestPost = await getLatestPost();

// Получаем все посты
// Исключаем свежий пост из сетки, чтобы избежать дублирования
const allPosts = await getBlogPosts(postsPerPage, latestPost?.url);
const posts = allPosts.formatPosts(0, postsPerPage);
---

<Layout pageTitle="Блог">
  <section class="mx-auto py-8 min-h-[100dvh] main-max-width">
    <!-- <h2 class="text-3xl">
      Блог <span class="text-gold">ПИД-Регулирования</span>
    </h2> -->

    <BlogContent
      posts={posts}
      currentPage={1}
      totalPages={allPosts.totalPages}
      latestPost={latestPost}
      showFeaturedPost={true}
    />
  </section>
</Layout>
