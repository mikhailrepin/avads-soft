---
import Layout from "@/layouts/Layout.astro";
import MainHero from "@/components/section/MainHero.astro";
import CallToAction from "@/components/section/CallToAction.astro";

/* Images */
import { Image } from "astro:assets";

/* Data */
import helpers from "@/data/helpers.json";

/* Variables */
const heroBbackground = "/hero/geometry-2.webp";

const historyItems = [
  {
    year: "2021",
    month: "Март",
    description: "Регистрация компании и получение статуса IT-компании.",
    image: "/products/about/registration.png",
  },
  {
    year: "2021",
    month: "Июль",
    description: "Регистрация товарных знаков компании.",
    image: "/products/about/trademark.png",
  },
  {
    year: "2021",
    month: "Декабрь",
    description:
      "Выпуск прототипа системы управления бизнесом MasterCase для компании ИнСАТ.",
    image: "/products/about/mastercase.png",
  },
  {
    year: "2022",
    month: "Июнь",
    description: "Запуск сайта avads.ru",
    image: "/products/about/avads-website.png",
  },
  {
    year: "2022",
    month: "Сентябрь",
    description: "Выпуск АВАДС Сервер архивирования.",
    image: "/products/about/tsdb-app.png",
  },
  {
    year: "2023",
    month: "Октябрь",
    description:
      "Выпуск АВАДС OPC-DB шлюз. Программа, обеспечивающая доступ к АВАДС Сервер архивирования по протоколу OPC UA.",
    image: "/products/about/opc-db-release.png",
  },
  {
    year: "2024",
    month: "Апрель",
    description:
      "Проведена интеграция АВАДС Сервер архивирования со SCADA-системой MasterSCADA 4D.",
    image: "/products/about/tsdb-ms4d.png",
  },
  {
    year: "2025",
    month: "Март",
    description:
      "Выпуск АВАДС САР-эксперт -  инструмент наладчика систем автоматического регулирования.",
    image: "/products/about/sar-release.png",
  },
];
---

<Layout pageTitle="О компании">
  <MainHero backgroundUrl={heroBbackground}>
    <div
      class="flex flex-col justify-center gap-4 mx-auto w-[100%] min-h-[50dvh] main-max-width">
      <h1 class="hero-title">
        <span class="text-silver">Разработка</span><br />
        <span class="text-gold">инновационного</span><br />
        <span class="text-silver">программного обеспечения</span>
      </h1>
      <h3 class="hero-description">
        Мы разрабатываем лучшее программное обеспечение, <br />чтобы помогать
        людям решать сложные задачи.
      </h3>
    </div>
  </MainHero>

  <!-- О нас -->
  <div class="flex flex-col mx-auto pt-14 main-max-width">
    <h2 class="text-3xl">О нас</h2>
    <p class="lg:max-w-[60vw] text-zinc-400 text-lg">
      {helpers.company.name} обладает высочайшими компетенциями в области разработки
      систем реального времени, программ для обработки больших данных, разработки
      кроссплатформенных приложений для промышленных систем управления и для управления
      бизнесом, а также в области систем управления базами данных и разработки WEB-приложений.
    </p>
    <!-- Наши компетенции -->
    <div
      class="gap-8 lg:gap-[52px] grid grid-cols-1 lg:grid-cols-2 pt-10 pb-14">
      <div class="flex flex-col gap-[16px] p-5 border border-primary-300">
        <h3 class="text-gold lg:text-2xl">Наши компетенции</h3>
        <p class="text-zinc-300 lg:text-sm">
          Компания обладает высочайшими компетенциями в области разработки
          систем реального времени, программ для обработки больших данных,
          разработки кроссплатформенных приложений для промышленных систем
          управления и для управления бизнесом, а также в области систем
          управления базами данных и разработки WEB-приложений.
        </p>
      </div>
      <!-- Перечень компетенций -->
      <div class="flex flex-col gap-8">
        {
          [
            {
              icon: "icon-time",
              text: "Разработка систем реального времени",
            },
            {
              icon: "icon-server",
              text: "Разработка систем управления базами данных",
            },
            {
              icon: "icon-code",
              text: "Разработка WEB-приложений",
            },
          ].map((item) => (
            <div class="flex flex-row items-center gap-4 lg:gap-8">
              <img
                src={`/products/about/${item.icon}.svg`}
                alt="About us"
                loading="lazy"
                class="w-10 lg:w-12"
              />
              <span class="text-gold text-lg lg:text-xl">{item.text}</span>
            </div>
          ))
        }
      </div>
    </div>
    <hr class="separator silver" />
  </div>

  <!-- История компании -->
  <div
    class="relative gap-10 grid grid-cols-1 lg:grid-cols-2 mx-auto py-6 main-max-width">
    <!-- Sticky -->
    <div class="sticky-block">
      <h2 class="text-3xl">Наша история</h2>
      <p class="lg:max-w-[60vw] text-zinc-400 text-lg">
        Компания создана бывшими сотрудниками компаний "ИнСАТ" и "МПС СОФТ",
        покинувшими эти компании после продажи продуктов MasterSCADA и MasterOPC
        группе компаний IEK и пожелавшими разрабатывать свои программные
        продукты.
      </p>
      <div class="images-container">
        {
          historyItems.map(
            (item, index) =>
              item.image && (
                <img
                  src={item.image}
                  alt={`История компании - ${item.month} ${item.year}`}
                  loading="lazy"
                  class="history-image"
                  data-image-id={index}
                />
              )
          )
        }
      </div>
    </div>
    <!-- Scrollable -->
    <div class="flex flex-col gap-[16px] pt-8">
      {
        historyItems.map((item, index) => (
          <div
            class="flex flex-col bg-zinc-900/30 px-8 pb-8 border border-zinc-800 rounded-lg transition-all duration-300 history-item"
            data-item-id={index}>
            <h2 class="font-bold text-gold text-2xl">{item.year}</h2>
            <span class="mt-[-16px] mb-4 font-semibold text-zinc-400 text-xl">
              {item.month}
            </span>
            <p class="text-zinc-200 text-lg">{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>

  <div class="flex flex-col mx-auto my-10 main-max-width">
    <CallToAction
      Title="Свяжитесь с нами"
      Description="Оставьте заявку на обратную связь, чтобы наши менеджеры проконсультировали вас по любым вопросам касаемо продукции"
      ButtonProps={{
        ButtonLabel: "Оставить заявку",
        ButtonLink: "/contacts",
      }}
    />
  </div>
</Layout>

<style>
  .sticky-block {
    @apply lg:sticky flex flex-col;
    top: 60px;
    height: fit-content;
    width: 100%;
  }

  .images-container {
    @apply relative mt-7 border-zinc-900 bg-zinc-900/30 border rounded-lg hidden lg:block;
    height: 300px;
    width: 100%;
  }

  .history-image {
    @apply rounded-lg object-cover;
    width: 100%;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease-in-out,
      visibility 0.3s ease-in-out;
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
  }

  .history-image.active {
    opacity: 1;
    visibility: visible;
  }

  .history-item {
    cursor: pointer;
  }

  .history-item:hover {
    @apply lg:border-primary-300 lg:translate-x-[-5px];
  }
</style>

<script>
  const historyItems = document.querySelectorAll(".history-item");
  const historyImages = document.querySelectorAll(".history-image");

  function updateActiveImage(index: number | null) {
    historyImages.forEach((image) => {
      image.classList.remove("active");
    });

    if (index !== null) {
      const targetImage = Array.from(historyImages).find(
        (img) => img.getAttribute("data-image-id") === index.toString()
      );

      if (targetImage) {
        targetImage.classList.add("active");
      }
    }
  }

  historyItems.forEach((item) => {
    item.addEventListener("mouseenter", () => {
      const itemId = item.getAttribute("data-item-id");
      if (itemId !== null) {
        updateActiveImage(parseInt(itemId));
      }
    });

    item.addEventListener("mouseleave", () => {
      updateActiveImage(null);
    });
  });
</script>
