---
import Welcome from "@/components/Welcome.astro";
import Layout from "@/layouts/Layout.astro";
import MainHero from "@/modules/section/MainHero.astro";
import ButtonGeneric from "@/components/inputs/ButtonGeneric.astro";
import { Image } from "astro:assets";
import alarmImage from "@/assets/alarm.png";

const heroBbackground =
  "https://cs12.pikabu.ru/post_img/big/2021/08/29/11/1630262921188049149.jpg";
---

<Layout pageTitle="Страница шаблонов">
  <MainHero backgroundUrl={heroBbackground}>
    <h1 class="uppercase tracking-[0.10rem]">
      Страница <span class="text-primary-300"><br />шаблонов</span><br />и
      компонентов
    </h1>
    <h3 class="pt-3">Для тестирования элементов</h3>
  </MainHero>
  <section class="flex flex-col gap-4 mx-auto main-max-width">
    <Welcome />

    <div class="flex flex-row items-center gap-4 py-2">
      <ButtonGeneric
        Variant="primary"
        Size="big"
        Style="filled"
        Visible={true}
        IconLeft={{
          IconSprite: "alarm-success-fill",
          IconVisible: true,
        }}
        ButtonLink="/templates"
        ButtonLabel="Button generic"
      />
      <ButtonGeneric
        Variant="secondary"
        Size="default"
        Style="outlined"
        Visible={true}
        IconLeft="alarm-info-fill"
        ButtonLink="/templates"
        ButtonLabel="Button generic"
      />
    </div>

    <svg class="w-[16px] h-[16px]">
      <use xlink:href="/sprites.svg#alarm-info-fill"></use>
    </svg>

    <hr class="main-max-width separator silver" />

    <Image
      src={alarmImage}
      alt="Alarm Image"
      width={50}
    />
    <p class="font-light text-m text-pretty leading-relaxed">
      Lorem ipsum dolor sit amet consectetur adipisicing elit. Unde inventore ea
      repellendus perspiciatis numquam atque assumenda possimus animi adipisci
