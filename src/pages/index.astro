---
import Layout from "@/layouts/Layout.astro";
import MainHero from "@/components/section/MainHero.astro";
import BgBlurSpot from "@/components/decorations/BgBlurSpot.astro";
import CallToAction from "@/components/section/CallToAction.astro";
import SoftProductGrid from "@/components/section/SoftProductsGrid.astro";
import PostsGrid from "@/components/section/PostsGrid.astro";
import ProductTabs from "@/components/section/ProductTabs.astro";

const heroBbackground = "/hero/pic_15.webp";

interface AstroPost {
  frontmatter: {
    title: string;
    description: string;
    date: string;
    image: string;
  };
  file: string;
}

const posts = await import.meta.glob<AstroPost>("../pages/news/*.md", {
  eager: true,
});
const postsArray = Object.values(posts) as AstroPost[];

// Сортируем по дате и берем первые 3 поста
const latestPosts = postsArray
  .sort(
    (a, b) =>
      new Date(b.frontmatter.date).getTime() -
      new Date(a.frontmatter.date).getTime()
  )
  .slice(0, 3)
  .map((post) => ({
    title: post.frontmatter.title,
    description: post.frontmatter.description,
    date: post.frontmatter.date,
    image: post.frontmatter.image,
    url: `/news/${post.file.split("/").pop()?.replace(".md", "")}`,
  }));
---

<Layout
  pageTitle="Продвинутые системы автоматизации"
  breadcrumbs={false}>
  <MainHero backgroundUrl={heroBbackground}>
    <div
      class="flex flex-col justify-center gap-4 mx-auto w-[100%] min-h-[60dvh]">
      <h1 class="hero-title">
        <span class="text-silver">Продвинутые</span><br />
        <span class="text-gold">системы</span><br />
        <span class="text-silver">автоматизации</span>
      </h1>
      <span class="hero-description">
        Программное обеспечение и оборудование для автоматизации и
        диспетчеризации
      </span>
    </div>
  </MainHero>
  <section class="relative mx-auto main-max-width">
    <hr class="mb-[52px] separator silver" />
    <BgBlurSpot
      customClass="w-[40vw] h-[40vw] top-[-15%] left-[-10%] opacity-20"
    />
    <h2>Продукты</h2>
    <div class="gap-6 grid grid-cols-1 lg:grid-cols-2">
      <p>
        Компания АВАДС является разработчиком программных и аппаратных решений
        для автоматизации, диспетчеризации и учёта на промышленных объектах, в
        ЖКХ, системах автоматизации зданий и умных домов. Интегрирует
        собственные цифровые продукты с АСУТП, АСУЭ, АСКУЭ, АСТУЭ, АСУЗ (BMS).
        Осуществляет импортозамещение в ключевых IT секторах.
      </p>
      <p>
        Вторым направлением деятельности является разработка программных систем
        для цифровизации бизнеса и создания интернет-порталов. Решения являются
        кроссплатформенными и поддерживают работу на различных аппаратных
        конфигурациях. Особое внимание уделяется оптимизации кода, надёжности и
        безопасности данных.
      </p>
    </div>

    <div class="flex flex-col gap-[52px] my-[52px]">
      <ProductTabs Collapsed={true} />

      <CallToAction
        Title="Свяжитесь с нами"
        Description="Оставьте заявку на обратную связь, чтобы наши менеджеры проконсультировали вас по любым вопросам касаемо продукции"
        ButtonProps={{
          ButtonLabel: "Оставить заявку",
          ButtonLink: "/contacts",
        }}
      />
      <hr class="separator silver" />
      <div class="flex flex-col gap-[24px]">
        <h2>Новости компании</h2>
        <PostsGrid
          posts={latestPosts}
          showAllNewsButton={true}
        />
      </div>
    </div>
  </section>
</Layout>
