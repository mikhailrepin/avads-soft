---
import Layout from "@/layouts/Layout.astro";
import MainHero from "@/modules/section/MainHero.astro";
import ProductCard from "@/modules/card/home-page/ProductCard.astro";
import BgBlurSpot from "@/components/decorations/BgBlurSpot.astro";
import CallToAction from "@/modules/section/CallToAction.astro";
import ButtonGeneric from "@/components/inputs/ButtonGeneric.astro";
import prodSoft from "@/data/prodSoft.json";
import PostsGrid from "@/modules/section/PostsGrid.astro";

const heroBbackground = "/hero/main-page.png";

// Получаем все .md файлы из директории posts
const posts = await Astro.glob("../pages/posts/*.md");
// Сортируем по дате и берем первые 3 поста
const latestPosts = posts
  .sort(
    (a, b) =>
      new Date(b.frontmatter.date).getTime() -
      new Date(a.frontmatter.date).getTime()
  )
  .slice(0, 3)
  .map((post) => ({
    title: post.frontmatter.title,
    description: post.frontmatter.description,
    date: post.frontmatter.date,
    image: post.frontmatter.image,
    url: `/posts/${post.file.split("/").pop()?.replace(".md", "")}`,
  }));
---

<Layout pageTitle="Продвинутые системы автоматизации">
  <MainHero backgroundUrl={heroBbackground}>
    <div
      class="flex flex-col justify-center gap-4 mx-auto w-[100%] min-h-[40dvh] main-max-width">
      <h1 class="uppercase tracking-[0.10rem]">
        <span class="text-silver">Продвинутые</span><br />
        <span class="text-gold">системы</span><br />
        <span class="text-silver">автоматизации</span>
      </h1>
      <h3 class="pt-3">
        Программное обеспечение для автоматизации и диспетчеризации
      </h3>
    </div>
  </MainHero>
  <section class="relative mx-auto main-max-width">
    <hr class="mb-[52px] separator silver" />
    <BgBlurSpot
      customClass="w-[40vw] h-[40vw] top-[-15%] left-[-10%] opacity-20"
    />
    <h2>Продукты</h2>
    <div class="gap-6 grid grid-cols-1 lg:grid-cols-2 my-[48px]">
      <p>
        Компания АВАДС СОФТ является разработчиком программных решений <br />для
        автоматизации, диспетчеризации и учёта на промышленных объектах, <br />в
        ЖКХ, системах автоматизации зданий и умных домов. Интегрирует
        собственные цифровые продукты с АСУТП, АСУЭ, АСКУЭ, АСТУЭ, АСУЗ (BMS).
        Также осуществляет импортозамещение в ключевых IT секторах.
      </p>
      <p>
        Вторым направлением деятельности является разработка программных систем
        для цифровизации бизнеса и создания интернет-порталов. Решения являются
        кроссплатформенными и поддерживают работу на различных аппаратных
        конфигурациях. Особое внимание уделяется оптимизации кода, надёжности и
        безопасности данных.
      </p>
    </div>
    <div class="gap-6 grid grid-cols-1 lg:grid-cols-2 my-[52px]">
      {
        prodSoft.products.slice(0, 4).map((product) => (
          <ProductCard
            Image={product.app.image}
            Title={product.app.name}
            Status={product.app.status}
            Description={product.app.description}
            FirstButton={{
              Visible: !!product.button.first,
              ButtonLabel: product.button.first?.label || "",
              ButtonLink: product.button.first?.link || "#",
              IconLeft: {
                IconSprite: "download-bold",
                IconVisible: true,
              },
              IconRight: {
                IconSprite: "",
                IconVisible: false,
              },
            }}
            SecondButton={{
              Visible: !!product.button.second,
              ButtonLabel: product.button.second?.label || "",
              ButtonLink: product.button.second?.link || "#",
              IconLeft: {
                IconSprite: "",
                IconVisible: false,
              },
              IconRight: {
                IconSprite: "",
                IconVisible: false,
              },
            }}
          />
        ))
      }
    </div>

    <ButtonGeneric
      Variant="primary"
      Size="default"
      Style="ghosted"
      IconRight={{
        IconSprite: "chevron-right-big-outline",
        IconVisible: true,
      }}
      CustomClass="w-fit mx-auto mt-[-16px] mb-[40px]"
      ButtonLabel="Все продукты"
      Target="link"
      ButtonLink="/all-products"
    />

    <CallToAction
      Title="Свяжитесь с нами"
      Description="Оставьте заявку на обратную связь, чтобы наши менеджеры проконсультировали вас по любым вопросам касаемо продукции"
      ButtonProps={{
        ButtonLabel: "Оставить заявку",
        ButtonLink: "/contacts",
      }}
    />
    <hr class="my-[52px] separator silver" />
    <h2 class="mb-[48px]">Новости компании</h2>
    <PostsGrid
      posts={latestPosts}
      showAllNewsButton={true}
    />
  </section>
</Layout>
