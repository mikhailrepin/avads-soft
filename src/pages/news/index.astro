---
import Layout from "@/layouts/Layout.astro";
import PostsGrid from "@/components/section/PostsGrid.astro";
import { getPosts } from "@/utils/posts";

const postsPerPage = 6;
const { totalPages, formatPosts } = await getPosts(postsPerPage);
const currentPage = 1;
const posts_to_show = formatPosts(0, postsPerPage);
---

<Layout pageTitle="Новости">
  <section class="mx-auto py-8 min-h-[100dvh] main-max-width">
    <h1 class="mb-8 font-bold text-4xl">Новости и события компании</h1>
    <PostsGrid
      posts={posts_to_show}
      currentPage={currentPage}
      totalPages={totalPages}
    />
  </section>
</Layout>
