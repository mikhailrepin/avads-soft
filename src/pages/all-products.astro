---
import Layout from "@/layouts/Layout.astro";
import MainHero from "@/modules/section/MainHero.astro";
import ProductCard from "@/modules/card/home-page/ProductCard.astro";
import CallToAction from "@/modules/section/CallToAction.astro";
import FAQ from "@/modules/section/FAQ.astro";
import prodSoft from "@/data/prodSoft.json";
import { FAQ as faqData } from "@/data/faq-main";

const heroBbackground =
  "https://images.unsplash.com/photo-1516937941344-00b4e0337589?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D";
---

<Layout pageTitle="Все продукты">
  <MainHero backgroundUrl={heroBbackground}>
    <div
      class="flex flex-col justify-center gap-4 mx-auto w-[100%] min-h-[50dvh] main-max-width">
      <h1 class="uppercase tracking-[0.10rem]">
        <span class="text-silver">Программное <br />обеспечение</span><br />
        <span class="text-gold">АВАДС СОФТ</span><br />
      </h1>
      <h3 class="pt-3">
        Наши продукты составляют надёжную опору <br /> современной автоматизации
      </h3>
    </div>
  </MainHero>

  <div
    class="gap-6 grid grid-cols-1 lg:grid-cols-2 mx-auto my-[52px] main-max-width">
    {
      prodSoft.products.slice(0, 4).map((product) => (
        <ProductCard
          Image={product.app.image}
          Title={product.app.name}
          Status={product.app.status}
          Description={product.app.description}
          FirstButton={{
            Visible: !!product.button.first,
            ButtonLabel: product.button.first?.label || "",
            ButtonLink: product.button.first?.link || "#",
            IconLeft: {
              IconSprite: "download-bold",
              IconVisible: true,
            },
            IconRight: {
              IconSprite: "",
              IconVisible: false,
            },
          }}
          SecondButton={{
            Visible: !!product.button.second,
            ButtonLabel: product.button.second?.label || "",
            ButtonLink: product.button.second?.link || "#",
            IconLeft: {
              IconSprite: "",
              IconVisible: false,
            },
            IconRight: {
              IconSprite: "",
              IconVisible: false,
            },
          }}
        />
      ))
    }
  </div>

  <CallToAction
    Title="Свяжитесь с нами"
    Description="Оставьте заявку на обратную связь, чтобы наши менеджеры проконсультировали вас по любым вопросам касаемо продукции"
    ButtonProps={{
      ButtonLabel: "Оставить заявку",
      ButtonLink: "/contacts",
    }}
  />

  <FAQ faqData={faqData} />
</Layout>
