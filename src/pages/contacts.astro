---
import Layout from "@/layouts/Layout.astro";
import FeedbackForm from "@/components/forms/FeedbackForm.astro";
import ContactTabs from "@/components/navigation/ContactTabs.astro";
import ContactTabContent from "@/components/navigation/ContactTabContent.astro";
---

<Layout pageTitle="Контакты">
  <section class="content-wrapper main-max-width">
    <!-- Область с контактами -->
    <div class="lg:bg-zinc-900/70 lg:py-4 rounded-lg contacts-wrapper">
      <div class="flex flex-col contacts-tab-content">
        <h3 class="px-8 py-4">Каналы связи</h3>
        <ContactTabs />
        <ContactTabContent />
      </div>
    </div>

    <!-- Область с формой -->
    <div class="form-wrapper">
      <div class="lg:top-[80px] lg:sticky flex flex-col gap-4">
        <h3>Мы рады Вашему сообщению</h3>
        <p class="text-zinc-400">
          Отправьте сообщение через форму обратной связи, <br /> чтобы мы могли связаться
          с Вами
        </p>
        <FeedbackForm />
      </div>
    </div>
  </section>
</Layout>

<style>
  .content-wrapper {
    @apply gap-4 grid grid-cols-1 lg:grid-cols-2 mx-auto my-8;
  }

  .contacts-wrapper,
  .form-wrapper {
    @apply flex flex-col gap-4;
  }

  .form-wrapper {
    @apply bg-zinc-900 p-8 rounded-lg;
  }

  .contacts-tab-content {
    @apply flex flex-col;
  }
</style>

