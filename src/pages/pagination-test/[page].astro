---
import Layout from "@/layouts/Layout.astro";
import PostsGrid from "@/modules/section/PostsGrid.astro";
import TestPagination from "@/components/test/TestPagination.astro";

// Генерируем тестовые посты
function generateTestPosts(count: number) {
  return Array.from({ length: count }, (_, i) => ({
    title: `Тестовый пост ${i + 1}`,
    description: "Это тестовое описание поста для проверки пагинации...",
    date: "01.01.2024",
    image: "https://picsum.photos/800/400",
    url: "#",
  }));
}

// Параметры для тестирования
const totalPosts = 100;
const postsPerPage = 9;
const currentPage = parseInt(Astro.params.page || "1", 10);
const totalPages = Math.ceil(totalPosts / postsPerPage);

// Получаем посты для текущей страницы
const start = (currentPage - 1) * postsPerPage;
const end = start + postsPerPage;
const currentPosts = generateTestPosts(totalPosts).slice(start, end);

// Для отладки
console.log("Page param:", Astro.params.page);
console.log("Current page:", currentPage);

export function getStaticPaths() {
  return Array.from({ length: Math.ceil(100 / 9) }, (_, i) => ({
    params: { page: (i + 1).toString() },
  }));
}
---

<Layout pageTitle="Тест пагинации">
  <div class="mx-auto px-4 py-8 container main-max-width">
    <h1 class="mb-8 font-bold text-3xl">Тест пагинации</h1>

    <PostsGrid posts={currentPosts} />

    <div class="flex justify-center mt-8">
      <TestPagination
        currentPage={currentPage}
        totalPages={totalPages}
      />
    </div>
  </div>
</Layout>

