---
import "@/base.css";
import helpers from "@/data/helpers.json";
import { ClientRouter, fade, slide } from "astro:transitions";
import MainHeader from "@/components/navigation/MainHeader.astro";
import MainFooter from "@/components/navigation/MainFooter.astro";
import BreadCrumbs from "@/components/navigation/BreadCrumbs.astro";

interface Props {
  pageTitle: string;
  downloadLink?: string;
  breadcrumbs?: boolean;
}

const { pageTitle, downloadLink, breadcrumbs = true } = Astro.props;

const menuItems = [
  { label: "Продукты", href: "/all-products" },
  { label: "Цены", href: "/price" },
  { label: "О компании", href: "/about-us" },
  { label: "Техподдержка", href: "/support" },
  { label: "Контакты", href: "/contacts" },
];

const serviceItems = [
  { label: "Конфиденциальность", href: "/docs/privacy/privacy.pdf" },
  { label: "Правовая информация", href: "/docs/privacy/legal-info.pdf" },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <title>{helpers.company.name} | {pageTitle}</title>

    <!-- EmailJS SDK -->
    <!-- <script
      type="text/javascript"
      src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"
    ></script>
    <script type="text/javascript">
      (function () {
        emailjs.init("LSMwzsQT9Ntj5AtDK");
      })();
    </script> -->

    <!-- Типографика -->
    <script type="text/javascript">
      (function () {
        const prepositions = [
          "а",
          "в",
          "во",
          "и",
          "к",
          "о",
          "об",
          "от",
          "с",
          "у",
          "за",
          "на",
          "не",
          "но",
          "по",
          "из",
          "или",
          "над",
          "без",
          "при",
          "про",
          "для",
          "под",
          "через",
        ];

        function formatText(text) {
          if (!text) return "";

          let stats = {
            quotes: 0,
            spaces: 0,
          };

          let formattedText = text;

          // Убираем множественные пробелы только если это текстовый узел
          if (text.trim()) {
            formattedText = text.replace(/\s{2,}/g, " ");
          }

          // Заменяем обычные кавычки на типографские
          let isOpen = true;
          formattedText = formattedText.replace(/"/g, () => {
            const quote = isOpen ? "«" : "»";
            isOpen = !isOpen;
            return quote;
          });

          stats.quotes = Math.floor((text.match(/"/g) || []).length / 2);

          // Добавляем неразрывные пробелы после предлогов
          prepositions.forEach((prep) => {
            // Ищем предлог, перед которым пробел или начало строки, и после которого пробел
            const regex = new RegExp(`(^|\\s)${prep}\\s`, "g");
            const matches = (text.match(regex) || []).length;
            stats.spaces += matches;
            // Сохраняем начальный пробел если он есть, добавляем неразрывный пробел после предлога
            formattedText = formattedText.replace(
              regex,
              "$1" + prep + "\u00A0"
            );
          });

          return formattedText;
        }

        // Находим все текстовые элементы на странице
        function processTextNodes(node) {
          if (node.nodeType === 3) {
            // Текстовый узел
            if (node.nodeValue.trim()) {
              node.nodeValue = formatText(node.nodeValue);
            }
          } else {
            node.childNodes.forEach(processTextNodes);
          }
        }

        // Запускаем форматирование после загрузки страницы
        document.addEventListener("DOMContentLoaded", () => {
          processTextNodes(document.body);
        });
      })();
    </script>
  </head>
  <body
    class="flex flex-col items-center bg-zinc-950 m-0 p-0 w-[100%] h-[100%] text-zinc-200 subpixel-antialiased">
    <MainHeader
      menuItems={menuItems}
      downloadLink={downloadLink}
    />
    <main class="mt-[48px] lg:mt-[64px] w-full">
      {breadcrumbs && <BreadCrumbs pageTitle={pageTitle} />}
      <slot />
    </main>
    <MainFooter
      menuItems={menuItems}
      serviceItems={serviceItems}
    />
  </body>
</html>
