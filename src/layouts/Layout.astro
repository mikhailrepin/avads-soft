---
import "@/base.css";
import { Helpers } from "@/data/helpers.js";
import { ClientRouter, fade, slide } from "astro:transitions";
import MainHeader from "@/components/navigation/MainHeader.astro";
import MainFooter from "@/components/navigation/MainFooter.astro";
import Grammar from "@/modules/scripts/Grammar.astro";
interface Props {
  pageTitle?: string;
}

const { pageTitle = "The title of the current page is not set" } =
  Astro.props as Props;

const menuItems = [
  { label: "Продукты", href: "/all-products" },
  { label: "Цены", href: "/price" },
  { label: "О компании", href: "/about-us" },
  { label: "Техподдержка", href: "/support" },
  { label: "Контакты", href: "/contacts" },
  { label: "❖ Tmp", href: "/templates" },
];

const serviceItems = [
  { label: "Конфиденциальность", href: "/privacy" },
  { label: "Правовая информация", href: "/legal-information" },
  { label: "Настройки cookie", href: "/cookie-settings" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <ClientRouter />
    <title>{Helpers.company.name} | {pageTitle}</title>
  </head>
  <body
    class="flex flex-col items-center bg-zinc-950 m-0 p-0 w-[100%] h-[100%] text-zinc-200 subpixel-antialiased">
    <MainHeader menuItems={menuItems} />
    <main
      class="mt-[48px] lg:mt-[64px]"
      transition:animate={fade({ duration: "0.3s" })}>
      <slot />
    </main>
    <MainFooter
      menuItems={menuItems}
      serviceItems={serviceItems}
    />
    <Grammar />
  </body>
</html>
