---
import Layout from "@/layouts/Layout.astro";
import ButtonGeneric from "@/components/inputs/ButtonGeneric.astro";
import type { Post } from "@/types/interfaces";

interface Props {
  frontmatter: Post;
}

const { frontmatter } = Astro.props;
const { title, description, date, image } = frontmatter;

// Ограничиваем длину заголовка до 60 символов
const truncatedTitle = title.length > 60 ? title.slice(0, 60) + "..." : title;

// Форматируем дату так же, как в PostCard
const formattedDate = new Date(
  date.split(".").reverse().join("-")
).toLocaleDateString("ru-RU", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

// Получаем все посты и сортируем их по дате
const posts = await Astro.glob("../pages/posts/*.md");
const sortedPosts = posts
  .filter((post) => {
    // Проверяем что файл не пустой и имеет все необходимые поля
    if (!post || !post.frontmatter) return false;

    const date = new Date(post.frontmatter.date);
    return (
      post.frontmatter.title &&
      post.frontmatter.description &&
      post.frontmatter.date &&
      post.frontmatter.image &&
      post.frontmatter.image.startsWith("http") &&
      !isNaN(date.getTime())
    );
  })
  .sort(
    (a, b) =>
      new Date(b.frontmatter.date).getTime() -
      new Date(a.frontmatter.date).getTime()
  );

// Находим индекс текущего поста
const currentIndex = sortedPosts.findIndex(
  (post) => post.frontmatter.title === title
);

// Получаем предыдущий и следующий посты
const prevPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
const nextPost =
  currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;

// Проверяем валидность постов
const validPrevPost =
  prevPost && prevPost.frontmatter && prevPost.frontmatter.title;
const validNextPost =
  nextPost && nextPost.frontmatter && nextPost.frontmatter.title;
---

<Layout pageTitle={title}>
  <article class="mx-auto main-max-width">
    <!-- Секция с заголовком -->
    <div
      class="relative flex flex-col justify-center items-start bg-zinc-900 bg-cover bg-center my-4 px-4 lg:px-10 rounded-lg w-full min-h-[40dvh] overflow-hidden"
      style={`background-image: url('${image}')`}>
      <!-- Затемняющий слой -->
      <div class="absolute inset-0 bg-zinc-900/70"></div>

      <!-- Контент поверх изображения -->
      <div class="relative z-10">
        <h1
          class="mb-4 w-full md:max-w-[75%] font-bold text-3xl lg:text-4xl break-words">
          {truncatedTitle}
        </h1>
        <div class="flex items-center gap-2 w-fit font-medium text-zinc-400">
          <svg class="w-[16px] h-[16px]">
            <use xlink:href="/sprites.svg#calendar-single-fill"></use>
          </svg>
          <time>{formattedDate}</time>
        </div>
      </div>
    </div>

    <!-- Описание и контент -->
    <div class="py-4">
      <h2 class="m-0 mb-8 w-full md:max-w-[75%] text-2xl text-zinc-200">
        {description}
      </h2>
      <div class="max-w-full prose prose-lg">
        <slot />
      </div>
    </div>

    <!-- Навигация между постами -->
    <div
      class="items-center grid grid-cols-3 bg-zinc-900/30 my-8 p-4 rounded-lg w-full">
      <!-- Левая кнопка -->
      <div class="justify-self-start">
        {
          prevPost && (
            <ButtonGeneric
              Variant="secondary"
              Size="default"
              Style="ghosted"
              IconLeft={{
                IconSprite: "chevron-left-big-outline",
                IconVisible: true,
              }}
              ButtonLabel={prevPost.frontmatter.title}
              ButtonLink={`/posts/${prevPost.file.split("/").pop()?.replace(".md", "")}`}
              Target="link"
              CustomClass="w-fit uppercase only-desktop"
            />
          )
        }
      </div>

      {/* Центральная кнопка */}
      <div class="justify-self-center">
        <ButtonGeneric
          Variant="secondary"
          Size="default"
          Style="ghosted"
          ButtonLabel="Все новости"
          ButtonLink="/news"
          Target="link"
          CustomClass="w-fit uppercase"
        />
      </div>

      {/* Правая кнопка */}
      <div class="justify-self-end">
        {
          nextPost && (
            <ButtonGeneric
              Variant="secondary"
              Size="default"
              Style="ghosted"
              IconRight={{
                IconSprite: "chevron-right-big-outline",
                IconVisible: true,
              }}
              ButtonLabel={nextPost.frontmatter.title}
              ButtonLink={`/posts/${nextPost.file.split("/").pop()?.replace(".md", "")}`}
              Target="link"
              CustomClass="w-fit uppercase only-desktop"
            />
          )
        }
      </div>
    </div>
  </article>
</Layout>
