---
import Layout from "@/layouts/Layout.astro";
import ButtonGeneric from "@/components/inputs/ButtonGeneric.astro";
import CategoryTags from "@/components/tag/CategoryTags.astro";
import type { Post } from "@/types/interfaces";
import type { BlogCategory } from "@/types/interfaces";
import { formatTitle, formatDescription } from "@/utils/grammar";
import {
  normalizeCategory,
  generateAvatarUrl,
  generateFallbackAvatarUrl,
  getMockAuthor,
} from "@/utils/blog";

interface Props {
  frontmatter: Post;
}

interface PostFile {
  frontmatter: Post;
  file: string;
}

const { frontmatter } = Astro.props;
const { title, description, date, image, category, author } = frontmatter;

// Форматируем заголовок и описание
const formattedTitle = formatTitle(title);
const formattedDescription = formatDescription(description);

// Добавим отладочный вывод
console.log("BlogPostLayout: Форматирование текста");
console.log("Исходный заголовок:", title);
console.log("Отформатированный заголовок:", formattedTitle);

// Ограничиваем длину заголовка до 60 символов
const truncatedTitle = title.length > 60 ? title.slice(0, 60) + "..." : title;

// Форматируем дату так же, как в PostCard
const formattedDate = new Date(
  date.includes(".") ? date.split(".").reverse().join("-") : date
).toLocaleDateString("ru-RU", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

// Получаем категорию поста
const postCategory = normalizeCategory(category);
const categories: BlogCategory[] = [postCategory];

// Получаем автора и аватар
const postAuthor = getMockAuthor(title, author);
const avatarUrl = generateAvatarUrl(postAuthor);
const fallbackAvatarUrl = generateFallbackAvatarUrl(postAuthor);

// Генерируем инициалы для fallback
const initials = (postAuthor || "A")
  .split(" ")
  .map((n) => n[0])
  .join("")
  .toUpperCase()
  .slice(0, 2);

// Получаем все посты и сортируем их по дате
const posts = await import.meta.glob<PostFile>("../pages/blog/*.md", {
  eager: true,
});
const postsArray = Object.values(posts);
const sortedPosts = postsArray
  .filter((post): post is PostFile => {
    if (!post || !post.frontmatter) return false;
    try {
      const date = new Date(post.frontmatter.date);
      return (
        Boolean(post.frontmatter.title) &&
        Boolean(post.frontmatter.description) &&
        Boolean(post.frontmatter.date) &&
        Boolean(post.frontmatter.image) &&
        !isNaN(date.getTime())
      );
    } catch {
      return false;
    }
  })
  .sort(
    (a, b) =>
      new Date(b.frontmatter.date).getTime() -
      new Date(a.frontmatter.date).getTime()
  );

// Находим индекс текущего поста
const currentIndex = sortedPosts.findIndex(
  (post) => post.frontmatter.title === title
);

// Получаем предыдущий и следующий посты
const prevPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
const nextPost =
  currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;

// Проверяем валидность постов
const validPrevPost =
  prevPost && prevPost.frontmatter && prevPost.frontmatter.title;
const validNextPost =
  nextPost && nextPost.frontmatter && nextPost.frontmatter.title;
---

<Layout pageTitle={title}>
  <article class="mx-auto main-max-width">
    <!-- Секция с заголовком -->
    <div
      class="relative flex flex-col justify-center items-start bg-zinc-900 bg-cover bg-center my-4 px-8 lg:px-10 rounded-lg w-full min-h-[30dvh] lg:min-h-[40dvh] overflow-hidden"
      style={`background-image: url('${image}')`}>
      <!-- Затемняющий слой -->
      <div class="absolute inset-0 bg-zinc-950/80"></div>

      <!-- Контент поверх изображения -->
      <div class="z-10 relative">
        <!-- Теги категорий -->
        <CategoryTags categories={categories} customClass="mb-4" />
        <h1 class="post-title">
          {formattedTitle}
        </h1>
        <!-- Блок с аватаром, именем и датой -->
        <div class="flex items-center gap-3 mt-4">
          <div
            class="author-avatar-container"
            data-author={postAuthor || "Автор"}
            data-initials={initials}>
            <img
              src={avatarUrl || fallbackAvatarUrl || `https://ui-avatars.com/api/?name=${encodeURIComponent(initials)}&background=6366f1&color=fff&size=32&bold=true`}
              alt={postAuthor || "Автор"}
              class="author-avatar"
              width="32"
              height="32"
              loading="lazy"
              data-fallback-initials={initials}
            />
            <!-- Fallback с инициалами (скрыт по умолчанию) -->
            <div
              class="bg-primary-400 author-avatar-fallback"
              style="display: none;">
              <span class="author-initials">{initials}</span>
            </div>
          </div>
          <div class="flex flex-col">
            <span class="author-name">{postAuthor || "Автор"}</span>
            <time
              class="post-date"
              datetime={date}
              >{formattedDate}</time
            >
          </div>
        </div>
      </div>
    </div>

    <!-- Описание и контент -->
    <div class="bg-zinc-900/50 px-2 lg:px-4 py-8 lg:py-12 rounded-lg">
      <h4
        class="mx-auto mb-8 font-semibold text-zinc-200 text-xl lg:text-2xl content-wrapper">
        {formattedDescription}
      </h4>
      <div class="content-wrapper prose-container">
        <slot />
      </div>
    </div>

    <!-- Навигация между постами -->
    <div
      class="items-center grid grid-cols-3 bg-zinc-900/50 lg:bg-zinc-900/0 my-5 lg:my-8 p-2 lg:px-0 lg:py-5 border border-zinc-600 lg:border-0 lg:border-t rounded-lg lg:rounded-none w-full">
      <!-- Левая кнопка -->
      <div class="justify-self-start">
        {
          prevPost && (
            <ButtonGeneric
              Variant="secondary"
              Size="default"
              Style="ghosted"
              IconLeft={{
                IconSprite: "chevron-left-big-outline",
                IconVisible: true,
              }}
              ButtonLabel={prevPost.frontmatter.title}
              ButtonLink={`/blog/${prevPost.file.split("/").pop()?.replace(".md", "")}`}
              Target="link"
              CustomClass="only-desktop"
            />
          )
        }
      </div>

      {/* Центральная кнопка */}
      <div class="justify-self-center">
        <ButtonGeneric
          Variant="secondary"
          Size="default"
          Style="ghosted"
          ButtonLabel="Все статьи блога"
          ButtonLink="/blog"
          Target="link"
          CustomClass="w-fit"
        />
      </div>

      {/* Правая кнопка */}
      <div class="justify-self-end">
        {
          nextPost && (
            <ButtonGeneric
              Variant="secondary"
              Size="default"
              Style="ghosted"
              IconRight={{
                IconSprite: "chevron-right-big-outline",
                IconVisible: true,
              }}
              ButtonLabel={nextPost.frontmatter.title}
              ButtonLink={`/blog/${nextPost.file.split("/").pop()?.replace(".md", "")}`}
              Target="link"
              CustomClass="only-desktop"
            />
          )
        }
      </div>
    </div>
  </article>
</Layout>

<style>
  .post-title {
    @apply mb-4 font-bold text-2xl lg:text-4xl break-words !important;
    max-width: 90%;
  }

  .content-wrapper {
    @apply mx-auto;
    max-width: 800px; /* Оптимальная ширина для чтения */
  }

  /* Адаптация для мобильных устройств */
  @media (max-width: 768px) {
    .content-wrapper {
      padding: 0 24px;
    }
  }

  .author-avatar-container {
    @apply relative flex-shrink-0;
  }

  .author-avatar {
    @apply rounded-full w-8 h-8 object-cover;
  }

  .author-avatar-fallback {
    @apply justify-center items-center rounded-full w-8 h-8;
  }

  .author-initials {
    @apply font-bold text-white text-xs;
  }

  .author-name {
    @apply text-zinc-300 text-sm font-medium;
  }

  .post-date {
    @apply text-zinc-400 text-sm whitespace-nowrap;
  }
</style>

<script>
  // Обработка ошибок загрузки аватаров
  function setupAvatarFallback(avatarImg: HTMLImageElement) {
    const container = avatarImg.closest(".author-avatar-container");
    if (!container) return;

    const fallback = container.querySelector(
      ".author-avatar-fallback"
    ) as HTMLElement;
    if (!fallback) return;

    avatarImg.addEventListener("error", () => {
      avatarImg.style.display = "none";
      if (fallback) {
        fallback.style.display = "flex";
      }
    });

    // Если изображение уже загружено с ошибкой
    if (avatarImg.complete && avatarImg.naturalWidth === 0) {
      avatarImg.style.display = "none";
      if (fallback) {
        fallback.style.display = "flex";
      }
    }
  }

  // Инициализация для аватара
  document.addEventListener("DOMContentLoaded", () => {
    const avatarImg = document.querySelector(".author-avatar") as HTMLImageElement;
    if (avatarImg) {
      setupAvatarFallback(avatarImg);
    }
  });
</script>
