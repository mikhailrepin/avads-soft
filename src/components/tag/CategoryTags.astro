---
import ButtonGeneric from "@/components/inputs/ButtonGeneric.astro";
import type { BlogCategory } from "@/types/interfaces";

interface Props {
  categories: BlogCategory[];
  customClass?: string;
}

const { categories, customClass = "" } = Astro.props;

// Маппинг категорий на русские названия
const CATEGORY_LABELS: Record<BlogCategory, string> = {
  all: "Все",
  events: "События",
  articles: "Статьи",
  podcasts: "Подкасты",
  videos: "Обучающие видео",
};
---

<div class={`flex flex-wrap gap-2 ${customClass}`}>
  {
    categories.map((category) => (
      <span
        data-category={category}
        class="category-tag-wrapper">
        <ButtonGeneric
          Variant="secondary"
          Size="small"
          Style="outlined"
          ButtonLabel={CATEGORY_LABELS[category]}
          ButtonLink="/blog"
          Target="link"
          CustomClass="category-tag"
          aria-label={`Фильтр: ${CATEGORY_LABELS[category]}`}
        />
      </span>
    ))
  }
</div>

<script>
  // Обработка клика по тегу категории
  document.addEventListener("DOMContentLoaded", () => {
    const tagWrappers = document.querySelectorAll(".category-tag-wrapper");

    tagWrappers.forEach((wrapper) => {
      const button = wrapper.querySelector("a, button");
      if (button) {
        button.addEventListener("click", (e) => {
          const category = wrapper.getAttribute("data-category");
          if (category) {
            // Сохраняем категорию в localStorage для активации таба на странице блога
            try {
              localStorage.setItem("blog-active-category", category);
            } catch (err) {
              console.warn(
                "Не удалось сохранить категорию в localStorage",
                err
              );
            }
          }
        });
      }
    });
  });
</script>

<style>
  .category-tag-wrapper {
    @apply inline-block;
  }

  .category-tag {
    @apply bg-zinc-800 hover:bg-zinc-700 px-3 py-1.5 rounded-md font-medium text-zinc-300 hover:text-white text-sm transition-colors;
  }
</style>
