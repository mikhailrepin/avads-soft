---
interface AdvantageProps {
  title: string;
  description: string;
  icon: string;
  size?: string;
}

const {
  title,
  description,
  icon,
  size = "48px",
} = Astro.props as AdvantageProps;
---

<div
  class="flex flex-col gap-[16px] p-[32px] border border-zinc-900 rounded-[8px] w-full">
  <svg
    class="mb-[16px] text-primary-100"
    viewBox="0 0 16 16"
    preserveAspectRatio="xMidYMid meet"
    style={`width: ${size}; height: ${size};`}>
    <use xlink:href={`/sprites.svg#${icon}`}></use>
  </svg>
  <h3 class="font-semibold text-zinc-300 text-2xl">{title}</h3>
  <p
    class="text-zinc-400 text-lg"
    set:html={description}
  />
</div>
