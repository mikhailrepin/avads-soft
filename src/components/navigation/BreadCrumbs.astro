---
// Словарь заголовков страниц
const PAGE_TITLES: Record<string, string> = {
  news: "Новости",
  products: "Продукты",
  "all-products": "Все продукты",
};

interface Props {
  pageTitle: string;
  is404?: boolean;
}

const { pageTitle, is404 = false } = Astro.props;

interface PageFile {
  url?: string;
  file?: string;
  frontmatter?: {
    title?: string;
  };
}

// Получаем все страницы и их метаданные
const pages = await Promise.all(
  Object.values(
    import.meta.glob<PageFile>("/src/pages/**/index.{astro,md}")
  ).map((page) => page())
);

// Функция для получения заголовка страницы по сегменту пути
function getPageTitle(segment: string, isLast: boolean): string {
  if (isLast) return pageTitle;

  // Проверяем наличие перевода в словаре
  if (segment in PAGE_TITLES) {
    return PAGE_TITLES[segment];
  }

  try {
    // Ищем только индексные файлы разделов
    const matchedPage = pages.find((page: PageFile) => {
      const url = page.url || page.file || "";
      return url.includes(`/${segment}/index`);
    });

    return matchedPage?.frontmatter?.title ?? segment;
  } catch {
    return segment;
  }
}

// Функция для получения корректного пути
function getPath(segment: string, index: number, array: string[]) {
  if (segment === "posts") {
    return "/news";
  }
  return "/" + array.slice(0, index + 1).join("/");
}

// Функция для фильтрации сегментов пути
function filterSegments(segments: string[]) {
  return segments.filter((segment, index, array) => {
    // Убираем дублирование "news/news"
    if (segment === "news" && array[index - 1] === "news") {
      return false;
    }
    // Пропускаем номера страниц в пути
    if (!isNaN(Number(segment))) {
      return false;
    }
    return segment;
  });
}

function renderBreadcrumbs(segments: string[]) {
  if (segments.length <= 3) {
    // Если сегментов <= 3, показываем все
    return segments.map((segment, index, array) => {
      const isLast = index === array.length - 1;
      return {
        type: "link",
        href: getPath(segment, index, array),
        text: getPageTitle(segment, isLast),
        isLast,
      };
    });
  }

  // Если сегментов > 3, показываем первый, многоточие и последний
  const firstSegment = segments[0];
  const lastSegment = segments[segments.length - 1];

  return [
    {
      type: "link",
      href: getPath(firstSegment, 0, segments),
      text: "←",
      isLast: false,
    },
    {
      type: "dots",
      text: "...",
    },
    {
      type: "link",
      href: getPath(lastSegment, segments.length - 1, segments),
      text: pageTitle || "←",
      isLast: true,
    },
  ];
}
---

<div class="pt-[4px] pb-[16px] w-full breadcrumbs-wrapper">
  <ul class="breadcrumbs main-max-width">
    <li>
      <a
        href="/"
        aria-label="На главную страницу"
        class="ml-[8px] lg:ml-[12px] text-zinc-500 hover:text-primary-300">
        <svg
          class="w-[16px] h-[16px]"
          aria-hidden="true">
          <title>Иконка домашней страницы</title>
          <use xlink:href="/sprites.svg#home-outline"></use>
        </svg>
      </a>
    </li>
    {
      renderBreadcrumbs(
        filterSegments(
          Astro.url.pathname.split("/").filter((segment) => segment)
        )
      ).map((item) => (
        <li>
          {item.type === "dots" ? (
            <span class="text-zinc-600">{item.text}</span>
          ) : (
            <a
              href={item.href}
              class={
                item.isLast
                  ? "text-zinc-100 pointer-events-none"
                  : "text-zinc-500 hover:text-primary-300"
              }>
              <span>{item.text}</span>
            </a>
          )}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .breadcrumbs {
    @apply flex items-center mx-auto;
    & li:last-child::after {
      content: "";
    }
  }

  .breadcrumbs li {
    @apply flex items-center gap-[8px] pr-[8px] text-sm;
    & a {
      @apply flex items-center gap-[8px] max-w-[200px];
      & span {
        @apply truncate;
      }
    }

    &::after {
      content: "/";
      @apply text-zinc-600;
    }
  }
</style>
