---
interface Props {
  pageTitle?: string;
}

const { pageTitle } = Astro.props;

// Проверяем, является ли текущий путь главной страницей
const isHomePage = Astro.url.pathname === "/";

// Функция для форматирования сегмента пути
function formatSegment(segment: string) {
  switch (segment) {
    case "news":
      return "Новости";
    case "posts":
      return "Новости";
    default:
      return segment
        .split("-")
        .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
        .join(" ");
  }
}

// Функция для получения корректного пути
function getPath(segment: string, index: number, array: string[]) {
  if (segment === "posts") {
    return "/news";
  }
  return "/" + array.slice(0, index + 1).join("/");
}

// Функция для фильтрации сегментов пути
function filterSegments(segments: string[]) {
  return segments.filter((segment, index, array) => {
    // Убираем дублирование "news/news"
    if (segment === "news" && array[index - 1] === "news") {
      return false;
    }
    // Пропускаем номера страниц в пути
    if (!isNaN(Number(segment))) {
      return false;
    }
    return segment;
  });
}
---

{
  !isHomePage && (
    <div class="py-[4px] w-full">
      <ul class="breadcrumbs main-max-width">
        <li>
          <a
            href="/"
            class="text-zinc-500 hover:text-primary-300">
            <svg class="w-[16px] h-[16px]">
              <use xlink:href="/sprites.svg#home-fill" />
            </svg>
          </a>
        </li>
        {filterSegments(
          Astro.url.pathname.split("/").filter((segment) => segment)
        ).map((segment, index, array) => {
          const path = getPath(segment, index, array);
          const isLast = index === array.length - 1;
          const name = isLast && pageTitle ? pageTitle : formatSegment(segment);

          return (
            <li>
              <a
                href={path}
                class={
                  isLast
                    ? "pointer-events-none text-zinc-100"
                    : "text-zinc-500 hover:text-primary-300"
                }>
                <span>{name}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  )
}

<style>
  .breadcrumbs {
    @apply flex items-center mx-auto;
    & li:last-child::after {
      content: "";
    }
  }

  .breadcrumbs li {
    @apply flex items-center gap-[8px] pr-[8px];
    & a {
      @apply flex items-center gap-[8px] max-w-[200px];
      & span {
        @apply truncate;
      }
    }

    &::after {
      content: "/";
      @apply text-zinc-600;
    }
  }
</style>
