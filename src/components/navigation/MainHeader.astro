---
import { Image } from "astro:assets";
import logoDark from "@/assets/logo/logo_dark.svg";
import ButtonGeneric from "@/components/inputs/ButtonGeneric.astro";
import helpers from "@/data/helpers.json";

interface MainHeaderProps {
  menuItems: { label: string; href: string }[];
}

const { menuItems } = Astro.props as MainHeaderProps;
const currentPath = Astro.url.pathname;
---

<header id="main-header">
  <div class="main-max-width nav-wrapper">
    <!-- Логотип -->
    <a
      href="/"
      class="logo-link">
      <Image
        src={logoDark}
        alt="Логотип компании"
        loading="eager"
      />
    </a>

    <!-- Меню навигации -->
    <nav
      class="header-nav"
      data-visible="false">
      {
        menuItems.map((item) => (
          <a href={item.href}>
            <span
              class:list={[
                "font-light lg:font-medium text-lg lg:text-base transition-colors",
                { "text-primary-300": currentPath === item.href },
                {
                  "text-zinc-300 hover:text-primary-300":
                    currentPath !== item.href,
                },
              ]}>
              {item.label}
            </span>
          </a>
        ))
      }
      <!-- Кнопка скачать -->
      <ButtonGeneric
        Variant="primary"
        Visible={true}
        Size="default"
        Style="outlined"
        IconLeft={{ IconSprite: "download-light", IconVisible: false }}
        CustomClass="my-[16px] lg:m-0"
        ButtonLabel="Скачать"
        ButtonLink="/download"
        Target="link"
      />
    </nav>

    <!-- Кнопка бургера для мобильных устройств -->
    <button
      id="mobile-menu-button"
      class="flex justify-center items-center border-zinc-600 hover:border-zinc-900 lg:hidden hover:bg-zinc-900 border rounded w-[32px] h-[32px] font-semibold text-zinc-300">
      <svg
        class="w-[16px] h-[16px] transition-opacity duration-200 ease-in-out"
        id="burger-icon">
        <use xlink:href="/sprites.svg#hamburger-menu"></use>
      </svg>
    </button>
  </div>
</header>

<style>
  header {
    @apply fixed border-zinc-900 backdrop-blur-sm w-[100%] transition;
    z-index: 999;
  }

  .nav-wrapper {
    @apply flex justify-between items-center mx-auto lg:py-0 min-h-[48px] lg:min-h-[64px];
  }

  .logo-link {
    @apply lg:hover:opacity-80 mr-[8px] lg:mr-0 w-[100px] lg:w-[132px];
  }

  .header-nav {
    @apply lg:relative top-[48px] lg:top-0 left-0 absolute flex lg:flex lg:flex-row flex-col 
           justify-end lg:items-center gap-[12px] lg:gap-[24px] border-y border-zinc-900 
           bg-zinc-950 lg:bg-transparent shadow-2xl shadow-zinc-950/90 lg:shadow-none 
           px-[16px] lg:px-0 py-[24px] lg:py-0 lg:border-transparent w-[100%];
    display: none;

    @screen lg {
      display: flex;
    }
  }

  .header-nav[data-visible="true"] {
    display: flex;
  }

  /* Добавляем класс для JavaScript */
  .navigation-menu {
  }
</style>

<script>
  let isMenuOpen: boolean = false; // Явно указываем тип для isMenuOpen

  // Функция для смены иконки с анимацией
  const changeIcon = (iconId: string): void => {
    const burgerIcon = document.getElementById("burger-icon");
    if (burgerIcon) {
      burgerIcon.classList.add("opacity-0"); // Плавное исчезновение
      setTimeout(() => {
        burgerIcon.innerHTML = `<use xlink:href="/sprites.svg#${iconId}"></use>`; // Обновляем иконку
        burgerIcon.classList.remove("opacity-0"); // Плавное появление
      }, 120); // Совпадает с длительностью анимации
    }
  };

  // Функция для закрытия меню
  const closeMenu = (): void => {
    const menu = document.querySelector(".header-nav");
    if (menu) {
      menu.setAttribute("data-visible", "false");
    }
    changeIcon("hamburger-menu"); // Меняем иконку на бургер
    isMenuOpen = false; // Обновляем состояние

    // Удаляем классы у header, если страница находится в верхней точке
    if (window.scrollY === 0) {
      removeHeaderClasses();
    }
  };

  // Функция для переключения меню
  const toggleMenu = (): void => {
    isMenuOpen = !isMenuOpen;
    const menu = document.querySelector(".header-nav");

    if (menu) {
      if (isMenuOpen) {
        menu.setAttribute("data-visible", "true");
        changeIcon("cross-big"); // Меняем иконку на "X"
        addHeaderClasses(); // Добавляем классы к header при открытии меню
      } else {
        closeMenu(); // Закрываем меню и меняем иконку
      }
    }
  };

  // Функция для добавления классов к header
  const addHeaderClasses = (): void => {
    const header = document.getElementById("main-header");
    if (header) {
      header.classList.add("bg-zinc-950", "border-b");
    }
  };

  // Функция для удаления классов у header
  const removeHeaderClasses = (): void => {
    const header = document.getElementById("main-header");
    if (header) {
      header.classList.remove("bg-zinc-950", "border-b");
    }
  };

  // Функция для обработки прокрутки
  const handleScroll = (): void => {
    const header = document.getElementById("main-header");
    if (header && !isMenuOpen) {
      // Проверяем, что меню закрыто
      if (window.scrollY > 64) {
        addHeaderClasses(); // Добавляем классы, если прокрутка больше 64px
      } else {
        removeHeaderClasses(); // Убираем классы, если прокрутка меньше 64px
      }
    }
  };

  document.addEventListener("DOMContentLoaded", () => {
    const burgerButton = document.getElementById("mobile-menu-button");
    if (burgerButton) {
      // Заменяем два обработчика на один с preventDefault
      burgerButton.addEventListener("click", (e) => {
        e.preventDefault(); // Предотвращаем двойное срабатывание
        toggleMenu();
      });
    }

    // Используем только click для закрытия меню
    document.addEventListener("click", (e) => {
      const header = document.getElementById("main-header");
      // Проверяем, что клик был не по кнопке меню
      const burgerButton = document.getElementById("mobile-menu-button");

      if (
        e.target instanceof Node &&
        header &&
        !header.contains(e.target) &&
        isMenuOpen &&
        (!burgerButton || !burgerButton.contains(e.target))
      ) {
        closeMenu();
      }
    });

    // Проверяем текущую прокрутку при загрузке страницы
    if (window.scrollY > 64) {
      addHeaderClasses();
    }

    // Добавляем обработчик прокрутки
    window.addEventListener("scroll", handleScroll);
  });
</script>
