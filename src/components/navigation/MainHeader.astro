---
import ButtonGeneric from "@/components/inputs/ButtonGeneric.astro";

// Импортируем данные о продуктах
import prodSoft from "@/data/prodSoft.json";
import helpers from "@/data/helpers.json";

interface MainHeaderProps {
  menuItems: { label: string; href: string }[];
  downloadLink?: string;
}

const { menuItems, downloadLink = "/downloads" } =
  Astro.props as MainHeaderProps;
const currentPath = Astro.url.pathname;

// Получаем только активные продукты (те, у которых есть status)
const activeProducts = prodSoft.products.filter(
  (product) => product.app.status
);
---

<header id="main-header">
  <div class="main-max-width nav-wrapper">
    <!-- Логотип -->
    <a
      href="/"
      class="flex items-center gap-[8px] logo-link">
      <div class="logo-container">
        <img
          src="/products/avads.png"
          alt={helpers.company.name}
          loading="eager"
          class="block fallback-logo"
        />
        <video
          class="hidden lg:block logo-video"
          width="100"
          height="32"
          muted
          playsinline
          loop
          preload="none">
          <source
            src="/products/logo-animate.webm"
            type="video/webm"
          />
        </video>
      </div>
      <span class="text-[1.3rem] text-zinc-100 tracking-[0.15rem]"
        >{helpers.company.name}</span
      >
    </a>

    <!-- Меню навигации -->
    <nav
      class="header-nav"
      data-visible="false">
      {
        menuItems.map((item) => (
          <div class="nav-item-wrapper">
            <a
              href={item.href}
              class:list={[
                "nav-item",
                { "has-dropdown": item.label === "Продукты" },
              ]}>
              <span
                class:list={[
                  "font-light lg:font-medium text-lg lg:text-base transition-colors",
                  { "text-primary-300": currentPath === item.href },
                  {
                    "text-zinc-300 hover:text-primary-300":
                      currentPath !== item.href,
                  },
                ]}>
                {item.label}
              </span>
              {item.label === "Продукты" && (
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  class="size-5 text-white">
                  <g clip-path="url(#clip0_2918_4497)">
                    <path
                      d="M15.428 10c.486 0 .74.493.447.812l-.043.042-3.429 3a.61.61 0 0 1-.368.145.63.63 0 0 1-.386-.104l-.054-.041-3.429-3-.047-.047-.031-.039-.03-.048-.01-.018-.016-.034-.018-.053-.006-.027-.006-.03L8 10.53v-.06l.003-.029.005-.03.006-.025.018-.054.015-.034.04-.066.038-.045.041-.04.054-.042.044-.027.055-.027.02-.008.039-.014.061-.016.03-.005.035-.005.033-.002 6.89-.001Z"
                      fill="currentColor"
                    />
                  </g>
                  <defs>
                    <clipPath id="clip0_2918_4497">
                      <path
                        fill="#fff"
                        d="M0 0h24v24H0z"
                      />
                    </clipPath>
                  </defs>
                </svg>
              )}
            </a>

            {/* Выпадающий список только для пункта "Продукты" */}
            {item.label === "Продукты" && (
              <div class="hidden lg:block dropdown-menu">
                <div class="dropdown-content">
                  {activeProducts.map((product) => (
                    <a
                      href={`/all-products/${product.id}`}
                      class="dropdown-item">
                      <img
                        src={product.app.image}
                        alt={product.app.name}
                        class="w-6 h-6"
                      />
                      <span>{product.app.name}</span>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))
      }
      <!-- Кнопка скачать -->
      <ButtonGeneric
        Variant="primary"
        Visible={true}
        Size="default"
        Style="outlined"
        IconLeft={{ IconSprite: "download-light", IconVisible: false }}
        CustomClass="my-[16px] lg:m-0"
        ButtonLabel="Скачать"
        ButtonLink={downloadLink}
        Target="link"
      />
    </nav>

    <!-- Кнопка бургера для мобильных устройств -->
    <button
      id="mobile-menu-button"
      class="lg:hidden flex justify-center items-center hover:bg-zinc-900 border border-zinc-600 hover:border-zinc-900 rounded w-[32px] h-[32px] font-semibold text-zinc-300">
      <svg
        class="w-[16px] h-[16px] transition-opacity duration-200 ease-in-out"
        id="burger-icon">
        <use xlink:href="/sprites.svg#hamburger-menu"></use>
      </svg>
    </button>
  </div>
</header>

<style>
  header {
    @apply fixed backdrop-blur-[10px] border-zinc-900 w-[100%] transition-all duration-500;
    z-index: 999;
  }

  .nav-wrapper {
    @apply flex justify-between items-center mx-auto lg:py-0 min-h-[48px] lg:min-h-[64px];
  }

  .logo-link {
    @apply mr-[8px] lg:mr-0 w-[100px] lg:w-[132px];
  }

  .header-nav {
    @apply lg:relative top-[48px] lg:top-0 left-0 absolute flex lg:flex lg:flex-row flex-col 
           justify-end lg:items-center gap-[12px] lg:gap-[24px] border-y border-zinc-900 
           bg-zinc-950 lg:bg-transparent shadow-2xl shadow-zinc-950/90 lg:shadow-none 
           px-[16px] lg:px-0 py-[24px] lg:py-0 lg:border-transparent w-[100%];
    display: none;

    @screen lg {
      display: flex;
    }
  }

  .header-nav[data-visible="true"] {
    display: flex;
  }

  /* Добавляем класс для JavaScript */
  .navigation-menu {
  }

  .nav-item-wrapper {
    @apply relative;
  }

  .dropdown-menu {
    @apply invisible opacity-0 absolute top-full left-1/2 -translate-x-1/2 
           min-w-[320px] transition-all duration-200 ease-in-out mt-[0px] pt-[24px];
    pointer-events: none;
  }

  .nav-item-wrapper:hover .dropdown-menu {
    @apply opacity-100 visible;
    pointer-events: auto;
  }

  .dropdown-content {
    @apply flex flex-col bg-zinc-950 shadow-2xl shadow-zinc-950 p-[16px] border border-zinc-900 rounded-[8px];
  }

  .dropdown-item {
    @apply flex items-center gap-3 px-[16px] py-[12px] text-zinc-300 
           hover:bg-primary-300/10 hover:text-primary-300 whitespace-nowrap rounded-[4px];
  }

  /* Добавляем стрелочку для пункта с дропдауном */
  .has-dropdown::after {
    content: "";
    @apply hidden; /* Скрываем CSS стрелку */
  }

  /* Добавляем новый стиль для SVG иконки */
  .has-dropdown svg {
    @apply inline-block transition-transform duration-300;
  }

  .nav-item-wrapper:hover .has-dropdown svg {
    @apply rotate-180;
  }

  /* Стили для активного состояния */
  .nav-item-wrapper:hover .nav-item {
    @apply text-primary-300;
  }

  .logo-container {
    @apply relative w-[100px] lg:w-[132px] h-[32px];
  }

  .logo-video {
    @apply top-0 left-0 z-10 absolute w-full h-full object-contain;
  }

  .fallback-logo {
    @apply relative w-full h-full object-contain;
  }

  .logo-video.video-loaded:not([data-error]) + .fallback-logo {
    @apply lg:opacity-0;
  }
</style>

<script>
  let isMenuOpen: boolean = false; // Явно указываем тип для isMenuOpen

  // Функция для смены иконки с анимацией
  const changeIcon = (iconId: string): void => {
    const burgerIcon = document.getElementById("burger-icon");
    if (burgerIcon) {
      burgerIcon.classList.add("opacity-0"); // Плавное исчезновение
      setTimeout(() => {
        burgerIcon.innerHTML = `<use xlink:href="/sprites.svg#${iconId}"></use>`; // Обновляем иконку
        burgerIcon.classList.remove("opacity-0"); // Плавное появление
      }, 120); // Совпадает с длительностью анимации
    }
  };

  // Функция для закрытия меню
  const closeMenu = (): void => {
    const menu = document.querySelector(".header-nav");
    if (menu) {
      menu.setAttribute("data-visible", "false");
    }
    changeIcon("hamburger-menu"); // Меняем иконку на бургер
    isMenuOpen = false; // Обновляем состояние

    // Удаляем классы у header, если страница находится в верхней точке
    if (window.scrollY === 0) {
      removeHeaderClasses();
    }
  };

  // Функция для переключения меню
  const toggleMenu = (): void => {
    isMenuOpen = !isMenuOpen;
    const menu = document.querySelector(".header-nav");

    if (menu) {
      if (isMenuOpen) {
        menu.setAttribute("data-visible", "true");
        changeIcon("cross-big"); // Меняем иконку на "X"
        addHeaderClasses(); // Добавляем классы к header при открытии меню
      } else {
        closeMenu(); // Закрываем меню и меняем иконку
      }
    }
  };

  // Функция для добавления классов к header
  const addHeaderClasses = (): void => {
    const header = document.getElementById("main-header");
    if (header) {
      header.classList.add("bg-zinc-950", "border-b");
    }
  };

  // Функция для удаления классов у header
  const removeHeaderClasses = (): void => {
    const header = document.getElementById("main-header");
    if (header) {
      header.classList.remove("bg-zinc-950", "border-b");
    }
  };

  // Функция для обработки прокрутки
  const handleScroll = (): void => {
    const header = document.getElementById("main-header");
    if (header && !isMenuOpen) {
      // Проверяем, что меню закрыто
      if (window.scrollY > 64) {
        addHeaderClasses(); // Добавляем классы, если прокрутка больше 64px
      } else {
        removeHeaderClasses(); // Убираем классы, если прокрутка меньше 64px
      }
    }
  };

  document.addEventListener("DOMContentLoaded", () => {
    const burgerButton = document.getElementById("mobile-menu-button");
    if (burgerButton) {
      // Заменяем два обработчика на один с preventDefault
      burgerButton.addEventListener("click", (e) => {
        e.preventDefault(); // Предотвращаем двойное срабатывание
        toggleMenu();
      });
    }

    // Используем только click для закрытия меню
    document.addEventListener("click", (e) => {
      const header = document.getElementById("main-header");
      // Проверяем, что клик был не по кнопке меню
      const burgerButton = document.getElementById("mobile-menu-button");

      if (
        e.target instanceof Node &&
        header &&
        !header.contains(e.target) &&
        isMenuOpen &&
        (!burgerButton || !burgerButton.contains(e.target))
      ) {
        closeMenu();
      }
    });

    // Проверяем текущую прокрутку при загрузке страницы
    if (window.scrollY > 64) {
      addHeaderClasses();
    }

    // Добавляем обработчик прокрутки
    window.addEventListener("scroll", handleScroll);

    // Добавляем обработчик для закрытия дропдауна по клику вне
    document.addEventListener("click", (e) => {
      const dropdowns = document.querySelectorAll(".dropdown-menu");
      const navItems = document.querySelectorAll(".nav-item-wrapper");

      navItems.forEach((item) => {
        if (!item.contains(e.target as Node)) {
          const dropdown = item.querySelector(".dropdown-menu");
          if (dropdown) {
            dropdown.classList.add("invisible", "opacity-0");
            setTimeout(() => {
              dropdown.classList.remove("invisible", "opacity-0");
            }, 200);
          }
        }
      });
    });

    // Обработчик для видео-логотипа
    const logoVideo = document.querySelector<HTMLVideoElement>(".logo-video");
    const logoLink = document.querySelector(".logo-link");

    if (logoVideo && logoLink) {
      logoLink.addEventListener("mouseenter", () => {
        logoVideo.currentTime = 0;
        logoVideo.play();
      });

      logoLink.addEventListener("mouseleave", () => {
        logoVideo.removeAttribute("loop");
        logoVideo.addEventListener(
          "ended",
          function onEnd() {
            logoVideo.setAttribute("loop", "");
            logoVideo.currentTime = 0;
            logoVideo.pause();
            logoVideo.removeEventListener("ended", onEnd);
          },
          { once: true }
        );
      });
    }
  });
</script>
