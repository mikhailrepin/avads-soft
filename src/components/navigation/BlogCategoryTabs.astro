---
interface Props {
  customClass?: string;
  storageKey?: string;
}

const { customClass = "", storageKey = "blog-active-category" } = Astro.props;

const tabsClass = `tabs-panel blog-category-tabs ${customClass}`;
---

<div
  class="blog-category-tabs-wrapper"
  role="tablist"
  aria-label="Категории блога"
  data-storage-key={storageKey}>
  <div class={tabsClass}>
    <button
      role="tab"
      data-category="all"
      aria-controls="all-panel"
      aria-selected="true"
      id="all-tab"
      class="active">
      <span>Все</span>
    </button>
    <button
      role="tab"
      data-category="events"
      aria-controls="events-panel"
      aria-selected="false"
      id="events-tab">
      <span>События</span>
    </button>
    <button
      role="tab"
      data-category="articles"
      aria-controls="articles-panel"
      aria-selected="false"
      id="articles-tab">
      <span>Статьи</span>
    </button>
    <button
      role="tab"
      data-category="podcasts"
      aria-controls="podcasts-panel"
      aria-selected="false"
      id="podcasts-tab">
      <span>Подкасты</span>
    </button>
    <button
      role="tab"
      data-category="videos"
      aria-controls="videos-panel"
      aria-selected="false"
      id="videos-tab">
      <span>Обучающие видео</span>
    </button>
  </div>
</div>

<script>
  // Инициализация табов категорий блога
  document.addEventListener("DOMContentLoaded", () => {
    const tabsPanels = document.querySelectorAll(".blog-category-tabs");

    tabsPanels.forEach((panel) => {
      const tabs = panel.querySelectorAll("button[role='tab']");
      const storageKey =
        panel.getAttribute("data-storage-key") || "blog-active-category";

      // Функция для прокрутки к активному табу
      function scrollToTab(tab: Element) {
        const wrapper = panel.querySelector(
          ".blog-category-tabs-wrapper"
        ) as HTMLElement;
        if (!wrapper) return;

        const tabElement = tab as HTMLElement;
        const tabRect = tabElement.getBoundingClientRect();
        const wrapperRect = wrapper.getBoundingClientRect();

        // Вычисляем позицию для центрирования активного таба
        const scrollLeft = wrapper.scrollLeft;
        const tabLeft = tabElement.offsetLeft;
        const tabWidth = tabElement.offsetWidth;
        const wrapperWidth = wrapper.offsetWidth;

        // Прокручиваем так, чтобы таб был виден
        const targetScroll = tabLeft - wrapperWidth / 2 + tabWidth / 2;

        wrapper.scrollTo({
          left: targetScroll,
          behavior: "smooth",
        });
      }

      // Функция для активации таба
      function activateTab(targetTab: Element, skipAnimation = false) {
        // Обновляем состояние табов
        tabs.forEach((t) => {
          t.classList.remove("active");
          t.setAttribute("aria-selected", "false");
        });
        targetTab.classList.add("active");
        targetTab.setAttribute("aria-selected", "true");

        // Прокручиваем к активному табу
        scrollToTab(targetTab);

        const category = targetTab.getAttribute("data-category");
        if (category) {
          // Сохраняем в localStorage
          try {
            localStorage.setItem(storageKey, category);
          } catch (e) {
            console.warn("Не удалось сохранить категорию в localStorage", e);
          }

          // Обновляем панели контента
          const ariaControls = targetTab.getAttribute("aria-controls");
          if (ariaControls) {
            const activePanel = document.getElementById(ariaControls);
            const tabPanels = document.querySelectorAll(
              ".blog-tab-content [role='tabpanel']"
            );

            if (activePanel) {
              if (skipAnimation) {
                // Быстрое переключение без анимации
                tabPanels.forEach((p) => {
                  if (p !== activePanel) {
                    p.classList.remove(
                      "block",
                      "opacity-100",
                      "h-auto",
                      "overflow-visible"
                    );
                    p.classList.add("opacity-0", "h-0", "overflow-hidden");
                  } else {
                    p.classList.remove("opacity-0", "h-0", "overflow-hidden");
                    p.classList.add(
                      "block",
                      "opacity-100",
                      "h-auto",
                      "overflow-visible"
                    );
                  }
                });
              } else {
                // Анимированное переключение
                tabPanels.forEach((p) => {
                  if (p !== activePanel) {
                    p.classList.remove("opacity-100");
                    p.classList.add("opacity-0");
                  }
                });

                setTimeout(() => {
                  tabPanels.forEach((p) => {
                    if (p !== activePanel) {
                      p.classList.remove("block", "h-auto", "overflow-visible");
                      p.classList.add("h-0", "overflow-hidden");
                    }
                  });

                  activePanel.classList.remove("h-0", "overflow-hidden");
                  activePanel.classList.add(
                    "block",
                    "h-auto",
                    "overflow-visible"
                  );

                  setTimeout(() => {
                    activePanel.classList.remove("opacity-0");
                    activePanel.classList.add("opacity-100");
                  }, 50);
                }, 150);
              }
            }
          }

          // Показываем/скрываем секцию свежего поста
          const featuredSection = document.querySelector(
            ".featured-post-section"
          );
          if (featuredSection) {
            if (category === "all") {
              featuredSection.classList.remove("hidden");
            } else {
              featuredSection.classList.add("hidden");
            }
          }
        }
      }

      // Восстанавливаем активный таб при загрузке страницы
      function restoreActiveTab() {
        try {
          const savedCategory = localStorage.getItem(storageKey) || "all";
          const targetTab = panel.querySelector(
            `[data-category="${savedCategory}"]`
          );
          if (targetTab) {
            activateTab(targetTab, true);
          }
        } catch (e) {
          // Если не удалось восстановить, активируем первый таб
          const firstTab = tabs[0];
          if (firstTab) {
            activateTab(firstTab, true);
          }
        }
      }

      // Обработчики клика на табы
      tabs.forEach((tab) => {
        tab.addEventListener("click", (e) => {
          e.preventDefault();
          activateTab(tab);
        });

        // Эффект прозрачности при наведении
        tab.addEventListener("mouseenter", () => {
          tabs.forEach((otherTab) => {
            if (otherTab !== tab) {
              (otherTab as HTMLElement).style.opacity = "0.6";
            }
          });
        });

        tab.addEventListener("mouseleave", () => {
          tabs.forEach((otherTab) => {
            (otherTab as HTMLElement).style.opacity = "1";
          });
        });
      });

      // Восстанавливаем состояние
      restoreActiveTab();
    });
  });
</script>

<style>
  /* Контейнер с прокруткой */
  .blog-category-tabs-wrapper {
    @apply mb-8 overflow-x-auto;
    /* Скрываем скроллбар, но оставляем функциональность прокрутки */
    scrollbar-width: thin;
    scrollbar-color: rgb(63 63 70) transparent;

    &::-webkit-scrollbar {
      height: 6px;
    }

    &::-webkit-scrollbar-track {
      background: transparent;
    }

    &::-webkit-scrollbar-thumb {
      background-color: rgb(63 63 70);
      border-radius: 3px;

      &:hover {
        background-color: rgb(82 82 91);
      }
    }

    /* Плавная прокрутка */
    scroll-behavior: smooth;
  }

  /* Используем базовые стили из base.css для .tabs-panel */
  .blog-category-tabs {
    @apply flex flex-nowrap;
    min-width: max-content;

    & button {
      @apply flex-shrink-0 mr-2 font-[300];
    }
  }
</style>
