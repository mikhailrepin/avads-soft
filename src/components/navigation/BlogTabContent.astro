---
interface Props {
  activeCategory?: string;
}

const { activeCategory = "all" } = Astro.props;
---

<div class="blog-tab-content">
  <!-- Панель "Все" -->
  <div
    role="tabpanel"
    id="all-panel"
    aria-labelledby="all-tab"
    class={activeCategory === "all" ? "block opacity-100 h-auto overflow-visible tab-panel" : "opacity-0 h-0 overflow-hidden tab-panel"}>
    <slot name="all" />
  </div>

  <!-- Панель "События" -->
  <div
    role="tabpanel"
    id="events-panel"
    aria-labelledby="events-tab"
    class={activeCategory === "events" ? "block opacity-100 h-auto overflow-visible tab-panel" : "opacity-0 h-0 overflow-hidden tab-panel"}>
    <slot name="events" />
  </div>

  <!-- Панель "Статьи" -->
  <div
    role="tabpanel"
    id="articles-panel"
    aria-labelledby="articles-tab"
    class={activeCategory === "articles" ? "block opacity-100 h-auto overflow-visible tab-panel" : "opacity-0 h-0 overflow-hidden tab-panel"}>
    <slot name="articles" />
  </div>

  <!-- Панель "Подкасты" -->
  <div
    role="tabpanel"
    id="podcasts-panel"
    aria-labelledby="podcasts-tab"
    class={activeCategory === "podcasts" ? "block opacity-100 h-auto overflow-visible tab-panel" : "opacity-0 h-0 overflow-hidden tab-panel"}>
    <slot name="podcasts" />
  </div>

  <!-- Панель "Обучающие видео" -->
  <div
    role="tabpanel"
    id="videos-panel"
    aria-labelledby="videos-tab"
    class={activeCategory === "videos" ? "block opacity-100 h-auto overflow-visible tab-panel" : "opacity-0 h-0 overflow-hidden tab-panel"}>
    <slot name="videos" />
  </div>
</div>

<style>
  .blog-tab-content {
    @apply w-full;
  }

  .tab-panel {
    @apply w-full;
    transform: translateY(10px);
    transition:
      opacity 0.3s ease-in-out,
      height 0.3s ease-in-out,
      transform 0.3s ease-in-out;
    will-change: height, opacity, transform;
  }

  .tab-panel.block {
    transform: translateY(0);
  }

  .tab-panel.h-0 {
    height: 0 !important;
    min-height: 0 !important;
  }

  .tab-panel.h-auto {
    height: auto !important;
  }
</style>
