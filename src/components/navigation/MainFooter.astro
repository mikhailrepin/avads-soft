---
import { Image } from "astro:assets";
import logoDark from "@/assets/logo/logo_dark.svg";
import { Helpers } from "@/data/helpers.js";

interface MainFooterProps {
  menuItems: { label: string; href: string }[];
  serviceItems: { label: string; href: string }[];
}

const { menuItems, serviceItems } = Astro.props as MainFooterProps;
---

<footer class="relative z-[998] border-zinc-900 bg-zinc-950 border-t w-full">
  <!-- Верхняя часть -->
  <div class="flex justify-between mx-auto py-[16px] main-max-width">
    <!-- Логотип и описание компании -->
    <div class="flex flex-col">
      <a
        href="/"
        class="lg:hover:opacity-80 w-[100px] lg:w-[132px]">
        <Image
          src={logoDark}
          alt="Alarm Image"
        />
      </a>
      <p class="mt-1 ml-[32px] lg:ml-[40px] w-[132px] text-xs text-zinc-400">
        {Helpers.company.slogan}
      </p>
    </div>

    <!-- Меню навигации -->
    <div
      class="flex lg:flex-row flex-col gap-[8px] lg:gap-[12px] py-[4px] min-h-[32px] navigation-menu">
      {
        menuItems.map((item) => (
          <a href={item.href}>
            <span class="font-light lg:font-medium text-sm">{item.label}</span>
          </a>
        ))
      }
    </div>

    <!-- Телефон -->
    <div class="flex flex-col items-end">
      <p class="font-semibold text-lg text-primary-300 lg:text-2xl">
        {Helpers.company.phone}
      </p>
    </div>
  </div>

  <!-- Нижняя часть -->
  <div class="bg-zinc-900/80 py-[12px]">
    <div
      class="flex lg:flex-row flex-col mx-auto w-[100%] font-light text-xs text-zinc-400 main-max-width">
      <p class="border-zinc-700 pr-[12px] border-r">
        © 2022 – {new Date().getFullYear()}
        {Helpers.company.name}. Все права защищены
      </p>
      <ul class="flex navigation-menu">
        {
          serviceItems.map((item) => (
            <li class="border-zinc-700 lg:px-[12px] border-r last:border-r-0">
              <a
                href={item.href}
                class="hover:text-primary-300">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
