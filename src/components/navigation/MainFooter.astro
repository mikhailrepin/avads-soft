---
import { Image } from "astro:assets";
import logoDark from "@/assets/logo/logo_dark.svg";
import { Helpers } from "@/data/helpers.js";

interface MainFooterProps {
  menuItems: { label: string; href: string }[];
  serviceItems: { label: string; href: string }[];
}

const { menuItems, serviceItems } = Astro.props as MainFooterProps;
---

<footer>
  <!-- Верхняя часть -->
  <div class="footer-top">
    <!-- Логотип и описание компании -->
    <a
      href="/"
      class="logo-link">
      <Image
        src={logoDark}
        alt="Логотип компании"
        height={32}
      />
      <span>{Helpers.company.slogan}</span>
    </a>

    <!-- Меню навигации -->
    <nav class="nav-menu">
      {
        menuItems.map((item) => (
          <a href={item.href}>
            <span>{item.label}</span>
          </a>
        ))
      }
    </nav>

    <!-- Телефон -->
    <a
      href={`tel:${Helpers.company.phone}`}
      class="phone-link">
      {Helpers.company.phone}
    </a>
  </div>

  <!-- Нижняя часть -->
  <div class="footer-bottom">
    <ul>
      <li>
        © 2022 – {new Date().getFullYear()}
        {Helpers.company.name}. Все права защищены
      </li>
      {
        serviceItems.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  footer {
    @apply flex flex-col border-zinc-900 bg-zinc-950 mb-10 border-t w-full;
    & .footer-top {
      @apply flex lg:flex-row flex-col lg:justify-between gap-6 lg:gap-0 mx-auto lg:py-[16px] p-4 w-full main-max-width;
      & .logo-link {
        @apply flex flex-col;
        filter: grayscale(1);
        &:hover {
          filter: grayscale(0);
        }
        & span {
          @apply text-xs text-zinc-300;
        }
      }
    }
    & .footer-bottom {
      @apply bg-zinc-900 w-full;
      & ul {
        @apply flex flex-wrap gap-4 mx-auto py-[8px] text-xs main-max-width;
        & li {
          @apply border-zinc-700 pr-[12px] border-r text-zinc-400 hover:text-zinc-100;
        }
        & li:first-child:hover {
          @apply text-zinc-400;
        }
        & li:last-child {
          @apply border-none;
        }
      }
    }
  }
</style>
