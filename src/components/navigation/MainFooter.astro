---
import { Image } from "astro:assets";
import logoDark from "@/assets/logo/logo_dark.svg";
import helpers from "@/data/helpers.json";

interface MainFooterProps {
  menuItems: { label: string; href: string }[];
  serviceItems: { label: string; href: string }[];
}

const { menuItems, serviceItems } = Astro.props as MainFooterProps;
---

<footer>
  <!-- Верхняя часть -->
  <div class="footer-top main-max-width">
    <!-- Логотип и описание компании -->
    <a
      href="/"
      class="logo-link">
      <Image
        src={logoDark}
        alt="Логотип компании"
        height={32}
      />
      <span>{helpers.company.slogan}</span>
    </a>

    <!-- Меню навигации -->
    <nav class="nav-menu">
      {
        menuItems.map((item) => (
          <a href={item.href}>
            <span>{item.label}</span>
          </a>
        ))
      }
    </nav>

    <!-- Телефон -->
    <a
      href={`tel:${helpers.company.phone}`}
      class="text-gold phone-link">
      {helpers.company.phone}
    </a>
  </div>

  <!-- Нижняя часть -->
  <div class="footer-bottom">
    <ul class="main-max-width">
      <li>
        © 2022 – {new Date().getFullYear()}
        {helpers.company.name}. Все права защищены
      </li>
      {
        serviceItems.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  footer {
    @apply flex flex-col border-zinc-900 bg-zinc-950 border-t w-full;
    & .footer-top {
      @apply flex lg:flex-row flex-col lg:justify-between gap-[16px] mx-auto py-[24px] lg:py-[32px] w-full;
      & .logo-link {
        @apply flex lg:flex-col items-center lg:items-start min-w-[230px];
        filter: grayscale(1);
        &:hover {
          filter: grayscale(0);
        }
        & span {
          @apply ml-[12px] lg:ml-[40px] max-w-[180px] lg:max-w-[190px] text-[11px] text-zinc-400 lg:text-xs;
          line-height: 1.3;
        }
      }
      & .nav-menu {
        @apply flex lg:flex-row flex-wrap gap-[16px] py-[4px] h-fit text-sm;
        & a {
          @apply hover:text-primary-300;
        }
      }
      & .phone-link {
        @apply lg:text-right min-w-[230px] font-bold text-xl;
      }
    }
    & .footer-bottom {
      @apply bg-zinc-900 w-full;
      & ul {
        @apply flex flex-wrap gap-4 mx-auto py-[8px] text-xs;
        & li {
          @apply border-zinc-700 pr-[12px] border-r text-sm text-zinc-400 hover:text-zinc-100;
        }
        & li:first-child:hover {
          @apply text-zinc-400;
        }
        & li:last-child {
          @apply border-none;
        }
      }
    }
  }
</style>
