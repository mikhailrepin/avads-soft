---
const { IconSprite, CustomClass = "", IconSize = 16 } = Astro.props;

// Отладочная информация
if (!IconSprite) {
  console.warn("Icon component: IconSprite prop is missing");
}
---

<svg
  class={`lib-icon ${CustomClass}`}
  viewBox="0 0 16 16"
  width={IconSize}
  height={IconSize}>
  <use href={`/sprites.svg#${IconSprite}`}></use>
</svg>

<style>
  .lib-icon {
    fill: currentColor;
    display: inline-block;
    vertical-align: middle;
  }
</style>
