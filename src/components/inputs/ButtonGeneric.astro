---
import type { BaseButton, Elem, IconProps } from "@/types/interfaces";

interface Props extends BaseButton {
  ButtonLabel?: string;
  ButtonLink?: string;
  CustomClass?: string;
  LabelClass?: string;
  class?: string;
  type?: "button" | "submit" | "reset";
  onclick?: string;
}

const {
  Visible = true,
  Variant = "primary" as Elem["Variant"],
  Size = "default" as Elem["Size"],
  Style = "filled" as Elem["Style"],
  Disabled = false,
  Loading = false,
  Toggle = false,
  Tooltip = "",
  IconLeft = { IconSprite: "", IconVisible: false } as IconProps,
  IconRight = { IconSprite: "", IconVisible: false } as IconProps,
  ButtonLabel,
  ButtonLink = "",
  Blank = false,
  CustomClass = "",
  onclick,
  Target = "action" as Elem["Target"],
  type = "button",
} = Astro.props as Props;

const BaseClasses = "base-classes";

const StyleClasses = {
  primary: {
    filled: "primary filled",
    outlined: "primary outlined",
    ghosted: "primary ghosted",
    hidden: "hidden",
  },
  secondary: {
    filled: "secondary filled",
    outlined: "secondary outlined",
    ghosted: "secondary ghosted",
    hidden: "hidden",
  },
  disabled: "disabled",
};

const SizeClasses = {
  default: "size default",
  small: "size small",
  big: "size big",
};

const ButtonClasses = `${BaseClasses} ${CustomClass} ${StyleClasses[Variant][Style]} ${SizeClasses[Size]} ${Disabled ? StyleClasses.disabled : ""}`;
---

{
  Visible &&
    (Target === "link" ? (
      <a
        class={ButtonClasses}
        href={ButtonLink}
        title={Tooltip}
        target={Blank ? "_blank" : "_self"}>
        {IconLeft.IconVisible && (
          <svg
            class="icon"
            viewBox="0 0 16 16">
            <use xlink:href={`/sprites.svg#${IconLeft.IconSprite}`} />
          </svg>
        )}
        {ButtonLabel && (
          <span class:list={["button-label"]}>{ButtonLabel}</span>
        )}
        {IconRight.IconVisible && (
          <svg
            class="icon"
            viewBox="0 0 16 16">
            <use xlink:href={`/sprites.svg#${IconRight.IconSprite}`} />
          </svg>
        )}
      </a>
    ) : (
      <button
        type={type}
        class={ButtonClasses}
        onclick={onclick}
        title={Tooltip}>
        {IconLeft.IconVisible && (
          <svg
            class="icon"
            viewBox="0 0 16 16">
            <use xlink:href={`/sprites.svg#${IconLeft.IconSprite}`} />
          </svg>
        )}
        {ButtonLabel && (
          <span class:list={["button-label"]}>{ButtonLabel}</span>
        )}
        {IconRight.IconVisible && (
          <svg
            class="icon"
            viewBox="0 0 16 16">
            <use xlink:href={`/sprites.svg#${IconRight.IconSprite}`} />
          </svg>
        )}
      </button>
    ))
}

<style>
  .icon {
    @apply flex items-center fill-current w-[16px] h-[16px];
    flex-shrink: 0;
  }
  .button-label {
    @apply block mx-[4px] max-w-[400px] truncate;
  }
  .only-desktop .button-label {
    @apply hidden lg:block;
  }
  .base-classes {
    @apply flex justify-center items-center border rounded;
    &:active {
      @apply scale-[90%] transition-all ease-in-out;
    }
  }
  .hidden {
    display: none;
  }
  .disabled {
    @apply opacity-50 pointer-events-none;
  }
  .primary {
    &.filled {
      @apply bg-primary-300 hover:bg-primary-400 border-primary-300 hover:border-primary-400 text-primary-500;
    }
    &.outlined {
      @apply hover:bg-primary-400 border-primary-300 hover:border-primary-400 text-primary-300 hover:text-primary-500;
    }
    &.ghosted {
      @apply hover:bg-primary-400 hover:border-primary-400 border-transparent text-primary-300 hover:text-primary-500;
    }
  }
  .secondary {
    &.filled {
      @apply bg-zinc-800 hover:bg-zinc-900 border-zinc-800 hover:border-zinc-900 text-zinc-200 hover:text-zinc-400;
    }
    &.outlined {
      @apply hover:bg-zinc-900 border-zinc-600 hover:border-zinc-900 text-zinc-300;
    }
    &.ghosted {
      @apply hover:bg-zinc-900 hover:border-zinc-900 border-transparent text-zinc-300 hover:text-zinc-400;
    }
  }
  .size {
    &.small {
      @apply p-[4px] max-h-[24px];
      & .button-label {
        @apply px-[4px] text-[12px];
      }
    }
    &.default {
      @apply p-[8px] max-h-[32px];
      & .button-label {
        @apply px-[4px] font-semibold text-[16px];
      }
    }
    &.big {
      @apply p-[12px] max-h-[40px] md:max-h-[48px] text-base md:text-xl;
      & .button-label {
        @apply px-[4px] font-semibold text-[16px];
      }
    }
  }
</style>
