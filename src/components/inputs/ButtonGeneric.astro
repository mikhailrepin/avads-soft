---
type ButtonType = "primary" | "secondary";
type ButtonSize = "default" | "big";
type ButtonStyle = "filled" | "outlined";
type ButtonTarget = "button" | "link";

interface ButtonProps {
  type?: ButtonType;
  size?: ButtonSize;
  style?: ButtonStyle;
  customClass?: string;
  leftIcon?: string;
  buttonLabel?: string;
  rightIcon?: string;
  onclick?: () => void;
  href?: string;

  target?: ButtonTarget;
}

const {
  type = "primary",
  size = "default",
  style = "filled",
  customClass,
  leftIcon,
  buttonLabel,
  rightIcon,
  onclick,
  href,
  target = "button",
} = Astro.props as ButtonProps;

const baseClasses =
  "flex items-center gap-2 justify-center border rounded font-semibold";

const typeStyleClasses = {
  primary: {
    filled:
      "border-primary-300 text-primary-500 bg-primary-300 hover:bg-primary-400 hover:border-primary-400",
    outlined:
      "border-primary-300 text-primary-300 hover:bg-primary-400 hover:border-primary-400 hover:text-primary-500",
  },
  secondary: {
    filled:
      "border-zinc-800 text-zinc-200 bg-zinc-800 hover:bg-zinc-900 hover:text-zinc-400 hover:border-zinc-900",
    outlined:
      "border-zinc-600 text-zinc-300 hover:bg-zinc-900 hover:border-zinc-900",
  },
};

const sizeClasses = {
  default: "p-3 max-h-[32px] md:max-h-[40px]",
  big: "p-4 max-h-[40px] md:max-h-[48px] text-base md:text-xl",
};

const buttonClasses = `${baseClasses} ${customClass} ${typeStyleClasses[type][style]} ${sizeClasses[size]}`;
---

{
  target === "link" ? (
    <a
      class={buttonClasses}
      href={href}>
      {leftIcon && (
        <svg class="flex items-center w-[16px] h-[16px]">
          <use xlink:href={`/sprites.svg#${leftIcon}`} />
        </svg>
      )}
      {buttonLabel}
      {rightIcon && (
        <svg class="flex items-center w-[16px] h-[16px]">
          <use xlink:href={`/sprites.svg#${rightIcon}`} />
        </svg>
      )}
    </a>
  ) : (
    <button
      class={buttonClasses}
      onclick={onclick}>
      {leftIcon && (
        <svg class="flex items-center w-[16px] h-[16px]">
          <use xlink:href={`/sprites.svg#${leftIcon}`} />
        </svg>
      )}
      {buttonLabel}
      {rightIcon && (
        <svg class="flex items-center w-[16px] h-[16px]">
          <use xlink:href={`/sprites.svg#${rightIcon}`} />
        </svg>
      )}
    </button>
  )
}
