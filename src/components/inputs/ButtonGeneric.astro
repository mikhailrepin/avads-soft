---
import type { BaseButton, Elem, IconProps } from "@/types/interfaces";

const {
  Visible = true,
  Variant = "primary" as Elem["Variant"],
  Size = "default" as Elem["Size"],
  Style = "filled" as Elem["Style"],
  Disabled = false,
  Loading = false,
  Toggle = false,
  Tooltip = "",
  IconLeft = { IconSprite: "", IconVisible: false } as IconProps,
  IconRight = { IconSprite: "", IconVisible: false } as IconProps,
  ButtonLabel,
  ButtonLink = "",
  CustomClass = "",
  Onclick,
  Target = "action" as Elem["Target"],
} = Astro.props as BaseButton;

const BaseClasses = "base-classes";

const StyleClasses = {
  primary: {
    filled: "primary filled",
    outlined: "primary outlined",
    ghosted: "primary ghosted",
    hidden: "hidden",
  },
  secondary: {
    filled: "secondary filled",
    outlined: "secondary outlined",
    ghosted: "secondary ghosted",
    hidden: "hidden",
  },
  disabled: "disabled",
};

const SizeClasses = {
  default: "size default",
  small: "size small",
  big: "size big",
};

const ButtonClasses = `${BaseClasses} ${CustomClass} ${StyleClasses[Variant][Style]} ${SizeClasses[Size]} ${Disabled ? StyleClasses.disabled : ""}`;
---

{
  Visible &&
    (Target === "link" ? (
      <a
        class={ButtonClasses}
        href={ButtonLink}
        title={Tooltip}>
        {IconLeft.IconVisible && (
          <svg class="icon">
            <use xlink:href={`/sprites.svg#${IconLeft.IconSprite}`} />
          </svg>
        )}
        {ButtonLabel}
        {IconRight.IconVisible && (
          <svg class="icon">
            <use xlink:href={`/sprites.svg#${IconRight.IconSprite}`} />
          </svg>
        )}
      </a>
    ) : (
      <button
        class={ButtonClasses}
        onclick={Onclick}
        title={Tooltip}>
        {IconLeft.IconVisible && (
          <svg class="icon">
            <use xlink:href={`/sprites.svg#${IconLeft.IconSprite}`} />
          </svg>
        )}
        {ButtonLabel}
        {IconRight.IconVisible && (
          <svg class="icon">
            <use xlink:href={`/sprites.svg#${IconRight.IconSprite}`} />
          </svg>
        )}
      </button>
    ))
}

<style>
  .icon {
    @apply flex items-center w-[16px] h-[16px];
  }
  .base-classes {
    @apply flex justify-center items-center gap-2 border rounded font-semibold;
    &:active {
      @apply transition-all ease-in-out scale-[90%];
    }
  }
  .hidden {
    display: none;
  }
  .disabled {
    @apply opacity-50 pointer-events-none;
  }
  .primary {
    &.filled {
      @apply border-primary-300 hover:border-primary-400 bg-primary-300 hover:bg-primary-400 text-primary-500;
    }
    &.outlined {
      @apply border-primary-300 hover:border-primary-400 hover:bg-primary-400 text-primary-300 hover:text-primary-500;
    }
    &.ghosted {
      @apply hover:border-primary-400 hover:bg-primary-400 border-transparent text-primary-300 hover:text-primary-500;
    }
  }
  .secondary {
    &.filled {
      @apply border-zinc-800 hover:border-zinc-900 bg-zinc-800 hover:bg-zinc-900 text-zinc-200 hover:text-zinc-400;
    }
    &.outlined {
      @apply border-zinc-600 hover:border-zinc-900 hover:bg-zinc-900 text-zinc-300;
    }
    &.ghosted {
      @apply border-zinc-600 hover:border-zinc-900 hover:bg-zinc-900 text-zinc-300 hover:text-zinc-400;
    }
  }
  .size {
    &.small {
      @apply p-2 max-h-[24px] md:max-h-[32px] text-sm;
    }
    &.default {
      @apply p-3 max-h-[32px] md:max-h-[40px];
    }
    &.big {
      @apply p-4 max-h-[40px] md:max-h-[48px] text-base md:text-xl;
    }
  }
</style>
