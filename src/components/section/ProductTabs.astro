---
import SoftProductsGrid from "@/components/section/SoftProductsGrid.astro";
import HardProductsGrid from "@/components/section/HardProductsGrid.astro";
import ProductTabsNavigation from "@/components/navigation/ProductTabs.astro";
import TabContent from "@/components/navigation/TabContent.astro";

const { Collapsed = false } = Astro.props;
---

<section>
  <ProductTabsNavigation />

  <TabContent>
    <SoftProductsGrid
      Collapsed={Collapsed}
      slot="software"
    />
    <HardProductsGrid
      Collapsed={Collapsed}
      slot="hardware"
    />
  </TabContent>
</section>
