---
/* Images */
import { Image } from "astro:assets";
import platformsImage from "@/assets/media/platforms.png";

interface Props {
  data: Array<{
    image: string;
    title: string;
    description: string;
  }>;
  appIcon: string;
}

const { data, appIcon } = Astro.props;
---

<div class="flex flex-col gap-4 bg-zinc-100 pt-10 pb-20 text-zinc-900">
  <h2 class="mx-auto w-full text-3xl main-max-width">
    Поддерживаемые платформы
  </h2>
  <div class="mx-auto w-full main-max-width">
    <div class="flex lg:flex-row flex-col gap-[40px]">
      <slot />
      <div class="relative mb-[3%] w-full lg:max-w-[40%] h-full">
        <Image
          src={platformsImage}
          alt="Сервер Архивирования"
          class="z-0 w-[100%]"
        />
        <img
          src={appIcon}
          alt={appIcon}
          class="right-[38%] bottom-[-30%] z-10 absolute w-[25%]"
        />
      </div>
    </div>
  </div>
  <div class="mx-auto pt-4 w-full main-max-width">
    <hr class="mx-auto separator silver" />
  </div>

  <h3 class="mx-auto py-4 w-full text-lg text-zinc-900 main-max-width">
    Платформы и ОС
  </h3>
  <div
    class="gap-[16px] grid grid-cols-1 lg:grid-cols-4 mx-auto main-max-width">
    {
      data.map((platform) => (
        <div class="group card">
          <img
            class="group-hover:grayscale-0 opacity-80 group-hover:opacity-100 transition-all grayscale"
            src={platform.image}
            alt={platform.title}
          />
          <span class="title">{platform.title}</span>
          <p class="description">{platform.description}</p>
        </div>
      ))
    }
  </div>
</div>

<style>
  .card {
    @apply flex flex-col items-center gap-[12px] p-4 pb-5 border rounded-md text-center;
    & img {
      @apply w-[100px] h-[100px];
    }
  }

  .title {
    @apply font-medium text-xl text-zinc-900;
  }

  .description {
    @apply text-sm text-zinc-400;
  }
</style>
