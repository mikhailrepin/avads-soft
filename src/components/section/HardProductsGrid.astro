---
import prodHard from "@/data/prodHard.json";
import ButtonGeneric from "@/components/inputs/ButtonGeneric.astro";
import HardProductCard from "@/components/card/HardProductCard.astro";

interface Props {
  Collapsed?: boolean;
}

const { Collapsed = false } = Astro.props;
const products = Collapsed ? prodHard.products.slice(0, 4) : prodHard.products;
---

<section class="flex flex-col w-[100%]">
  <div class="gap-6 grid grid-cols-1 lg:grid-cols-3">
    {
      prodHard.products.map((product) => (
        <HardProductCard
          Image={product.device.image}
          Title={product.device.name}
          Status={product.device.status}
          Description={product.device.description}
          ProductLink={product.buttons?.more?.link || ""}
          FirstButton={{
            Visible: !!product.buttons?.buy,
            ButtonLabel: product.buttons?.buy?.label || "",
            ButtonLink: product.buttons?.buy?.link || "#",
            IconLeft: {
              IconSprite: "cart-fill",
              IconVisible: true,
            },
            IconRight: {
              IconSprite: "",
              IconVisible: false,
            },
          }}
          SecondButton={{
            Visible: !!product.buttons?.more,
            ButtonLabel: product.buttons?.more?.label || "",
            ButtonLink: product.buttons?.more?.link || "#",
            IconLeft: {
              IconSprite: "",
              IconVisible: false,
            },
            IconRight: {
              IconSprite: "",
              IconVisible: false,
            },
          }}
        />
      ))
    }
  </div>
  {
    Collapsed && (
      <div class="flex justify-center mt-[52px]">
        <ButtonGeneric
          Variant="primary"
          Size="default"
          Style="outlined"
          Target="link"
          ButtonLabel="Все продукты"
          ButtonLink="/all-products"
        />
      </div>
    )
  }
</section>
