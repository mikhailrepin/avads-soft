---
import ButtonGeneric from "@/components/inputs/ButtonGeneric.astro";
import Icon from "@/components/decorations/Icon.astro";
import prodHard from "@/data/prodHard.json";

// Функция для проверки наличия валидных кнопок
const hasValidButtons = (product: any) => {
  if (!product.buttons || typeof product.buttons !== "object") {
    return false;
  }
  
  // Проверяем, что в buttons есть хотя бы одна кнопка с данными
  return Object.values(product.buttons).some(
    (button: any) => 
      button && 
      typeof button === "object" && 
      button.label && 
      button.link
  );
};

// Фильтруем продукты, у которых есть supports И валидные кнопки
const productsWithSupports = prodHard.products.filter(product => 
  product.supports && hasValidButtons(product)
);

type SupportItem = {
  icon: string;
  label: string;
  link: string;
};

type SupportData = {
  docs?: Record<string, SupportItem>;
  marketing?: Record<string, SupportItem>;
  visualization?: {
    models: Array<{
      id: string;
      title: string;
      files: Record<string, SupportItem>;
    }>;
  };
  social?: {
    video?: {
      title: string;
      items: Array<{
        id: string;
        title: string;
        cover: string;
        link: string;
      }>;
    };
  };
};
---

<section class="product-grid-wrapper">
  <!-- Левая колонка с навигацией -->
  <aside class="product-nav-bar">
    <ul>
      {
        productsWithSupports.map((product) => (
          <li>
            <a href={`#${product.id}`}>
              <img
                src={product.device.image}
                alt={product.id}
                loading="lazy"
              />
              {product.device.name}
            </a>
          </li>
        ))
      }
    </ul>
  </aside>

  <!-- Правая колонка с карточками -->
  <div class="product-cards-col">
    {
      productsWithSupports.map((product) => (
        <div
          class="product-card"
          id={product.id}>
          <div class="product-card-head">
            <img
              src={product.device.image}
              alt={product.device.name}
              loading="lazy"
              class="w-[60px] h-[60px] object-contain product-icon hardware-icon"
            />
            <div class="product-card-info">
              <span class="product-title">{product.device.name}</span>
              <span class="product-description">{product.device.description}</span>
            </div>
          </div>

          <div class="with-left-padding product-card-body">
            {product.supports && (
              <div class="support-sections">
                <!-- Документация -->
                {product.supports.docs && Object.keys(product.supports.docs).length > 0 && (
                  <>
                    <div class="support-section">
                      <h4 class="support-section-title">Документация</h4>
                      <div class="support-items">
                        {Object.entries(product.supports.docs).map(([key, doc]) => (
                          <ButtonGeneric
                            Variant="primary"
                            Size="small"
                            Style="ghosted"
                            Visible={true}
                            IconLeft={{
                              IconSprite: doc.icon,
                              IconVisible: true,
                            }}
                            CustomClass="w-fit"
                            Target="link"
                            Blank={true}
                            ButtonLabel={doc.label}
                            ButtonLink={doc.link}
                          />
                        ))}
                      </div>
                    </div>
                    <hr class="separator silver" />
                  </>
                )}

                <!-- Маркетинговые материалы -->
                {product.supports.marketing && Object.keys(product.supports.marketing).length > 0 && (
                  <>
                    <div class="support-section">
                      <h4 class="support-section-title">Маркетинговые материалы</h4>
                      <div class="support-items">
                        {Object.entries(product.supports.marketing).map(([key, material]) => (
                          <ButtonGeneric
                            Variant="primary"
                            Size="small"
                            Style="ghosted"
                            Visible={true}
                            IconLeft={{
                              IconSprite: material.icon,
                              IconVisible: true,
                            }}
                            CustomClass="w-fit"
                            Target="link"
                            Blank={true}
                            ButtonLabel={material.label}
                            ButtonLink={material.link}
                          />
                        ))}
                      </div>
                    </div>
                    <hr class="separator silver" />
                  </>
                )}

                <!-- Визуализация -->
                {product.supports.visualization && product.supports.visualization.models && product.supports.visualization.models.length > 0 && (
                  <>
                    <div class="support-section">
                      <h4 class="support-section-title">3D модели и визуализация</h4>
                      {product.supports.visualization.models.map((model) => (
                        <div class="model-subsection">
                          <h5 class="model-title">{model.title}</h5>
                          <div class="support-items">
                            {Object.entries(model.files).map(([key, file]) => (
                              <ButtonGeneric
                                Variant="primary"
                                Size="small"
                                Style="ghosted"
                                Visible={true}
                                IconLeft={{
                                  IconSprite: file.icon,
                                  IconVisible: true,
                                }}
                                CustomClass="w-fit"
                                Target="link"
                                Blank={true}
                                ButtonLabel={file.label}
                                ButtonLink={file.link}
                              />
                            ))}
                          </div>
                        </div>
                      ))}
                    </div>
                    <hr class="separator silver" />
                  </>
                )}

                <!-- Видеоматериалы -->
                {product.supports.social && product.supports.social.video && product.supports.social.video.items && product.supports.social.video.items.length > 0 && (
                  <div class="support-section">
                    <h4 class="support-section-title">{product.supports.social.video.title}</h4>
                    <div class="video-grid-downloads">
                      {product.supports.social.video.items.map((video) => (
                        <a
                          href={video.link}
                          target="_blank"
                          class="video-card">
                          <div class="video-cover">
                            <img src={video.cover} alt={video.title} />
                            <div class="play-button">
                              <Icon
                                IconSprite="playback-play-big-fill"
                                CustomClass="play-icon"
                              />
                            </div>
                          </div>
                          <h4 class="video-title">{video.title}</h4>
                        </a>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const navLinks = document.querySelectorAll<HTMLElement>(".product-nav-bar a");

    // Обработка эффекта прозрачности
    navLinks.forEach((link) => {
      link.addEventListener("mouseenter", () => {
        navLinks.forEach((otherLink) => {
          if (otherLink !== link) {
            otherLink.style.opacity = "0.6";
          }
        });
      });

      link.addEventListener("mouseleave", () => {
        navLinks.forEach((otherLink) => {
          otherLink.style.opacity = "1";
        });
      });
    });

    // Обработка плавной прокрутки
    navLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const targetId = link.getAttribute("href")?.replace("#", "") ?? "";
        const targetElement = document.getElementById(targetId);

        if (targetElement) {
          const offset = 80;
          const elementPosition = targetElement.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - offset;

          window.scrollTo({
            top: offsetPosition,
            behavior: "smooth",
          });
        }
      });
    });
  });
</script>