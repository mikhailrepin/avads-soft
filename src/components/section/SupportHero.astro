---
interface Props {
  productImage: string;
  productName: string;
  backgroundImage?: string;
}

const {
  productImage,
  productName,
  backgroundImage = "/hero/abstract-10.webp", // значение по умолчанию
} = Astro.props;
---

<section class="mx-auto main-max-width">
  <div
    class="content-wrapper"
    style={`background-image: url('${backgroundImage}')`}>
    <div class="content">
      <img
        src={productImage}
        alt={productName}
        class="mr-4 w-[5rem]"
      />
      <div class="flex flex-col gap-2">
        <h1 class="medium-heading text-xl">{productName}</h1>
        <p class="w-fit text-zinc-300">
          Справочные материалы и поддержка по продукту
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    @apply w-full;
    .content-wrapper {
      @apply bg-cover bg-no-repeat bg-center rounded-lg h-full overflow-hidden;
      .content {
        @apply flex items-center gap-4 p-10 min-h-[40dvh] bg-slate-900/50 backdrop-blur-[8px];
      }
    }
  }
</style>
