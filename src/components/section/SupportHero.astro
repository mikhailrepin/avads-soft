---
interface Props {
  productImage: string;
  productName: string;
  backgroundImage?: string;
}

const {
  productImage,
  productName,
  backgroundImage = "/hero/abstract-10.webp", // значение по умолчанию
} = Astro.props;
---

<section class="mx-auto mt-5 main-max-width">
  <div
    class="content-wrapper"
    style={`background-image: url('${backgroundImage}')`}>
    <div class="content">
      <img
        src={productImage}
        alt={productName}
        class="mr-2 lg:mr-4 w-[4rem] lg:w-[5rem]"
      />
      <div class="flex flex-col gap-2">
        <h1 class="medium-heading">{productName}</h1>
        <p class="w-fit text-zinc-300 text-sm lg:text-base">
          Справочные материалы и поддержка по продукту
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Уникальные стили для SupportHero компонента */
  section {
    @apply w-full;

    .content-wrapper {
      @apply bg-cover bg-no-repeat bg-center rounded-lg h-full overflow-hidden;

      .content {
        @apply flex items-center gap-4 p-5 lg:p-10 min-h-[20dvh] lg:min-h-[40dvh] bg-slate-900/50 backdrop-blur-[8px];
      }
    }
  }
</style>
