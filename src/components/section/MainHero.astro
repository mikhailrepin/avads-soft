---
interface MainHeroProps {
  backgroundUrl: string;
  compensateBreadcrumbs?: boolean;
}

const { backgroundUrl, compensateBreadcrumbs = false } =
  Astro.props as MainHeroProps;
---

<section
  class={`lg:bg-fixed hero-wrapper ${compensateBreadcrumbs ? "hero-wrapper--compensated" : ""}`}
  style={`background-image: url(${backgroundUrl});`}>
  <!-- Область контента -->
  <div class="content-area main-max-width">
    <slot />
  </div>
</section>

<style is:global>
  .hero-wrapper {
    @apply relative flex justify-center items-center bg-cover bg-no-repeat bg-center py-6 lg:py-10 w-full h-[50dvh] min-h-fit overflow-hidden;
    &::before {
      @apply top-0 left-0 z-10 absolute bg-zinc-950/70 lg:bg-zinc-950/80 backdrop-blur-sm lg:backdrop-blur-none w-full h-full;
      content: "";
    }
    & .content-area {
      @apply z-20 relative flex flex-col gap-4 w-[100%];

      & .content {
        @apply flex flex-col justify-center gap-4 mx-auto w-[100%];
      }
    }
  }

  /* Компенсированная версия для главной страницы */
  .hero-wrapper--compensated {
    @apply lg:h-[calc(50vh+40px)];
  }
</style>
