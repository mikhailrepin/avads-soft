---
import ButtonGeneric from "@/components/inputs/ButtonGeneric.astro";
import prodHard from "@/data/prodHard.json";
import PriceTable from "@/components/price/PriceTable.astro";
import PriceTableASP from "@/components/price/PriceTableASP.astro";
import PriceSARXP from "@/components/price/PriceSARXP.astro";
import { Image } from "astro:assets";

// Функция для проверки наличия хотя бы одной кнопки с данными
const hasValidButtons = (product: any) => {
  if (!product.buttons || typeof product.buttons !== "object") {
    return false;
  }

  // Проверяем каждую кнопку на наличие label и link
  return Object.values(product.buttons).some(
    (button: any) =>
      button && typeof button === "object" && button.label && button.link
  );
};

// Фильтруем продукты с ценами и валидными кнопками
const productsWithPrices = prodHard.products.filter(
  (product) => product.prices && hasValidButtons(product)
);

// Функция для определения стратегии загрузки
const getLoadingStrategy = (index: number) => {
  // Первые два продукта загружаем сразу, остальные - лениво
  return index < 2 ? "eager" : "lazy";
};
---

<section class="product-grid-wrapper with-margin">
  <!-- Левая колонка с навигацией -->
  <aside class="product-nav-bar">
    <ul>
      {
        productsWithPrices.map((product) => (
          <li>
            <a href={`#${product.id}`}>
              <Image
                src={product.device.image}
                alt={product.id}
                width={40}
                height={40}
                loading="lazy"
                class="product-icon"
              />
              {product.device.name}
            </a>
          </li>
        ))
      }
    </ul>
  </aside>

  <!-- Правая колонка с карточками продуктов -->
  <div class="product-cards-col">
    {
      productsWithPrices.map((product) => (
        <div
          class="product-card"
          id={product.id}>
          <div class="product-card-head">
            <Image
              src={product.device.image}
              alt={product.id}
              width={60}
              height={60}
              loading="lazy"
              class="w-[60px] h-[60px] object-contain product-icon hardware-icon"
            />
            <div class="product-card-info">
              <span class="product-title">{product.device.name}</span>
              <span class="product-description">
                {product.device.description}
              </span>
            </div>
          </div>

          <div class="product-card-body">
            {product.prices?.type === "PriceSARXP" && <PriceSARXP />}
            {product.prices?.type === "PriceASP" && <div class="price-asp" />}
            {product.prices?.type === "table" && product.prices.meta && (
              <PriceTableASP priceData={product.prices} />
            )}

            <div class="product-card-footer">
              {product.buttons?.buy &&
                product.prices?.type !== "PriceSARXP" && (
                  <ButtonGeneric
                    Variant="primary"
                    Size="default"
                    Style="filled"
                    Target="link"
                    Blank={true}
                    ButtonLabel={product.buttons.buy.label}
                    ButtonLink={product.buttons.buy.link}
                  />
                )}
              {product.buttons?.more && (
                <ButtonGeneric
                  Variant="primary"
                  Size="default"
                  Style="outlined"
                  Target="link"
                  ButtonLabel={product.buttons.more.label}
                  ButtonLink={product.buttons.more.link}
                />
              )}
            </div>
            <p class="mt-[12px] text-zinc-600 text-sm">
              Все цены указаны без учёта НДС. Не является публичной офертой,
              итоговая стоимость может быть скорректирована. Для получения
              подробной информации обратитесь в службу по работе с клиентами.
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const navLinks =
      document.querySelectorAll<HTMLElement>(".product-nav-bar a");

    // Обработка эффекта прозрачности
    navLinks.forEach((link) => {
      link.addEventListener("mouseenter", () => {
        navLinks.forEach((otherLink) => {
          if (otherLink !== link) {
            otherLink.style.opacity = "0.6";
          }
        });
      });

      link.addEventListener("mouseleave", () => {
        navLinks.forEach((otherLink) => {
          otherLink.style.opacity = "1";
        });
      });
    });
  });
</script>
