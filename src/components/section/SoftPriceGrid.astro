---
import ButtonGeneric from "@/components/inputs/ButtonGeneric.astro";
import prodSoft from "@/data/prodSoft.json";
import PriceTable from "@/components/price/PriceTable.astro";
import PriceSARXP from "@/components/price/PriceSARXP.astro";
import { Image } from "astro:assets";

// Фильтруем продукты с ценами прямо в компоненте
const productsWithPrices = prodSoft.products;

// Функция для определения стратегии загрузки
const getLoadingStrategy = (index: number) => {
  // Первые два продукта загружаем сразу, остальные - лениво
  return index < 2 ? "eager" : "lazy";
};
---

<section class="product-grid-wrapper with-margin">
  <!-- Левая колонка с навигацией -->
  <aside class="product-nav-bar">
    <ul>
      {
        productsWithPrices.map((product) => (
          <li class={`${!product.prices ? "hidden" : ""}`}>
            <a href={`#${product.id}`}>
              <Image
                src={product.app.image}
                alt={product.id}
                width={40}
                height={40}
                loading="lazy"
                class="product-icon"
              />
              {product.app.name}
            </a>
          </li>
        ))
      }
    </ul>
  </aside>

  <!-- Правая колонка с карточками продуктов -->
  <div class="product-cards-col">
    {
      productsWithPrices.map((product) => (
        <div
          class={`product-card ${!product.prices ? "hidden" : ""}`}
          id={product.id}>
          <div class="product-card-head">
            <Image
              src={product.app.image}
              alt={product.id}
              width={60}
              height={60}
              loading="lazy"
              class="product-icon software-icon"
            />
            <div class="product-card-info">
              <span class="product-title">{product.app.name}</span>
              <span class="product-description">{product.app.description}</span>
            </div>
          </div>

          <div
            class={`product-card-body ${!product.prices?.type ? "with-left-padding" : ""}`}>
            {product.prices?.type === "table" &&
              product.prices.meta &&
              product.prices.headers &&
              product.prices.rows && (
                <PriceTable
                  prices={{
                    meta: product.prices.meta,
                    headers: product.prices.headers,
                    rows: product.prices.rows,
                  }}
                />
              )}
            {product.prices?.type === "PriceSARXP" && <PriceSARXP />}

            <div class="product-card-footer">
              {product.buttons?.buy &&
                product.prices?.type !== "PriceSARXP" && (
                  <ButtonGeneric
                    Variant="primary"
                    Size="default"
                    Style="filled"
                    Target="link"
                    Blank={true}
                    ButtonLabel={product.buttons.buy.label}
                    ButtonLink={product.buttons.buy.link}
                  />
                )}
              {product.buttons?.demo && (
                <ButtonGeneric
                  Variant="primary"
                  Size="default"
                  Style="outlined"
                  Target="link"
                  ButtonLabel={product.buttons.demo.label}
                  ButtonLink={product.buttons.demo.link}
                />
              )}
              {product.buttons?.more && (
                <ButtonGeneric
                  Variant="secondary"
                  Size="default"
                  Style="outlined"
                  Target="link"
                  ButtonLabel={product.buttons.more.label}
                  ButtonLink={product.buttons.more.link}
                />
              )}
            </div>
            <p
              class={`mt-[12px] text-sm text-zinc-600 ${!product.prices ? "hidden" : ""}`}>
              Все цены указаны без учёта НДС. Не является публичной офертой,
              итоговая стоимость может быть скорректирована. Для получения
              подробной информации обратитесь в службу по работе с клиентами.
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const navLinks =
      document.querySelectorAll<HTMLElement>(".product-nav-bar a");

    // Обработка эффекта прозрачности
    navLinks.forEach((link) => {
      link.addEventListener("mouseenter", () => {
        navLinks.forEach((otherLink) => {
          if (otherLink !== link) {
            otherLink.style.opacity = "0.6";
          }
        });
      });

      link.addEventListener("mouseleave", () => {
        navLinks.forEach((otherLink) => {
          otherLink.style.opacity = "1";
        });
      });
    });

    // Обработка плавной прокрутки - убрана, так как теперь обрабатывается на уровне страницы
