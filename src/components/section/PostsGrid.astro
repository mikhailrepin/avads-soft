---
import PostCard from "@/components/card/PostCard.astro";
import ButtonGeneric from "@/components/inputs/ButtonGeneric.astro";
import type { Post } from "@/types/interfaces";

interface Props {
  posts: Post[];
  showAllNewsButton?: boolean;
  currentPage?: number;
  totalPages?: number;
  basePath?: string;
  allButtonLabel?: string;
}

const {
  posts,
  showAllNewsButton = false,
  currentPage = 1,
  totalPages = 1,
  basePath = "/news",
  allButtonLabel = "Все новости",
} = Astro.props;

// Функция для определения количества карточек в первом ряду в зависимости от брейкпоинта
function getFirstRowCount() {
  return {
    mobile: 1, // 1 колонка на мобильных
    tablet: 2, // 2 колонки на планшетах
    desktop: 3, // 3 колонки на десктопе
  };
}

const firstRowCounts = getFirstRowCount();
const maxFirstRowItems = Math.max(...Object.values(firstRowCounts));

// Функция для генерации массива страниц с многоточием
function getPaginationRange(current: number, total: number) {
  const delta = 2;
  const range = [];

  for (let i = 1; i <= total; i++) {
    if (
      i === 1 ||
      i === total ||
      (i >= current - delta && i <= current + delta)
    ) {
      range.push({ type: "page", value: i });
    } else if (i === current - delta - 1) {
      // Вычисляем среднюю страницу для левого многоточия
      const middlePage = Math.floor((1 + (current - delta)) / 2);
      range.push({ type: "dots", value: middlePage });
    } else if (i === current + delta + 1) {
      // Вычисляем среднюю страницу для правого многоточия
      const middlePage = Math.floor((total + (current + delta)) / 2);
      range.push({ type: "dots", value: middlePage });
    }
  }

  return range;
}
---

<div class="gap-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 w-full">
  {
    posts.map((post, index) => (
      <PostCard
        post={post}
        isFirstRow={index < maxFirstRowItems}
        transition:animate="slide"
      />
    ))
  }
</div>

<div class="flex justify-center gap-4 my-8 w-full">
  {
    showAllNewsButton ? (
      <ButtonGeneric
        Variant="primary"
        Size="default"
        Style="ghosted"
        IconRight={{
          IconSprite: "chevron-right-big-outline",
          IconVisible: true,
        }}
        ButtonLabel={allButtonLabel}
        ButtonLink={basePath}
        Target="link"
        CustomClass="w-fit"
      />
    ) : (
      totalPages > 1 && (
        <div class="flex gap-2">
          <ButtonGeneric
            Variant="secondary"
            Size="default"
            Style="ghosted"
            IconLeft={{
              IconSprite: "chevron-left-big-outline",
              IconVisible: true,
            }}
            ButtonLink={`${basePath}?page=${currentPage - 1}`}
            Target="link"
            CustomClass={`w-fit ${currentPage <= 1 ? "pointer-events-none opacity-50" : ""}`}
          />

          {getPaginationRange(currentPage, totalPages).map((item) =>
            item.type === "page" ? (
              <ButtonGeneric
                Variant="secondary"
                Size="default"
                Style={currentPage === item.value ? "filled" : "ghosted"}
                ButtonLabel={item.value.toString()}
                ButtonLink={`${basePath}/${item.value}`}
                Target="link"
                CustomClass={`w-fit ${currentPage === item.value ? "pointer-events-none" : ""}`}
              />
            ) : (
              <span class="flex items-center px-2 text-zinc-500">...</span>
            )
          )}

          <ButtonGeneric
            Variant="secondary"
            Size="default"
            Style="ghosted"
            IconRight={{
              IconSprite: "chevron-right-big-outline",
              IconVisible: true,
            }}
            ButtonLink={`${basePath}/${currentPage + 1}`}
            Target="link"
            CustomClass={`w-fit ${currentPage >= totalPages ? "pointer-events-none opacity-50" : ""}`}
          />
        </div>
      )
    )
  }
</div>
