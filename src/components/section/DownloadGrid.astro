---
import ButtonGeneric from "@/components/inputs/ButtonGeneric.astro";
import prodSoft from "@/data/prodSoft.json";

const productsWithPrices = prodSoft.products;
---

<section class="main-max-width wrapper">
  <!-- Левая колонка с навигацией -->
  <aside class="nav-bar">
    <ul>
      {
        productsWithPrices.map((product) => (
          <li>
            <a href={`#${product.id}`}>
              <img
                src={product.app.image}
                alt={product.id}
                loading="lazy"
              />
              {product.app.name}
            </a>
          </li>
        ))
      }
    </ul>
  </aside>

  <!-- Правая колонка с карточками -->
  <div class="cards-col">
    <div
      class="card"
      id="tsdb">
      <!-- Шапка карточки -->
      <div class="card-head">
        <img
          src=""
          alt=""
          loading="lazy"
        />
        <div class="card-info">
          <span class="title">Название продукта</span>
          <span class="description">Описание продукта</span>
        </div>
      </div>
      <!-- Тело карточки -->
      <div class="card-body">
        <!-- Панель табов -->
        <div class="tabs-panel">
          <button>Windows</button>
          <button>Linux</button>
        </div>
        <!-- Содержимое табов -->
        <div class="tab-content">
          <div class="description">
            <div class="title">
              Для версии OS Windows 10 и старше (обязательно 64-разрядная).
            </div>
            <div class="subtitle">
              Бесплатная пробная версия не ограничена по функциональности, но
              имеет ограничение по времени работы, а именно 24 часа с момента
              запуска сервера, при наступлении ограничения сервер потребуется
              перезапустить.
            </div>
          </div>
          <!-- Основные кнопки -->
          <div class="flex gap-2">
            <ButtonGeneric
              Variant="primary"
              Size="default"
              Style="filled"
              Visible={true}
              IconLeft={{
                IconSprite: "download-bold",
                IconVisible: true,
              }}
              CustomClass="w-fit"
              Target="link"
              ButtonLabel="Скачать"
              ButtonLink="/"
            />
            <ButtonGeneric
              Variant="primary"
              Size="default"
              Style="outlined"
              Visible={true}
              IconLeft={{
                IconSprite: "github-symbol",
                IconVisible: true,
              }}
              CustomClass="w-fit"
              Target="link"
              ButtonLabel="Скачать драйверы"
              ButtonLink="/"
            />
          </div>
          <!-- Дополнительные кнопки -->
          <div class="flex gap-2">
            <ButtonGeneric
              Variant="primary"
              Size="small"
              Style="ghosted"
              Visible={true}
              IconLeft={{
                IconSprite: "file-blank-outline",
                IconVisible: true,
              }}
              CustomClass="w-fit"
              Target="link"
              ButtonLabel="Руководство по установке"
              ButtonLink="/"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const navLinks = document.querySelectorAll<HTMLElement>(".nav-bar a");

    // Обработка эффекта прозрачности
    navLinks.forEach((link) => {
      link.addEventListener("mouseenter", () => {
        navLinks.forEach((otherLink) => {
          if (otherLink !== link) {
            otherLink.style.opacity = "0.6";
          }
        });
      });

      link.addEventListener("mouseleave", () => {
        navLinks.forEach((otherLink) => {
          otherLink.style.opacity = "1";
        });
      });
    });

    // Обработка плавной прокрутки
    navLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const targetId = link.getAttribute("href")?.replace("#", "") ?? "";
        const targetElement = document.getElementById(targetId);

        if (targetElement) {
          const offset = 80;
          const elementPosition = targetElement.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - offset;

          window.scrollTo({
            top: offsetPosition,
            behavior: "smooth",
          });
        }
      });
    });
  });
</script>

<style>
  .wrapper {
    @apply flex lg:flex-row flex-col gap-[16px] mx-auto my-20 w-[100%];
  }
  .nav-bar {
    @apply top-[60px] lg:top-[80px] sticky bg-zinc-900 lg:bg-zinc-900/20 border-zinc-900 px-[8px] py-[8px] lg:py-[32px] lg:px-[16px] border rounded-[8px] w-full lg:w-[400px] lg:min-w-[200px] h-fit max-h-[500px] overflow-hidden transition-all duration-200 z-[999];
    & ul {
      @apply flex lg:flex-col flex-nowrap gap-[32px] lg:gap-[8px] overflow-x-auto overflow-y-hidden lg:overflow-y-auto;
      & li > a {
        @apply flex flex-shrink-0 items-center gap-[12px] hover:bg-zinc-900 p-2 rounded-[8px] text-zinc-400 hover:text-zinc-100 whitespace-nowrap transition-all duration-200 cursor-pointer;
        & img {
          @apply w-[24px] h-fit;
        }
      }
    }
  }
  .cards-col {
    @apply flex flex-col gap-[16px] w-full;
  }
  .card {
    @apply border-zinc-900 p-[32px] border rounded-[8px] w-full hover:bg-zinc-900/20 transition-all duration-200;
    scroll-margin-top: 80px;
  }
  .card-head {
    @apply flex lg:flex-row flex-col gap-[24px];
    & img {
      @apply bg-zinc-900 p-3 rounded-[8px] w-[60px] h-[60px];
    }
    & .card-info {
      @apply flex flex-col gap-2;
      & .title {
        @apply mb-[-4px] font-medium text-2xl;
      }
      & .description {
        @apply m-0 text-lg text-zinc-500;
      }
    }
  }
  .card-body {
    @apply flex flex-col gap-4 py-[16px] pl-[84px];
  }
  .tab-content {
    @apply flex flex-col gap-4;
    & .description {
      @apply flex flex-col gap-2;
      & .title {
        @apply font-medium;
      }
      & .subtitle {
        @apply font-light text-zinc-400;
      }
    }
  }
  .tabs-panel {
    @apply flex gap-3 py-[16px];
    & button {
      @apply border-zinc-500 pb-1 border-b text-lg text-zinc-400;
      &:hover {
        @apply text-zinc-100;
      }
      &:active {
        @apply border-primary-400 text-primary-300;
      }
    }
  }
</style>
