---
import ButtonGeneric from "@/components/inputs/ButtonGeneric.astro";
import prodSoft from "@/data/prodSoft.json";

const productsWithPrices = prodSoft.products;
---

<section class="main-max-width wrapper">
  <!-- Левая колонка с навигацией -->
  <aside class="nav-bar">
    <ul>
      {
        productsWithPrices.map((product) => (
          <li>
            <a href={`#${product.id}`}>
              <img
                src={product.app.image}
                alt={product.id}
                loading="lazy"
              />
              {product.app.name}
            </a>
          </li>
        ))
      }
    </ul>
  </aside>

  <!-- Правая колонка с карточками -->
  <div class="cards-col">
    {
      productsWithPrices.map((product) => (
        <div
          class="card"
          id={product.id}>
          <div class="card-head">
            <img
              src={product.app.image}
              alt={product.app.name}
              loading="lazy"
            />
            <div class="card-info">
              <span class="title">{product.app.name}</span>
              <span class="description">{product.app.description}</span>
            </div>
          </div>

          <div class="card-body">
            {product.supports && (
              <>
                <div class="tabs-panel">
                  {product.supports.windows && (
                    <button
                      data-os="windows"
                      class="active">
                      Windows
                    </button>
                  )}
                  {product.supports.linux && (
                    <button data-os="linux">Linux</button>
                  )}
                </div>

                <div
                  class="tab-content"
                  data-os="windows">
                  <div class="description">
                    <div
                      class="title"
                      set:html={product.supports.windows?.description?.title}
                    />
                    <div
                      class="subtitle"
                      set:html={product.supports.windows?.description?.subtitle}
                    />
                  </div>

                  {/* Основные кнопки */}
                  <div class="flex gap-2 py-[16px]">
                    {product.buttons?.demo && (
                      <ButtonGeneric
                        Variant="primary"
                        Size="default"
                        Style="filled"
                        Visible={true}
                        IconLeft={{
                          IconSprite: "download-bold",
                          IconVisible: true,
                        }}
                        CustomClass="w-fit"
                        Target="link"
                        ButtonLabel={product.buttons.demo.label}
                        ButtonLink={product.buttons.demo.link}
                      />
                    )}

                    {product.supports.windows?.drivers?.git && (
                      <ButtonGeneric
                        Variant="primary"
                        Size="default"
                        Style="outlined"
                        Visible={true}
                        IconLeft={{
                          IconSprite: product.supports.windows.drivers.git.icon,
                          IconVisible: true,
                        }}
                        CustomClass="w-fit"
                        Target="link"
                        ButtonLabel={product.supports.windows.drivers.git.label}
                        ButtonLink={product.supports.windows.drivers.git.link}
                      />
                    )}
                  </div>

                  {/* Дополнительные кнопки */}
                  {product.supports.windows?.guides && (
                    <div class="flex flex-wrap gap-3">
                      {Object.entries(product.supports.windows.guides).map(
                        ([key, guide]) => (
                          <ButtonGeneric
                            Variant="primary"
                            Size="small"
                            Style="ghosted"
                            Visible={true}
                            IconLeft={{
                              IconSprite: guide.icon,
                              IconVisible: true,
                            }}
                            CustomClass="w-fit"
                            Target="link"
                            ButtonLabel={guide.label}
                            ButtonLink={guide.link}
                          />
                        )
                      )}
                    </div>
                  )}
                </div>

                {product.supports.linux && (
                  <div
                    class="tab-content"
                    data-os="linux"
                    style="display: none;">
                    <div class="description">
                      <div
                        class="title"
                        set:html={product.supports.linux?.description?.title}
                      />
                      <div
                        class="subtitle"
                        set:html={product.supports.linux?.description?.subtitle}
                      />
                    </div>

                    {/* Linux buttons */}
                    <div class="flex gap-2 py-[16px]">
                      {product.buttons?.demo && (
                        <ButtonGeneric
                          Variant="primary"
                          Size="default"
                          Style="filled"
                          Visible={true}
                          IconLeft={{
                            IconSprite: "download-bold",
                            IconVisible: true,
                          }}
                          CustomClass="w-fit"
                          Target="link"
                          ButtonLabel={product.buttons.demo.label}
                          ButtonLink={product.buttons.demo.link}
                        />
                      )}

                      {product.supports.linux?.drivers?.git && (
                        <ButtonGeneric
                          Variant="primary"
                          Size="default"
                          Style="outlined"
                          Visible={true}
                          IconLeft={{
                            IconSprite: product.supports.linux.drivers.git.icon,
                            IconVisible: true,
                          }}
                          CustomClass="w-fit"
                          Target="link"
                          ButtonLabel={product.supports.linux.drivers.git.label}
                          ButtonLink={product.supports.linux.drivers.git.link}
                        />
                      )}
                    </div>

                    {/* Linux guides */}
                    {product.supports.linux?.guides && (
                      <div class="flex flex-wrap gap-3">
                        {Object.entries(product.supports.linux.guides).map(
                          ([key, guide]) => (
                            <ButtonGeneric
                              Variant="primary"
                              Size="small"
                              Style="ghosted"
                              Visible={true}
                              IconLeft={{
                                IconSprite: guide.icon,
                                IconVisible: true,
                              }}
                              CustomClass="w-fit"
                              Target="link"
                              ButtonLabel={guide.label}
                              ButtonLink={guide.link}
                            />
                          )
                        )}
                      </div>
                    )}
                  </div>
                )}
              </>
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const navLinks = document.querySelectorAll<HTMLElement>(".nav-bar a");

    // Обработка эффекта прозрачности
    navLinks.forEach((link) => {
      link.addEventListener("mouseenter", () => {
        navLinks.forEach((otherLink) => {
          if (otherLink !== link) {
            otherLink.style.opacity = "0.6";
          }
        });
      });

      link.addEventListener("mouseleave", () => {
        navLinks.forEach((otherLink) => {
          otherLink.style.opacity = "1";
        });
      });
    });

    // Обработка плавной прокрутки
    navLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const targetId = link.getAttribute("href")?.replace("#", "") ?? "";
        const targetElement = document.getElementById(targetId);

        if (targetElement) {
          const offset = 80;
          const elementPosition = targetElement.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - offset;

          window.scrollTo({
            top: offsetPosition,
            behavior: "smooth",
          });
        }
      });
    });

    // Добавляем обработку переключения табов
    const cards = document.querySelectorAll(".card");

    cards.forEach((card) => {
      const tabButtons = card.querySelectorAll(".tabs-panel button");
      const tabContents = card.querySelectorAll(".tab-content");

      if (tabButtons.length > 0) {
        // Активируем первый таб по умолчанию
        tabButtons[0].classList.add("active");

        tabButtons.forEach((button) => {
          button.addEventListener("click", () => {
            const os = button.getAttribute("data-os");

            // Убираем активный класс у всех кнопок
            tabButtons.forEach((btn) => btn.classList.remove("active"));

            // Добавляем активный класс текущей кнопке
            button.classList.add("active");

            // Показываем соответствующий контент
            tabContents.forEach((content) => {
              if (content.getAttribute("data-os") === os) {
                (content as HTMLElement).style.display = "block";
              } else {
                (content as HTMLElement).style.display = "none";
              }
            });
          });
        });
      }
    });
  });
</script>

<style>
  .wrapper {
    @apply flex lg:flex-row flex-col gap-[16px] mx-auto my-20 w-[100%];
  }
  .nav-bar {
    @apply top-[60px] lg:top-[80px] sticky bg-zinc-900 lg:bg-zinc-900/20 border-zinc-900 px-[8px] py-[8px] lg:py-[32px] lg:px-[16px] border rounded-[8px] w-full lg:w-[400px] lg:min-w-[200px] h-fit max-h-[500px] overflow-hidden transition-all duration-200 z-[999];
    & ul {
      @apply flex lg:flex-col flex-nowrap gap-[32px] lg:gap-[8px] overflow-x-auto overflow-y-hidden lg:overflow-y-auto;
      & li > a {
        @apply flex flex-shrink-0 items-center gap-[12px] hover:bg-zinc-900 p-2 rounded-[8px] text-zinc-400 hover:text-zinc-100 whitespace-nowrap transition-all duration-200 cursor-pointer;
        & img {
          @apply w-[24px] h-fit;
        }
      }
    }
  }
  .cards-col {
    @apply flex flex-col gap-[16px] w-full;
  }
  .card {
    @apply border-zinc-900 p-[32px] border rounded-[8px] w-full hover:bg-zinc-900/20 transition-all duration-200;
    scroll-margin-top: 80px;
  }
  .card-head {
    @apply flex lg:flex-row flex-col gap-[24px];
    & img {
      @apply bg-zinc-900 p-3 rounded-[8px] w-[60px] h-[60px];
    }
    & .card-info {
      @apply flex flex-col gap-2;
      & .title {
        @apply mb-[-4px] font-medium text-2xl;
      }
      & .description {
        @apply m-0 text-lg text-zinc-500;
      }
    }
  }
  .card-body {
    @apply flex flex-col gap-4 py-[16px] pl-[84px];
  }
  .tab-content {
    @apply flex flex-col gap-4;
    & .description {
      @apply flex flex-col gap-2;
      & .title {
        @apply font-medium;
      }
      & .subtitle {
        @apply font-light text-zinc-400;
      }
    }
  }
  .tabs-panel {
    @apply flex gap-3 py-[16px];
    & button {
      @apply border-zinc-500 pb-1 border-b text-lg text-zinc-400;
      &:hover {
        @apply text-zinc-100;
      }
      &:active {
        @apply border-primary-400 text-primary-300;
      }
    }
  }
  .tabs-panel button.active {
    @apply border-primary-400 text-primary-300;
  }

  /* Добавляем глобальные стили отдельно */
  :global(.description .title ul) {
    @apply mt-2 ml-4 list-disc;
  }

  :global(.description .title li) {
    @apply mb-1 text-zinc-400;
  }
</style>
