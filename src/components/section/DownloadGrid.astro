---
import ButtonGeneric from "@/components/inputs/ButtonGeneric.astro";
import prodSoft from "@/data/prodSoft.json";

const productsWithDownloads = prodSoft.products;

type Guide = {
  icon: string;
  label: string;
  link: string;
};

type GuideData = {
  guides: Record<string, Guide>;
};

type DownloadButton = {
  icon: string;
  label: string;
  link: string;
};
---

<section class="product-grid-wrapper">
  <!-- Левая колонка с навигацией -->
  <aside class="product-nav-bar">
    <ul>
      {
        productsWithDownloads.map((product) => (
          <li class={`${!product.supports ? "hidden" : ""}`}>
            <a href={`#${product.id}`}>
              <img
                src={product.app.image}
                alt={product.id}
                loading="lazy"
              />
              {product.app.name}
            </a>
          </li>
        ))
      }
    </ul>
  </aside>

  <!-- Правая колонка с карточками -->
  <div class="product-cards-col">
    {
      productsWithDownloads.map((product) => (
        <div
          class={`product-card ${!product.supports ? "hidden" : ""}`}
          id={product.id}>
          <div class="product-card-head">
            <img
              src={product.app.image}
              alt={product.app.name}
              loading="lazy"
              class="software-icon"
            />
            <div class="product-card-info">
              <span class="product-title">{product.app.name}</span>
              <span class="product-description">{product.app.description}</span>
            </div>
          </div>

          <div class="with-left-padding product-card-body">
            {product.supports && (
              <>
                <div class="tabs-panel">
                  {Object.entries(product.supports).map(([os, data], index) => (
                    <button
                      data-os={os}
                      class={index === 0 ? "active" : ""}>
                      {os.charAt(0).toUpperCase() + os.slice(1)}
                    </button>
                  ))}
                </div>

                {Object.entries(product.supports).map(([os, data], index) => (
                  <div
                    class="tab-content"
                    data-os={os}
                    style={index === 0 ? "" : "display: none;"}>
                    <div class="tab-description">
                      <div
                        class="tab-description-title"
                        set:html={data.description?.title}
                      />
                      <div
                        class="tab-description-subtitle"
                        set:html={data.description?.subtitle}
                      />
                    </div>

                    {/* Основные кнопки */}
                    <div class="flex lg:flex-row flex-col gap-3 py-[16px]">
                      {(
                        Object.entries(data.downloads || {}) as [
                          string,
                          DownloadButton,
                        ][]
                      )
                        .filter(([key]) =>
                          ["full", "demo", "git"].includes(key)
                        )
                        .map(([key, button]) => (
                          <ButtonGeneric
                            Variant="primary"
                            Blank={key === "full" || key === "git"}
                            Size="default"
                            Style={key === "full" ? "filled" : "outlined"}
                            Visible={true}
                            IconLeft={{
                              IconSprite: button.icon || "download-bold",
                              IconVisible: key === "demo" || key === "git",
                            }}
                            CustomClass={
                              key === "demo" || key === "git"
                                ? "w-fit"
                                : "w-[150px]"
                            }
                            Target="link"
                            ButtonLabel={button.label}
                            ButtonLink={button.link}
                          />
                        ))}
                    </div>

                    {/* Дополнительные кнопки */}
                    {data.guides && (
                      <div class="flex flex-wrap gap-3 pt-2">
                        {Object.entries((data as GuideData).guides).map(
                          ([key, guide]) => (
                            <ButtonGeneric
                              Variant="primary"
                              Size="small"
                              Style="ghosted"
                              Visible={true}
                              IconLeft={{
                                IconSprite: guide.icon,
                                IconVisible: true,
                              }}
                              CustomClass="w-fit"
                              Target="link"
                              Blank={true}
                              ButtonLabel={guide.label}
                              ButtonLink={guide.link}
                            />
                          )
                        )}
                      </div>
                    )}
                  </div>
                ))}
              </>
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const navLinks =
      document.querySelectorAll<HTMLElement>(".product-nav-bar a");

    // Обработка эффекта прозрачности
    navLinks.forEach((link) => {
      link.addEventListener("mouseenter", () => {
        navLinks.forEach((otherLink) => {
          if (otherLink !== link) {
            otherLink.style.opacity = "0.6";
          }
        });
      });

      link.addEventListener("mouseleave", () => {
        navLinks.forEach((otherLink) => {
          otherLink.style.opacity = "1";
        });
      });
    });

    // Обработка плавной прокрутки
    navLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const targetId = link.getAttribute("href")?.replace("#", "") ?? "";
        const targetElement = document.getElementById(targetId);

        if (targetElement) {
          const offset = 80;
          const elementPosition = targetElement.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - offset;

          window.scrollTo({
            top: offsetPosition,
            behavior: "smooth",
          });
        }
      });
    });

    // Добавляем обработку переключения табов
    const cards = document.querySelectorAll(".product-card");

    cards.forEach((card) => {
      const tabButtons = card.querySelectorAll(".tabs-panel button");
      const tabContents = card.querySelectorAll(".tab-content");

      if (tabButtons.length > 0) {
        // Активируем первый таб по умолчанию
        tabButtons[0].classList.add("active");

        tabButtons.forEach((button) => {
          button.addEventListener("click", () => {
            const os = button.getAttribute("data-os");

            // Убираем активный класс у всех кнопок
            tabButtons.forEach((btn) => btn.classList.remove("active"));

            // Добавляем активный класс текущей кнопке
            button.classList.add("active");

            // Показываем соответствующий контент
            tabContents.forEach((content) => {
              if (content.getAttribute("data-os") === os) {
                (content as HTMLElement).style.display = "block";
              } else {
                (content as HTMLElement).style.display = "none";
              }
            });
          });
        });
      }
    });
  });
</script>

<!-- Локальные стили удалены - теперь используются глобальные классы из base.css -->
