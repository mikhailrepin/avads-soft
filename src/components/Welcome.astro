---
import { motion } from "framer-motion";

const titleStyles = "text-4xl my-5";
const subtitleStyles = "text-xl mb-3";
const buttonStyles =
  "inline-flex items-center px-4 py-2 rounded-lg hover:cursor-pointer";

const animations = {
  hover: {
    scale: 1.1,
    transition: { duration: 0.2 },
  },
  tap: {
    scale: 0.95,
    transition: { duration: 0.1 },
  },
};
---

<div class="flex flex-col items-start gap-3 pt-4 pb-10">
  <h1 class={titleStyles}>Storybook 📖</h1>
  <span class={subtitleStyles}>Motion buttons:</span>

  <div class="flex flex-row gap-4 py-2">
    <motion.button
      client:load
      whileHover={animations.hover}
      whileTap={animations.tap}
      className={buttonStyles +
        " bg-primary-300 hover:bg-primary-400 text-primary-500"}
      aria-label="Default button">
      <p>Default</p>
    </motion.button>

    <motion.button
      client:load
      whileHover={animations.hover}
      whileTap={animations.tap}
      className={buttonStyles +
        " hover:bg-zinc-500 hover:text-zinc-900 border-2 border-zinc-500"}
      aria-label="Outlined button">
      <p>Outlined</p>
    </motion.button>

    <motion.button
      client:load
      whileHover={animations.hover}
      whileTap={animations.tap}
      className={buttonStyles + " bg-lime-300 hover:bg-lime-400 text-lime-900"}
      aria-label="Success button">
      <p>Success</p>
    </motion.button>

    <motion.button
      client:load
      whileHover={animations.hover}
      whileTap={animations.tap}
      className={buttonStyles +
        " bg-orange-300 hover:bg-orange-400 text-orange-900"}
      aria-label="Warning button">
      <p>Warning</p>
    </motion.button>

    <motion.button
      client:load
      whileHover={animations.hover}
      whileTap={animations.tap}
      className={buttonStyles + " bg-red-300 hover:bg-red-400 text-red-900"}
      aria-label="Danger button">
      <p>Danger</p>
    </motion.button>
  </div>
</div>
