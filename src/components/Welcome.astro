---
import { motion } from "framer-motion";

const titleStyles = "text-2xl text-primary-300";
const subtitleStyles = "text-primary-200";
const buttonStyles =
  "inline-flex bg-primary-300 hover:bg-primary-400 shadow-lg px-4 py-2 rounded-lg text-primary-500 cursor-pointer";

const animations = {
  hover: {
    scale: 1.1,
    transition: { duration: 0.2 },
  },
  tap: {
    scale: 0.95,
    transition: { duration: 0.1 },
  },
};
---

<div class="flex flex-col items-start gap-3 p-8">
  <h1 class={titleStyles}>Hello, world!</h1>
  <span class={subtitleStyles}>Example test row</span>

  <motion.button
    client:load
    whileHover={animations.hover}
    whileTap={animations.tap}
    className={buttonStyles}
    aria-label="Interactive button">
    <p>Hover Me</p>
  </motion.button>
</div>
