---
interface Props {
  priceData: {
    meta: {
      rowLabel: string;
      currency: string;
    };
    headers: {
      label: string;
    }[];
    rows: {
      model: string;
      description: string;
      price: number;
    }[];
  };
}

const { priceData } = Astro.props;
---

<div class="table-wrapper">
  <table>
    <thead>
      <tr>
        <th class="fixed-column">{priceData.headers[0].label}</th>
        <th class="pl-2">{priceData.headers[1].label}</th>
        <th class="pl-2">{priceData.headers[2].label}</th>
      </tr>
    </thead>
    <tbody>
      {
        priceData.rows.map((row) => (
          <tr>
            <td class="fixed-column">{row.model}</td>
            <td class="pl-2">{row.description}</td>
            <td class="pl-2">
              {row.price.toLocaleString("ru-RU").replace(",", " ")}{" "}
              {priceData.meta.currency}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  table tr td {
    @apply lg:text-[0.9rem] text-nowrap;
  }

  /* Разрешаем перенос текста для фиксированной колонки на мобильных */
  @media (max-width: 768px) {
    table tr td.fixed-column {
      white-space: normal !important;
      word-wrap: break-word !important;
      overflow-wrap: break-word !important;
    }
  }
  tbody tr td {
    @apply text-center;
    &:first-child {
      @apply text-left;
    }
    &:nth-child(2) {
      @apply text-left whitespace-normal;
      white-space: normal !important;
    }
  }
  thead tr th {
    @apply text-center;
    &:first-child {
      @apply text-left;
      padding-right: 1rem;
    }
    &:nth-child(2) {
      @apply text-left;
    }
  }
</style>
