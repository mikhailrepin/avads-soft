---
interface Props {
  prices: {
    meta: {
      rowLabel: string;
      currency: string;
    };
    headers: {
      clients: number | string;
      label: string;
    }[];
    rows: {
      tags: number | string;
      prices: number[];
    }[];
  };
}

const { prices } = Astro.props;
---

<div class="table-wrapper">
  <table>
    <thead>
      <tr>
        <th class="fixed-column">{prices.meta.rowLabel}</th>
        {
          prices.headers.map((header) => (
            <th>
              <h2>{header.clients}</h2>
              <span>{header.label}</span>
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        prices.rows.map((row) => (
          <tr>
            <td class="fixed-column">
              {row.tags.toLocaleString("ru-RU").replace(",", " ")}
            </td>
            {row.prices.map((price) => (
              <td>
                {price.toLocaleString("ru-RU").replace(",", " ")}{" "}
                {prices.meta.currency}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  table tr td {
    @apply lg:text-[0.9rem] text-nowrap;
  }
  tbody tr td {
    @apply text-center;
    &:first-child {
      @apply text-left;
    }
  }
  thead tr th h2 {
    @apply mt-0 mb-[-8px] font-semibold text-[20px] text-zinc-300 !important;
  }
  thead tr th span {
    @apply text-[12px] text-zinc-300;
  }
</style>
