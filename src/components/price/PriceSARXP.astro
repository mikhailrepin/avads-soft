---
/* Data */
import ButtonGeneric from "@/components/inputs/ButtonGeneric.astro";

const baseVersions = [
  {
    id: "lt",
    name: "САР-эксперт-ЛТ",
    price: "150 000",
    inDev: false,
    description: "Для эпизодической настройки одиночных контуров",
    features: [
      "Один контур",
      "Опрос и архивирование только для одного контура",
      "Идентификация объекта",
      "Расчет настроек контура",
      "Моделирование",
    ],
  },
  {
    id: "st",
    name: "САР-эксперт-СТ",
    price: "390 000",
    inDev: false,
    description: "Для работы с многоконтурными системами регулирования",
    features: [
      "Неограниченное количество контуров",
      "Одновременный опрос и архивирование всех контуров",
      "Идентификация объекта",
      "Расчет настроек регулятора",
      "Моделирование",
      "Архив результатов расчетов",
      "Статистический анализ",
    ],
  },
  {
    id: "pr",
    name: "САР-эксперт-ПР",
    price: "850 000",
    description: "В дополнение к версии СТ:",
    inDev: true,
    features: [
      "Поддержка проектной структуры",
      "Клиент-серверная архитектура",
      "Возможность удаленного доступа из браузера",
      "Инструменты частотного и корреляционного анализа многоконтурных САР",
    ],
  },
];

const enVersion = {
  name: "САР-эксперт-ЕН",
  description: "В дополнение к версии ПР:",
  inDev: true,
  features: [
    "Оценочные алгоритмы состояния контуров",
    "Нормирование оценок",
    "Установки базовых и пороговых значений",
    "Формирование обобщенных высокоуровневых показателей",
    "Отчеты по выявленным проблемам",
    "Дашборды, тревоги и журналы событий",
  ],
  prices: [
    { circuits: "100", price: "1 900 000" },
    { circuits: "500", price: "2 900 000" },
    { circuits: "1 000", price: "3 900 000" },
    { circuits: "2 500", price: "5 900 000" },
    { circuits: "10 000", price: "8 900 000" },
  ],
};
---

<div class="my-8 price-sarxp">
  <!-- Базовые версии -->
  <div class="top-cards">
    {
      baseVersions.map((version) => (
        <div class="price-card">
          <div class="card-header">
            <span class={`badge ${!version.inDev ? "prod" : ""}`}>
              {version.inDev ? "в разработке" : "доступно"}
            </span>
            <span class="font-medium text-lg">{version.name}</span>
            <p class="price">{version.price} ₽</p>
          </div>
          <div class="card-content">
            <p class="text-sm">{version.description}</p>
            <ul>
              {version.features.map((feature) => (
                <li>
                  <svg class="feature-icon">
                    <use xlink:href="/sprites.svg#checkbox-circle-check-outline" />
                  </svg>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="card-footer">
            <ButtonGeneric
              Variant="primary"
              Size="default"
              Style="outlined"
              Target="link"
              ButtonLabel="Купить"
              ButtonLink="#"
            />
          </div>
        </div>
      ))
    }
  </div>

  <!-- Расширенная версия -->
  <div class="bottom-card">
    <div class="card-header">
      <div class="title-wrapper">
        <h3>{enVersion.name}</h3>
        <span class="badge">в разработке</span>
      </div>
      <div class="card-content">
        <p>{enVersion.description}</p>
        <ul>
          {
            enVersion.features.map((feature) => (
              <li>
                <svg class="feature-icon">
                  <use xlink:href="/sprites.svg#checkbox-circle-check-outline" />
                </svg>
                <span>{feature}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div class="prices-list">
      <h4>Стоимость в зависимости от количества контуров:</h4>
      <ul>
        {
          enVersion.prices.map((item) => (
            <li>
              <span class="circuits">на {item.circuits} контуров</span>
              <span class="price">{item.price} ₽</span>
            </li>
          ))
        }
      </ul>
      <ButtonGeneric
        Variant="primary"
        Size="default"
        Style="filled"
        Target="link"
        ButtonLabel="Подробнее"
        ButtonLink="#"
      />
    </div>
  </div>
</div>

<style>
  .price-sarxp {
    @apply flex flex-col;
  }

  .top-cards {
    @apply gap-4 grid grid-cols-1 md:grid-cols-3;
  }

  .price-card,
  .bottom-card {
    @apply bg-zinc-900/40 rounded-[8px] p-4 border border-zinc-800 hover:border-zinc-700 transition-all;
  }

  .card-header {
    @apply flex flex-col items-start gap-2;
  }

  .price {
    @apply font-medium text-primary-300 text-base;
  }

  .card-content {
    @apply text-zinc-400;

    & p {
      @apply mb-4;
    }

    & ul {
      @apply space-y-2;
    }

    & li {
      @apply flex items-start gap-2 text-sm;
    }
  }

  .feature-icon {
    @apply flex-shrink-0 mt-0.5 w-4 h-4 text-primary-300;
  }

  .badge {
    @apply inline-block self-end bg-secondary-300 px-2 py-1 rounded-[4px] w-fit text-zinc-400 text-xs;
    &.prod {
      @apply bg-primary-300/20 text-primary-300;
    }
  }

  .bottom-card {
    @apply mt-4;
  }

  .prices-list {
    @apply mt-6 pt-6 border-zinc-800 border-t;

    & ul {
      @apply space-y-2 mb-6;
    }

    & li {
      @apply flex justify-between items-center py-2 border-b border-zinc-800/50;
    }

    & .circuits {
      @apply text-zinc-400 text-sm;
    }

    & .price {
      @apply font-medium text-primary-300;
    }
  }

  .card-footer {
    @apply mt-6 pt-6 border-zinc-800 border-t;
  }
</style>
