---
/* Data */
import ButtonGeneric from "@/components/inputs/ButtonGeneric.astro";
import prodSoft from "@/data/prodSoft.json";

const sarExpert = prodSoft.products.find(
  (product) => product.id === "sar-expert"
);
const productName = sarExpert?.app.name || "САР-эксперт";

const baseVersions = [
  {
    id: "lt",
    name: `${productName}-ЛТ`,
    price: "150 000",
    inDev: true,
    description: "Для эпизодической настройки одиночных контуров",
    buttonLink: sarExpert?.buttons?.buy?.link || "#",
    features: [
      "Один контур",
      "Опрос и архивирование только для одного контура",
      "Идентификация объекта",
      "Расчет настроек контура",
      "Моделирование",
    ],
  },
  {
    id: "st",
    name: `${productName}-СТ`,
    price: "390 000",
    inDev: false,
    description: "Для работы с многоконтурными системами регулирования",
    buttonLink: sarExpert?.buttons?.buy?.link || "#",
    features: [
      "Неограниченное количество контуров",
      "Одновременный опрос и архивирование всех контуров",
      "Идентификация объекта",
      "Расчет настроек регулятора",
      "Моделирование",
      "Архив результатов расчетов",
      "Статистический анализ",
    ],
  },
  {
    id: "pr",
    name: `${productName}-ПР`,
    price: "850 000",
    description: "В дополнение к версии СТ:",
    inDev: true,
    buttonLink: sarExpert?.buttons?.buy?.link || "#",
    features: [
      "Поддержка проектной структуры",
      "Клиент-серверная архитектура",
      "Возможность удаленного доступа из браузера",
      "Инструменты частотного и корреляционного анализа многоконтурных САР",
    ],
  },
];

const enVersion = {
  name: `${productName}-ЕН`,
  description: "В дополнение к версии ПР:",
  inDev: true,
  features: [
    "Оценочные алгоритмы состояния контуров",
    "Нормирование оценок",
    "Установки базовых и пороговых значений",
    "Формирование обобщенных высокоуровневых показателей",
    "Отчеты по выявленным проблемам",
    "Дашборды, тревоги и журналы событий",
  ],
  prices: [
    { circuits: "100", price: "1 900 000" },
    { circuits: "500", price: "2 900 000" },
    { circuits: "1 000", price: "3 900 000" },
    { circuits: "2 500", price: "5 900 000" },
    { circuits: "10 000", price: "8 900 000" },
  ],
};
---

<div class="mt-8 price-sarxp">
  <!-- Базовые версии -->
  <div class="top-cards">
    {
      baseVersions.map((version) => (
        <div class="price-card">
          <div class="card-header">
            <span class={`badge ${!version.inDev ? "prod" : ""}`}>
              {version.inDev ? "В разработке" : "Доступно"}
            </span>
            <span class="px-4 font-medium text-lg">{version.name}</span>
            <p class="price">{version.price} ₽</p>
          </div>
          <div class="card-content">
            <p class="text-zinc-300 text-sm">{version.description}</p>
            <ul>
              {version.features.map((feature) => (
                <li>
                  <svg class="feature-icon">
                    <use xlink:href="/sprites.svg#checkbox-circle-check-outline" />
                  </svg>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>
          {!version.inDev && (
            <div class="card-footer">
              <ButtonGeneric
                Variant="primary"
                Size="default"
                Style="outlined"
                CustomClass="w-full"
                Target="link"
                Blank={true}
                ButtonLabel="Купить"
                ButtonLink={version.buttonLink}
              />
            </div>
          )}
        </div>
      ))
    }
  </div>

  <!-- Расширенная версия -->
  <div class="bottom-card">
    <div class="card-header">
      <div class="flex flex-col items-start w-full">
        <span class={`badge ${!enVersion.inDev ? "prod" : ""}`}>
          {enVersion.inDev ? "В разработке" : "Доступно"}
        </span>
        <span class="px-4 font-medium text-lg">{enVersion.name}</span>
      </div>
      <div
        class="flex md:flex-row flex-col mt-3 border-zinc-800 border-t w-full">
        <div class="card-content">
          <p class="text-zinc-300 text-sm">{enVersion.description}</p>
          <ul>
            {
              enVersion.features.map((feature) => (
                <li>
                  <svg class="feature-icon">
                    <use xlink:href="/sprites.svg#checkbox-circle-check-outline" />
                  </svg>
                  <span>{feature}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="prices-list">
          <p class="mb-2 text-zinc-300 text-sm">
            Стоимость зависит от количества контуров:
          </p>
          <ul>
            {
              enVersion.prices.map((item) => (
                <li>
                  <span class="circuits">{item.circuits}:</span>
                  <span class="font-medium text-primary-300">
                    {item.price} ₽
                  </span>
                </li>
              ))
            }
          </ul>
          {
            !enVersion.inDev && (
              <ButtonGeneric
                Variant="primary"
                Size="default"
                Style="outlined"
                Target="link"
                ButtonLabel="Купить"
                ButtonLink="#"
              />
            )
          }
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .price-sarxp {
    @apply flex flex-col;
  }

  .top-cards {
    @apply gap-4 grid grid-cols-1 md:grid-cols-3;
  }

  .price-card,
  .bottom-card {
    @apply bg-zinc-900/40 rounded-[8px] border border-zinc-800 hover:border-zinc-700 transition-all overflow-hidden flex flex-col;
  }

  .card-header {
    @apply flex flex-col items-start;
  }

  .price {
    @apply px-4 font-semibold text-primary-300 text-xl;
  }

  .card-content {
    @apply flex-grow px-4 py-2;

    & ul {
      @apply space-y-2 my-4 text-zinc-400;
    }

    & li {
      @apply flex items-start gap-2 text-[0.8rem] leading-[140%];
    }
  }

  .feature-icon {
    @apply flex-shrink-0 mt-0.5 w-4 h-4 text-green-400;
  }

  .badge {
    @apply inline-block self-end bg-secondary-300 mb-2 px-3 py-1 rounded-bl-[4px] w-fit text-zinc-400 text-xs;
    &.prod {
      @apply bg-primary-300/20 text-primary-300;
    }
  }

  .bottom-card {
    @apply mt-4;
  }

  .prices-list {
    @apply px-4 pt-2 pb-4 border-zinc-800 border-l w-full lg:max-w-[16rem];

    & ul {
      @apply space-y-1 mt-4 mb-6;
    }

    & li {
      @apply flex justify-between items-center py-1 border-zinc-800 border-b;
      &:last-child {
        @apply border-b-0;
      }
    }

    & .circuits {
      @apply font-medium text-zinc-300;
    }

    & .price {
      @apply font-medium text-primary-300;
    }
  }

  .card-footer {
    @apply flex justify-center mt-auto p-4 border-zinc-800 border-t w-full;
  }
</style>
