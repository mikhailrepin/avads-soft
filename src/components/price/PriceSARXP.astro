---
/* Data */
import prodSoft from "@/data/prodSoft.json";

const enPrices = [
  { name: "САР-эксперт-ЕН-100", price: "1 900 000", circuits: "100" },
  { name: "САР-эксперт-ЕН-500", price: "2 900 000", circuits: "500" },
  { name: "САР-эксперт-ЕН-1000", price: "3 900 000", circuits: "1 000" },
  { name: "САР-эксперт-ЕН-2500", price: "5 900 000", circuits: "2 500" },
  { name: "САР-эксперт-ЕН-10000", price: "8 900 000", circuits: "10 000" },
];
---

<div class="price-sarxp">
  <!-- Верхние карточки -->
  <div class="top-cards">
    <div class="price-card">
      <div class="card-header">
        <h3>САР-эксперт-ЛТ</h3>
        <p class="price">150 000 ₽</p>
      </div>
      <div class="card-content">
        <p>Для эпизодической настройки одиночных контуров</p>
        <ul>
          <li>Один контур</li>
          <li>Опрос и архивирование только для одного контура</li>
          <li>Идентификация объекта</li>
          <li>Расчет настроек контура</li>
          <li>Моделирование</li>
        </ul>
      </div>
    </div>

    <div class="price-card">
      <div class="card-header">
        <h3>САР-эксперт-СТ</h3>
        <p class="price">390 000 ₽</p>
      </div>
      <div class="card-content">
        <p>Для работы с многоконтурными системами регулирования</p>
        <ul>
          <li>Неограниченное количество контуров</li>
          <li>Одновременный опрос и архивирование всех контуров</li>
          <li>Идентификация объекта</li>
          <li>Расчет настроек регулятора</li>
          <li>Моделирование</li>
          <li>Архив результатов расчетов</li>
          <li>Статистический анализ</li>
        </ul>
      </div>
    </div>

    <div class="price-card">
      <div class="card-header">
        <h3>САР-эксперт-ПР</h3>
        <span class="dev-badge">в разработке</span>
        <p class="price">850 000 ₽</p>
      </div>
      <div class="card-content">
        <p>В дополнение к версии СТ:</p>
        <ul>
          <li>Поддержка проектной структуры</li>
          <li>Клиент-серверная архитектура</li>
          <li>Возможность удаленного доступа из браузера</li>
          <li>
            Инструменты частотного и корреляционного анализа многоконтурных САР
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Нижняя карточка -->
  <div class="bottom-card">
    <div class="card-header">
      <div>
        <h3>САР-эксперт-ЕН</h3>
        <span class="dev-badge">в разработке</span>
      </div>
      <div class="card-content">
        <p>В дополнение к версии ПР:</p>
        <ul>
          <li>Оценочные алгоритмы состояния контуров</li>
          <li>Нормирование оценок</li>
          <li>Установки базовых и пороговых значений</li>
          <li>Формирование обобщенных высокоуровневых показателей</li>
          <li>Отчеты по выявленным проблемам</li>
          <li>Дашборды, тревоги и журналы событий</li>
        </ul>
      </div>
    </div>
    <div class="en-prices">
      {
        enPrices.map((variant) => (
          <div class="en-price-variant">
            <span class="variant-name">{variant.name}</span>
            <span class="circuits">на {variant.circuits} контуров</span>
            <span class="price">{variant.price} ₽</span>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .price-sarxp {
    @apply flex flex-col gap-8;
  }

  .top-cards {
    @apply gap-4 grid grid-cols-1 md:grid-cols-3;
  }

  .price-card,
  .bottom-card {
    @apply bg-zinc-900/40 rounded-xl p-6 border border-zinc-800 hover:border-zinc-700 transition-all;
  }

  .card-header {
    @apply mb-4;
  }

  h3 {
    @apply mb-2 font-medium text-zinc-100 text-xl;
  }

  .price {
    @apply font-bold text-purple-400 text-2xl;
  }

  .card-content {
    @apply text-zinc-400;

    & p {
      @apply mb-4;
    }

    & ul {
      @apply space-y-2;
    }

    & li {
      @apply text-sm;
    }
  }

  .dev-badge {
    @apply inline-block bg-purple-500/20 text-purple-400 text-xs px-2 py-1 rounded-full ml-2;
  }

  .bottom-card {
    @apply mt-4;
  }

  .en-prices {
    @apply gap-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 mt-6;
  }

  .en-price-variant {
    @apply flex flex-col p-4 bg-zinc-900/60 rounded-lg border border-zinc-800;

    & .variant-name {
      @apply font-medium text-zinc-300 text-sm;
    }

    & .circuits {
      @apply mt-1 text-zinc-500 text-xs;
    }

    & .price {
      @apply mt-2 text-lg;
    }
  }
</style>
