---
import PostCard from "@/modules/card/news/PostCard.astro";
import ButtonGeneric from "@/components/inputs/ButtonGeneric.astro";
import type { Post } from "@/types/interfaces";

interface Props {
  posts: Post[];
  showAllNewsButton?: boolean;
  currentPage?: number;
  totalPages?: number;
}

const {
  posts,
  showAllNewsButton = false,
  currentPage = 1,
  totalPages = 1,
} = Astro.props;

// Функция для генерации массива страниц с многоточием
function getPaginationRange(current: number, total: number) {
  const delta = 2;
  const range = [];

  for (let i = 1; i <= total; i++) {
    if (
      i === 1 ||
      i === total ||
      (i >= current - delta && i <= current + delta)
    ) {
      range.push({ type: "page", value: i });
    } else if (i === current - delta - 1) {
      // Вычисляем среднюю страницу для левого многоточия
      const middlePage = Math.floor((1 + (current - delta)) / 2);
      range.push({ type: "dots", value: middlePage });
    } else if (i === current + delta + 1) {
      // Вычисляем среднюю страницу для правого многоточия
      const middlePage = Math.floor((total + (current + delta)) / 2);
      range.push({ type: "dots", value: middlePage });
    }
  }

  return range;
}
---

<div class="gap-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 mb-8">
  {
    posts.map((post) => (
      <PostCard
        post={post}
        transition:animate="slide"
      />
    ))
  }
</div>

<div class="flex justify-center gap-4">
  {
    showAllNewsButton ? (
      <ButtonGeneric
        Variant="primary"
        Size="small"
        Style="ghosted"
        IconRight={{
          IconSprite: "chevron-right-big-outline",
          IconVisible: true,
        }}
        ButtonLabel="Все новости"
        ButtonLink="/news"
        Target="link"
        CustomClass="w-fit"
      />
    ) : (
      totalPages > 1 && (
        <div class="flex gap-2">
          <ButtonGeneric
            Variant="secondary"
            Size="default"
            Style="ghosted"
            IconLeft={{
              IconSprite: "chevron-left-big-outline",
              IconVisible: true,
            }}
            ButtonLink={`/news?page=${currentPage - 1}`}
            Target="link"
            CustomClass={`w-fit ${currentPage <= 1 ? "pointer-events-none opacity-50" : ""}`}
          />

          {getPaginationRange(currentPage, totalPages).map((item) =>
            item.type === "page" ? (
              <ButtonGeneric
                Variant="secondary"
                Size="default"
                Style={currentPage === item.value ? "filled" : "ghosted"}
                ButtonLabel={item.value.toString()}
                ButtonLink={`/news/${item.value}`}
                Target="link"
                CustomClass={`w-fit ${currentPage === item.value ? "pointer-events-none" : ""}`}
              />
            ) : (
              <span class="flex items-center px-2 text-zinc-500">...</span>
            )
          )}

          <ButtonGeneric
            Variant="secondary"
            Size="default"
            Style="ghosted"
            IconRight={{
              IconSprite: "chevron-right-big-outline",
              IconVisible: true,
            }}
            ButtonLink={`/news/${currentPage + 1}`}
            Target="link"
            CustomClass={`w-fit ${currentPage >= totalPages ? "pointer-events-none opacity-50" : ""}`}
          />
        </div>
      )
    )
  }
</div>
