---
interface MainHeroProps {
  backgroundUrl: string;
}

const { backgroundUrl } = Astro.props as MainHeroProps;
---

<section
  id="main-hero"
  class={`bg-[url('${backgroundUrl}')] relative overflow-hidden flex justify-center items-center bg-cover bg-no-repeat bg-center py-[40px] min-w-[100dvw] min-h-[40dvh] lg:min-h-[80dvh]`}>
  <!-- Элемент для перекрытия фона -->
  <div class="top-0 left-0 z-0 absolute bg-zinc-950 opacity-75 w-full h-full">
  </div>
  <!-- Область контента -->
  <div class="relative z-1 flex flex-col gap-4 w-[100%] main-max-width">
    <slot />
  </div>
</section>
