---
interface MainHeroProps {
  backgroundUrl: string;
}

const { backgroundUrl } = Astro.props as MainHeroProps;
---

<section
  class="wrapper"
  style={`background-image: url(${backgroundUrl});`}>
  <!-- Область контента -->
  <div class="content-area">
    <slot />
  </div>
</section>

<style>
  .wrapper {
    @apply relative flex justify-center items-center bg-cover bg-no-repeat bg-center mx-auto py-[40px] w-[100dvw] min-h-[10dvh] overflow-hidden;
    &::before {
      @apply top-0 left-0 z-10 absolute bg-zinc-950 opacity-75 w-full h-full;
      content: "";
    }
  }
  .content-area {
    @apply relative z-20 flex flex-col gap-4 w-[100%];
  }
</style>
