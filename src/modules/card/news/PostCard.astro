---
import type { Post } from "@/types/interfaces";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, date, image } = post;

// Форматируем дату
const formattedDate = new Date(date).toLocaleDateString("ru-RU", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article class="group post-card">
  <a
    href={post.url}
    class="flex flex-col h-full">
    <div class="relative rounded-t-lg overflow-hidden aspect-video">
      <img
        src={image}
        alt={title}
        class="group-hover:scale-105 w-full h-full transition-transform duration-300 object-cover"
      />
    </div>
    <div class="flex flex-col flex-grow bg-zinc-900 p-4 rounded-b-lg">
      <time class="text-sm text-zinc-400">{formattedDate}</time>
      <h3 class="mt-2 line-clamp-2 font-semibold text-xl">
        {title}
      </h3>
      <p class="mt-2 line-clamp-3 text-zinc-400">
        {description}
      </p>
    </div>
  </a>
</article>

<style>
  .post-card {
    @apply border-zinc-800 border rounded-lg transition-all overflow-hidden;
    &:hover {
      @apply border-primary-500/50 shadow-lg shadow-primary-500/10;
    }
  }
</style>
