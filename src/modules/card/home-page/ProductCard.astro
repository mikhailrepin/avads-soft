---
import ButtonGeneric from "@/components/inputs/ButtonGeneric.astro";
import type { BaseCard, BaseText, BaseButton } from "@/types/interfaces";

const {
  Image = "",
  Status = "",
  Title = "Название продукта" as BaseText["Title"],
  Description = "Описание продукта" as BaseText["Description"],
  FirstButton = {
    Visible: true,
    ButtonLabel: "First Button",
    ButtonLink: "#",
    IconLeft: { IconSprite: "", IconVisible: false },
    IconRight: { IconSprite: "", IconVisible: false },
  } as BaseButton,
  SecondButton = {
    Visible: true,
    ButtonLabel: "Second Button",
    ButtonLink: "#",
    IconLeft: { IconSprite: "", IconVisible: false },
    IconRight: { IconSprite: "", IconVisible: false },
  } as BaseButton,
} = Astro.props as BaseCard;
---

<div class="card-box">
  {Status && <div class="bage">{Status}</div>}
  <img
    src={Image}
    alt={Title}
    class="w-[64px] h-auto"
  />
  <h3 class="uppercase">{Title}</h3>
  <p>{Description}</p>
  <div class="flex gap-4 pt-4">
    {
      FirstButton && (
        <ButtonGeneric
          Variant="primary"
          Size="default"
          Style="filled"
          Visible={FirstButton.Visible}
          IconLeft={FirstButton.IconLeft}
          IconRight={FirstButton.IconRight}
          ButtonLink={FirstButton.ButtonLink}
          Target="link"
          ButtonLabel={FirstButton.ButtonLabel}
        />
      )
    }
    {
      SecondButton && (
        <ButtonGeneric
          Variant="secondary"
          Size="default"
          Style="outlined"
          Visible={SecondButton.Visible}
          IconLeft={SecondButton.IconLeft}
          IconRight={SecondButton.IconRight}
          ButtonLink={SecondButton.ButtonLink}
          Target="link"
          ButtonLabel={SecondButton.ButtonLabel}
        />
      )
    }
  </div>
</div>

<style>
  .card-box {
    @apply relative flex flex-col gap-4 border-zinc-500 bg-[#101012] p-[32px] border rounded-md w-full overflow-hidden;
  }
  .card-box:hover {
    @apply border-primary-300 shadow-lg shadow-primary-300/40 transition-all bg-zinc-950;
    & .bage {
      @apply top-[-8px] bg-gradient-to-b from-primary-400 to-primary-300 transition-all ease-in-out;
      &::after {
        @apply bg-zinc-950;
      }
    }
    & img {
      @apply transition-all ease-in-out scale-[110%];
    }
  }

  .bage {
    @apply top-0 right-5 absolute bg-zinc-500 px-2 pt-5 pb-3 font-bold text-left text-zinc-900 uppercase transition-all;
    writing-mode: vertical-rl;
    white-space: nowrap;
    transform: rotate(180deg);
    &::after {
      @apply block top-[-1px] right-0 absolute bg-[#101012] w-[40px] h-[12px];
      content: "";
      clip-path: polygon(50% 100%, 0 0, 100% 0);
    }
  }
</style>
